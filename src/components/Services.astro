---
const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";
---

<section
  id="services"
  class="py-20 md:py-28 lg:py-32 bg-gradient-to-br from-gray-50 via-white to-gray-50 relative overflow-hidden"
  aria-labelledby="services-heading"
>
  <!-- Background Elements -->
  <div class="absolute inset-0 opacity-5">
    <div
      class="absolute top-10 sm:top-20 left-5 sm:left-10 w-32 h-32 sm:w-48 sm:h-48 lg:w-64 lg:h-64 bg-brand-orange rounded-full filter blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-10 sm:bottom-20 right-5 sm:right-10 w-32 h-32 sm:w-48 sm:h-48 lg:w-64 lg:h-64 bg-purple-400 rounded-full filter blur-3xl"
    >
    </div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative">
    <header class="text-center mb-16 md:mb-20">
      <!-- Section Badge -->
      <div
        class="inline-flex items-center px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-brand-orange/10 border border-brand-orange/20 text-brand-orange text-xs sm:text-sm font-semibold mb-4 sm:mb-6"
      >
        <span class="w-2 h-2 bg-brand-orange rounded-full mr-2 animate-pulse"
        ></span>
        <span class="hidden sm:inline">Unsere Digitalagentur-Services</span>
        <span class="sm:hidden">Unsere Services</span>
      </div>

      <h2
        id="services-heading"
        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
      >
        <span
          class="bg-gradient-to-r from-gray-900 via-gray-700 to-gray-900 bg-clip-text text-transparent"
        >
          Digitale Services aus Regensburg
        </span>
        <br />
        <span
          class="bg-gradient-to-r from-brand-orange via-yellow-500 to-brand-orange bg-clip-text text-transparent"
        >
          die messbar funktionieren
        </span>
      </h2>

      <p
        class="text-base sm:text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed px-4 sm:px-0"
      >
        <strong>Professionelle Digitalagentur-Services aus Regensburg:</strong> Von
        der strategischen Konzeption bis zur erfolgreichen Umsetzung – wir bieten
        Ihnen alle digitalen Marketing-Services aus einer Hand für nachhaltigen Online-Erfolg
        in Bayern und deutschlandweit.
      </p>
    </header>

    <!-- Services Grid with Bento Box Layout -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 max-w-7xl mx-auto"
    >
      <!-- Webdesign - Large Card -->
      <article class="sm:col-span-2 lg:col-span-2 lg:row-span-2 group relative">
        <div
          class="h-full min-h-[300px] sm:min-h-[400px] lg:min-h-[500px] bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl sm:rounded-3xl p-6 sm:p-8 text-white overflow-hidden relative transform hover:scale-105 transition-all duration-500 hover:shadow-2xl hover:shadow-purple-500/25"
        >
          <!-- Background Pattern -->
          <div class="absolute inset-0 opacity-10">
            <div
              class="absolute top-0 right-0 w-24 h-24 sm:w-32 sm:h-32 bg-white rounded-full transform translate-x-12 sm:translate-x-16 -translate-y-12 sm:-translate-y-16"
            >
            </div>
            <div
              class="absolute bottom-0 left-0 w-18 h-18 sm:w-24 sm:h-24 bg-white rounded-full transform -translate-x-9 sm:-translate-x-12 translate-y-9 sm:translate-y-12"
            >
            </div>
          </div>

          <div class="relative z-10 h-full flex flex-col justify-between">
            <div>
              <div
                class="w-12 h-12 sm:w-16 sm:h-16 bg-white/20 backdrop-blur-md rounded-xl sm:rounded-2xl flex items-center justify-center mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300"
              >
                <svg
                  class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>

              <h3 class="text-lg sm:text-xl lg:text-2xl font-bold mb-3 sm:mb-4">
                Webdesign Agentur Regensburg
              </h3>
              <p
                class="text-white/90 mb-4 sm:mb-6 leading-relaxed text-sm sm:text-base"
              >
                <strong>Moderne, responsive Websites</strong> die konvertieren und
                Ihre Marke perfekt repräsentieren. Von der strategischen UX-Konzeption
                bis zur technischen SEO-optimierten Umsetzung –
                <em>Webdesign aus Regensburg</em> für maximalen Online-Erfolg.
              </p>

              <!-- Key Features -->
              <ul
                class="text-white/80 text-xs sm:text-sm space-y-1 mb-4 sm:mb-6"
              >
                <li>✓ Mobile-first & responsive Design</li>
                <li>✓ SEO-optimierte Programmierung</li>
                <li>✓ Conversion-optimierte UX/UI</li>
                <li>✓ CMS-Integration (WordPress, etc.)</li>
              </ul>
            </div>

            <div
              class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 sm:gap-0"
            >
              <a
                href="/webdesign-regensburg/"
                class="inline-flex items-center text-white font-semibold hover:text-white/80 transition-colors duration-200 group text-sm sm:text-base"
                aria-label="Mehr über Webdesign-Services erfahren"
              >
                <span class="hidden sm:inline"
                  >Webdesign-Services entdecken</span
                >
                <span class="sm:hidden">Mehr erfahren</span>
                <svg
                  class="w-4 h-4 sm:w-5 sm:h-5 ml-2 group-hover:translate-x-1 transition-transform duration-200"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- SEO Agentur -->
      <article class="group relative">
        <div
          class="h-full min-h-[200px] sm:min-h-[240px] bg-gradient-to-br from-blue-500 to-cyan-500 rounded-2xl sm:rounded-3xl p-4 sm:p-6 text-white overflow-hidden relative transform hover:scale-105 transition-all duration-500 hover:shadow-2xl hover:shadow-blue-500/25"
        >
          <div
            class="absolute top-0 right-0 w-16 h-16 sm:w-20 sm:h-20 bg-white/10 rounded-full transform translate-x-8 sm:translate-x-10 -translate-y-8 sm:-translate-y-10"
          >
          </div>

          <div class="relative z-10 h-full flex flex-col justify-between">
            <div>
              <div
                class="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 backdrop-blur-md rounded-lg sm:rounded-xl flex items-center justify-center mb-3 sm:mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>

              <h3
                class="text-base sm:text-lg lg:text-xl font-bold mb-2 sm:mb-3"
              >
                SEO Agentur Regensburg
              </h3>
              <p class="text-white/90 text-xs sm:text-sm leading-relaxed">
                <strong>Top-Rankings bei Google</strong> für mehr qualifizierten Traffic.{
                  " "
                }
                <em>Professionelle Suchmaschinenoptimierung</em> aus Regensburg für
                nachhaltige Sichtbarkeit.
              </p>
            </div>

            <a
              href="/seo-regensburg/"
              class="inline-flex items-center text-white font-semibold hover:text-white/80 transition-colors duration-200 group mt-3 sm:mt-4 text-xs sm:text-sm"
              aria-label="SEO-Services der Agentur entdecken"
            >
              <span class="hidden sm:inline">SEO-Services entdecken</span>
              <span class="sm:hidden">Mehr erfahren</span>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 ml-1 group-hover:translate-x-1 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Online Marketing -->
      <article class="group relative">
        <div
          class="h-full min-h-[200px] sm:min-h-[240px] bg-gradient-to-br from-brand-orange to-yellow-500 rounded-2xl sm:rounded-3xl p-4 sm:p-6 text-white overflow-hidden relative transform hover:scale-105 transition-all duration-500 hover:shadow-2xl hover:shadow-orange-500/25"
        >
          <div
            class="absolute bottom-0 left-0 w-12 h-12 sm:w-16 sm:h-16 bg-white/10 rounded-full transform -translate-x-6 sm:-translate-x-8 translate-y-6 sm:translate-y-8"
          >
          </div>

          <div class="relative z-10 h-full flex flex-col justify-between">
            <div>
              <div
                class="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 backdrop-blur-md rounded-lg sm:rounded-xl flex items-center justify-center mb-3 sm:mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </div>

              <h3
                class="text-base sm:text-lg lg:text-xl font-bold mb-2 sm:mb-3"
              >
                Online-Marketing Regensburg
              </h3>
              <p class="text-white/90 text-xs sm:text-sm leading-relaxed">
                <strong>Strategisches Digital Marketing</strong> für maximale Reichweite
                und messbaren ROI.{" "}
                <em>Performance Marketing</em> aus Regensburg.
              </p>
            </div>

            <a
              href="/online-marketing-regensburg/"
              class="inline-flex items-center text-white font-semibold hover:text-white/80 transition-colors duration-200 group mt-3 sm:mt-4 text-xs sm:text-sm"
              aria-label="Online-Marketing Services entdecken"
            >
              <span class="hidden sm:inline">Marketing-Services entdecken</span>
              <span class="sm:hidden">Mehr erfahren</span>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 ml-1 group-hover:translate-x-1 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Social Media - Wide Card -->
      <article class="sm:col-span-2 lg:col-span-2 group relative">
        <div
          class="h-full min-h-[200px] sm:min-h-[240px] bg-gradient-to-r from-pink-500 to-rose-500 rounded-2xl sm:rounded-3xl p-4 sm:p-6 text-white overflow-hidden relative transform hover:scale-105 transition-all duration-500 hover:shadow-2xl hover:shadow-pink-500/25"
        >
          <div
            class="absolute top-0 right-0 w-18 h-18 sm:w-24 sm:h-24 bg-white/10 rounded-full transform translate-x-9 sm:translate-x-12 -translate-y-9 sm:-translate-y-12"
          >
          </div>
          <div
            class="absolute bottom-0 left-0 w-12 h-12 sm:w-16 sm:h-16 bg-white/10 rounded-full transform -translate-x-6 sm:-translate-x-8 translate-y-6 sm:translate-y-8"
          >
          </div>

          <div
            class="relative z-10 h-full flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 sm:gap-0"
          >
            <div>
              <div
                class="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 backdrop-blur-md rounded-lg sm:rounded-xl flex items-center justify-center mb-3 sm:mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"
                  ></path>
                </svg>
              </div>

              <h3
                class="text-base sm:text-lg lg:text-xl font-bold mb-2 sm:mb-3"
              >
                Social Media Marketing Regensburg
              </h3>
              <p
                class="text-white/90 text-xs sm:text-sm leading-relaxed mb-3 sm:mb-4"
              >
                <strong>Zielgruppengerechte Social Media Strategien</strong> für nachhaltiges
                Wachstum auf allen relevanten Plattformen.{" "}
                <em>Facebook, Instagram, TikTok & LinkedIn Marketing</em> aus Regensburg.
              </p>

              <a
                href="/social-media-marketing-regensburg/"
                class="inline-flex items-center text-white font-semibold hover:text-white/80 transition-colors duration-200 group text-xs sm:text-sm"
                aria-label="Social Media Marketing Services entdecken"
              >
                <span class="hidden sm:inline"
                  >Social Media Services entdecken</span
                >
                <span class="sm:hidden">Mehr erfahren</span>
                <svg
                  class="w-3 h-3 sm:w-4 sm:h-4 ml-1 group-hover:translate-x-1 transition-transform duration-200"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
            </div>

            <!-- Social Icons -->
            <div class="flex gap-2 sm:gap-3">
              <div
                class="w-8 h-8 sm:w-10 sm:h-10 bg-white/20 backdrop-blur-md rounded-md sm:rounded-lg flex items-center justify-center"
                title="Instagram Marketing"
              >
                <span class="text-xs font-bold">IG</span>
              </div>
              <div
                class="w-8 h-8 sm:w-10 sm:h-10 bg-white/20 backdrop-blur-md rounded-md sm:rounded-lg flex items-center justify-center"
                title="Facebook Marketing"
              >
                <span class="text-xs font-bold">FB</span>
              </div>
              <div
                class="w-8 h-8 sm:w-10 sm:h-10 bg-white/20 backdrop-blur-md rounded-md sm:rounded-lg flex items-center justify-center"
                title="TikTok Marketing"
              >
                <span class="text-xs font-bold">TT</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12 sm:mt-16">
      <div
        class="inline-flex flex-col sm:flex-row items-center gap-3 sm:gap-4 bg-white/80 backdrop-blur-md rounded-xl sm:rounded-2xl p-4 sm:p-6 border border-gray-200/50 shadow-xl max-w-lg sm:max-w-none mx-auto"
      >
        <div class="text-left">
          <p
            class="text-gray-900 font-semibold text-sm sm:text-base text-center sm:text-left"
          >
            Kostenlose Digitalagentur-Beratung
          </p>
          <p class="text-gray-600 text-xs sm:text-sm text-center sm:text-left">
            Unverbindlich & individuell aus Regensburg
          </p>
        </div>
        <a
          href={CALENDLY}
          target="_blank"
          rel="noopener"
          data-calendly-popup-url={CALENDLY}
          class="px-4 sm:px-6 py-2.5 sm:py-3 bg-gradient-to-r from-brand-orange to-yellow-500 text-white font-semibold text-sm sm:text-base rounded-lg sm:rounded-xl hover:shadow-lg hover:shadow-orange-500/25 transition-all duration-300 transform hover:-translate-y-1 whitespace-nowrap"
          aria-label="Kostenlose Beratung für Digitalagentur-Services anfragen"
        >
          <span class="hidden sm:inline">Jetzt kostenlos beraten lassen</span>
          <span class="sm:hidden">Beratung anfragen</span>
        </a>
      </div>
    </div>
  </div>
</section>

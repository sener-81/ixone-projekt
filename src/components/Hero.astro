---
const GRUENDUNGSJAHR = 2007;
const jahreErfahrung = new Date().getFullYear() - GRUENDUNGSJAHR;

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";
---

<section
  class="hero-section relative min-h-[80svh] bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white overflow-hidden"
>
  <!-- Animierte Gradient-Blobs (wie auf den Unterseiten) -->
  <div class="absolute inset-0 opacity-25" aria-hidden="true">
    <div
      class="absolute top-0 -left-20 w-96 h-96 bg-brand-orange rounded-full filter blur-3xl animate-blob"
    >
    </div>
    <div
      class="absolute bottom-0 right-0 w-96 h-96 bg-yellow-500 rounded-full filter blur-3xl animate-blob animation-delay-2000"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/3 w-72 h-72 bg-slate-600 rounded-full filter blur-3xl animate-blob animation-delay-4000"
    >
    </div>
  </div>

  <!-- Dezentes Grid-Pattern -->
  <div class="absolute inset-0 opacity-5" aria-hidden="true">
    <div
      class="h-full w-full"
      style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>
  </div>

  <div
    class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20 lg:py-24 relative z-10 flex items-center min-h-[80svh]"
  >
    <div class="max-w-6xl mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 text-center lg:text-left">
          <div
            class="inline-flex items-center px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs sm:text-sm font-medium animate-fade-in mb-6"
          >
            <span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"
            ></span>
            <span class="hidden sm:inline"
              >Seit {GRUENDUNGSJAHR} • 500+ erfolgreiche Projekte in Regensburg</span
            >
            <span class="sm:hidden">Seit {GRUENDUNGSJAHR} • 500+ Projekte</span>
          </div>

          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight"
          >
            <span class="block text-white">Digitalagentur</span>
            <span class="gradient-text-brand">Regensburg</span>
            <span
              class="block text-white/90 text-2xl md:text-3xl font-normal mt-2"
            >
              für Webdesign, SEO &amp; Online-Marketing
            </span>
          </h1>

          <div
            class="bg-white/10 backdrop-blur-md rounded-2xl p-6 md:p-8 border border-white/20 mb-8"
          >
            <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
              <strong class="text-white"
                >Ihre professionelle Digitalagentur aus Regensburg</strong
              >{" "}– Spezialisiert auf{" "}
              <em class="text-brand-orange">modernes Webdesign</em>,{" "}
              <em class="text-brand-orange">Suchmaschinenoptimierung (SEO)</em> und{
                " "
              }
              <em class="text-brand-orange">strategisches Online-Marketing</em>{
                " "
              }
              für messbare Erfolge und nachhaltiges Wachstum.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a
              href={CALENDLY}
              target="_blank"
              rel="noopener"
              data-calendly-popup-url={CALENDLY}
              class="cta-button-primary"
              aria-label="Kostenlosen Beratungstermin bei ixOne Digitalagentur Regensburg vereinbaren"
            >
              <span>Kostenlose Erstberatung starten</span>
            </a>
            <a
              href="#services"
              class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 text-center"
              aria-label="Digitalagentur Services von ixOne entdecken"
            >
              <span class="flex items-center justify-center gap-2">
                Services entdecken
                <svg
                  class="w-5 h-5 group-hover:translate-y-1 transition-transform duration-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
              </span>
            </a>
          </div>

          <div
            class="flex flex-wrap justify-center lg:justify-start gap-6 text-sm"
          >
            {
              [
                "Kostenlose SEO-Analyse",
                "Keine Mindestlaufzeit",
                "Persönlicher Service",
              ].map((label) => (
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400 shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="text-white/90 font-medium">{label}</span>
                </span>
              ))
            }
          </div>
        </div>

        <div class="lg:col-span-4">
          <div
            class="relative bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-6 md:p-8 overflow-hidden shadow-2xl animate-fade-in"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 via-yellow-400/10 to-purple-500/10 opacity-70"
            >
            </div>
            <div
              class="absolute -top-10 -right-10 w-48 h-48 bg-white/10 rounded-full blur-3xl"
            >
            </div>

            <div class="relative z-10 space-y-6">
              <div class="flex items-center gap-3">
                <div
                  class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-orange to-yellow-400 flex items-center justify-center text-white font-bold shadow-lg"
                  aria-hidden="true"
                >
                  iX
                </div>
                <div>
                  <p class="text-white/80 text-sm">Digitalagentur Regensburg</p>
                  <p class="text-white text-xl font-semibold">
                    {jahreErfahrung} Jahre Erfahrung
                  </p>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div
                  class="rounded-2xl border border-white/20 bg-white/5 p-4 text-center"
                >
                  <p class="text-3xl font-bold text-white">500+</p>
                  <p class="text-white/70 text-sm">Projekte</p>
                </div>
                <div
                  class="rounded-2xl border border-white/20 bg-white/5 p-4 text-center"
                >
                  <p class="text-3xl font-bold text-white">5★</p>
                  <p class="text-white/70 text-sm">Bewertungen</p>
                </div>
              </div>

              <div
                class="rounded-2xl border border-white/20 bg-gradient-to-r from-brand-orange/30 via-yellow-400/20 to-brand-orange/30 p-4"
              >
                <p class="text-white font-semibold mb-2">
                  "Modernes Webdesign, das auffällt."
                </p>
                <p class="text-white/80 text-sm">
                  Individuelle Websites mit Performance, SEO und Conversion im
                  Fokus.
                </p>
              </div>

              <div class="flex items-center gap-3">
                <span
                  class="w-2 h-2 bg-green-400 rounded-full animate-pulse shrink-0"
                  aria-hidden="true"></span>
                <p class="text-white/80 text-sm">
                  Sofort verfügbar für neue Projekte
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════
     Hero Scale & Fade (scroll-gebunden, reines CSS)
     RÜCKBAU: Einfach diesen <style>-Block löschen.
     ═══════════════════════════════════════════════════════════ */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-section {
        animation: hero-exit linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 90%;
        transform-origin: 50% 20%;
      }

      @keyframes hero-exit {
        to {
          transform: scale(0.92);
          opacity: 0.35;
          filter: brightness(0.55) saturate(0.8);
          border-radius: 2.5rem;
        }
      }
    }
  }
</style>
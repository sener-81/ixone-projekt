---
// Portfolio.astro
---

<section class="py-16 bg-white">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Unsere Webdesign Projekte
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Erfolgreiche Websites für Unternehmen aus Regensburg und Bayern – von
        der Konzeption bis zum Launch
      </p>
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Projekt 1 -->
      <article
        class="group bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300"
      >
        <div
          class="relative overflow-hidden aspect-video bg-gradient-to-br from-blue-500 to-blue-700"
        >
          <img
            src="data:image/svg+xml,%3Csvg width='800' height='600' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='800' height='600' fill='%232563eb'/%3E%3Ctext x='50%25' y='50%25' font-size='48' fill='white' text-anchor='middle' dominant-baseline='middle' font-family='Arial'%3EHandwerk%3C/text%3E%3C/svg%3E"
            alt="Handwerker Website Regensburg"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
            loading="lazy"
            width="800"
            height="600"
          />
          <div
            class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
          >
            <span class="text-white font-semibold text-lg">Projekt ansehen</span
            >
          </div>
        </div>

        <div class="p-6">
          <span
            class="inline-block px-3 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded-full mb-3"
          >
            Handwerk
          </span>
          <h3 class="text-xl font-bold text-gray-900 mb-2">
            Sanitär Weber GmbH
          </h3>
          <p class="text-gray-600 mb-4 leading-relaxed">
            Moderne Website mit Terminbuchung und Service-Portal für
            Handwerksbetrieb aus Regensburg
          </p>

          <!-- Ergebnisse -->
          <div
            class="grid grid-cols-2 gap-3 mb-4 pt-4 border-t border-gray-200"
          >
            <div>
              <p class="text-2xl font-bold text-blue-600">98/100</p>
              <p class="text-xs text-gray-600">PageSpeed</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-green-600">+180%</p>
              <p class="text-xs text-gray-600">Anfragen</p>
            </div>
          </div>

          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Online-Terminbuchung
            </li>
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Local SEO optimiert
            </li>
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              CMS für eigene Pflege
            </li>
          </ul>
        </div>
      </article>

      <!-- Projekt 2 -->
      <article
        class="group bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300"
      >
        <div
          class="relative overflow-hidden aspect-video bg-gradient-to-br from-purple-500 to-purple-700"
        >
          <img
            src="data:image/svg+xml,%3Csvg width='800' height='600' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='800' height='600' fill='%237c3aed'/%3E%3Ctext x='50%25' y='50%25' font-size='48' fill='white' text-anchor='middle' dominant-baseline='middle' font-family='Arial'%3EE-Commerce%3C/text%3E%3C/svg%3E"
            alt="Online Shop Regensburg"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
            loading="lazy"
            width="800"
            height="600"
          />
          <div
            class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
          >
            <span class="text-white font-semibold text-lg">Projekt ansehen</span
            >
          </div>
        </div>

        <div class="p-6">
          <span
            class="inline-block px-3 py-1 bg-purple-100 text-purple-700 text-xs font-semibold rounded-full mb-3"
          >
            E-Commerce
          </span>
          <h3 class="text-xl font-bold text-gray-900 mb-2">RegioShop Bayern</h3>
          <p class="text-gray-600 mb-4 leading-relaxed">
            Performanter Online-Shop für regionale Produkte mit nahtloser
            Payment-Integration
          </p>

          <div
            class="grid grid-cols-2 gap-3 mb-4 pt-4 border-t border-gray-200"
          >
            <div>
              <p class="text-2xl font-bold text-blue-600">95/100</p>
              <p class="text-xs text-gray-600">PageSpeed</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-green-600">+240%</p>
              <p class="text-xs text-gray-600">Umsatz</p>
            </div>
          </div>

          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              WooCommerce Integration
            </li>
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Conversion-Optimierung
            </li>
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Mobile-First Design
            </li>
          </ul>
        </div>
      </article>

      <!-- Projekt 3 -->
      <article
        class="group bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300"
      >
        <div
          class="relative overflow-hidden aspect-video bg-gradient-to-br from-green-500 to-green-700"
        >
          <img
            src="data:image/svg+xml,%3Csvg width='800' height='600' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='800' height='600' fill='%2316a34a'/%3E%3Ctext x='50%25' y='50%25' font-size='48' fill='white' text-anchor='middle' dominant-baseline='middle' font-family='Arial'%3EGastronomie%3C/text%3E%3C/svg%3E"
            alt="Restaurant Website Regensburg"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
            loading="lazy"
            width="800"
            height="600"
          />
          <div
            class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
          >
            <span class="text-white font-semibold text-lg">Projekt ansehen</span
            >
          </div>
        </div>

        <div class="p-6">
          <span
            class="inline-block px-3 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-full mb-3"
          >
            Gastronomie
          </span>
          <h3 class="text-xl font-bold text-gray-900 mb-2">
            Restaurant Zeitlos
          </h3>
          <p class="text-gray-600 mb-4 leading-relaxed">
            Moderne Restaurant-Website mit Online-Reservierung und digitaler
            Speisekarte
          </p>

          <div
            class="grid grid-cols-2 gap-3 mb-4 pt-4 border-t border-gray-200"
          >
            <div>
              <p class="text-2xl font-bold text-blue-600">96/100</p>
              <p class="text-xs text-gray-600">PageSpeed</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-green-600">+150%</p>
              <p class="text-xs text-gray-600">Reservierungen</p>
            </div>
          </div>

          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Online-Tischreservierung
            </li>
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Digitale Speisekarte
            </li>
            <li class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Google Maps Integration
            </li>
          </ul>
        </div>
      </article>
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a
        href="/portfolio"
        class="inline-block bg-gray-900 text-white px-8 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors"
      >
        Alle Projekte ansehen
      </a>
    </div>
  </div>
</section>

---
// TechStack.astro
---

<section
  class="py-12 md:py-16 lg:py-24 bg-gradient-to-br from-gray-900 to-gray-800 text-white"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 max-w-7xl">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 md:mb-6">
        Moderne Technologien für maximale Performance
      </h2>
      <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto">
        Wir setzen auf zukunftssichere Technologien, die Ihre Website schnell,
        sicher und skalierbar machen
      </p>
    </div>

    <!-- Tech Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 lg:gap-10 mb-12">
      <!-- Astro -->
      <div class="flex flex-col items-center text-center group">
        <div
          class="w-20 h-20 bg-white rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
        >
          <svg viewBox="0 0 256 366" class="w-12 h-12" fill="none">
            <path
              d="M182.022 9.147c2.982 3.702 4.502 8.697 7.543 18.687L256 246.074a276.467 276.467 0 0 0-79.426-26.891L133.318 73.008a5.63 5.63 0 0 0-10.802.017L79.784 219.11A276.453 276.453 0 0 0 0 246.04L66.76 27.783c3.051-9.972 4.577-14.959 7.559-18.654a24.541 24.541 0 0 1 9.946-7.358C88.67 0 93.885 0 104.314 0h47.683c10.443 0 15.664 0 20.074 1.774a24.545 24.545 0 0 1 9.95 7.373Z"
              fill="#FF5D01"></path>
            <path
              d="M189.972 256.46c-10.952 9.364-32.812 15.751-57.992 15.751-30.904 0-56.807-9.621-63.68-22.56-2.458 7.415-3.009 15.903-3.009 21.324 0 0-1.619 26.623 16.898 45.14 0-9.615 7.795-17.41 17.41-17.41 16.48 0 16.46 14.378 16.446 26.043l-.001 1.041c0 17.705 10.82 32.883 26.21 39.28a35.685 35.685 0 0 1-3.588-15.647c0-16.886 9.913-23.173 21.435-30.48 9.167-5.814 19.353-12.274 26.372-25.232a47.588 47.588 0 0 0 5.742-22.735c0-5.06-.786-9.938-2.243-14.515Z"
              fill="#FF5D01"></path>
          </svg>
        </div>
        <h3 class="font-bold text-lg mb-2">Astro</h3>
        <p class="text-sm text-gray-400">Blitzschnelle Static Sites</p>
      </div>

      <!-- React -->
      <div class="flex flex-col items-center text-center group">
        <div
          class="w-20 h-20 bg-white rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
        >
          <svg viewBox="0 0 256 228" class="w-12 h-12">
            <path
              fill="#00D8FF"
              d="M210.483 73.824a171.49 171.49 0 0 0-8.24-2.597c.465-1.9.893-3.777 1.273-5.621 6.238-30.281 2.16-54.676-11.769-62.708-13.355-7.7-35.196.329-57.254 19.526a171.23 171.23 0 0 0-6.375 5.848 155.866 155.866 0 0 0-4.241-3.917C100.759 3.829 77.587-4.822 63.673 3.233 50.33 10.957 46.379 33.89 51.995 62.588a170.974 170.974 0 0 0 1.892 8.48c-3.28.932-6.445 1.924-9.474 2.98C17.309 83.498 0 98.307 0 113.668c0 15.865 18.582 31.778 46.812 41.427a145.52 145.52 0 0 0 6.921 2.165 167.467 167.467 0 0 0-2.01 9.138c-5.354 28.2-1.173 50.591 12.134 58.266 13.744 7.926 36.812-.22 59.273-19.855a145.567 145.567 0 0 0 5.342-4.923 168.064 168.064 0 0 0 6.92 6.314c21.758 18.722 43.246 26.282 56.54 18.586 13.731-7.949 18.194-32.003 12.4-61.268a145.016 145.016 0 0 0-1.535-6.842c1.62-.48 3.21-.974 4.76-1.488 29.348-9.723 48.443-25.443 48.443-41.52 0-15.417-17.868-30.326-45.517-39.844Zm-6.365 70.984c-1.4.463-2.836.91-4.3 1.345-3.24-10.257-7.612-21.163-12.963-32.432 5.106-11 9.31-21.767 12.459-31.957 2.619.758 5.16 1.557 7.61 2.4 23.69 8.156 38.14 20.213 38.14 29.504 0 9.896-15.606 22.743-40.946 31.14Zm-10.514 20.834c2.562 12.94 2.927 24.64 1.23 33.787-1.524 8.219-4.59 13.698-8.382 15.893-8.067 4.67-25.32-1.4-43.927-17.412a156.726 156.726 0 0 1-6.437-5.87c7.214-7.889 14.423-17.06 21.459-27.246 12.376-1.098 24.068-2.894 34.671-5.345.522 2.107.986 4.173 1.386 6.193ZM87.276 214.515c-7.882 2.783-14.16 2.863-17.955.675-8.075-4.657-11.432-22.636-6.853-46.752a156.923 156.923 0 0 1 1.869-8.499c10.486 2.32 22.093 3.988 34.498 4.994 7.084 9.967 14.501 19.128 21.976 27.15a134.668 134.668 0 0 1-4.877 4.492c-9.933 8.682-19.886 14.842-28.658 17.94ZM50.35 144.747c-12.483-4.267-22.792-9.812-29.858-15.863-6.35-5.437-9.555-10.836-9.555-15.216 0-9.322 13.897-21.212 37.076-29.293 2.813-.98 5.757-1.905 8.812-2.773 3.204 10.42 7.406 21.315 12.477 32.332-5.137 11.18-9.399 22.249-12.634 32.792a134.718 134.718 0 0 1-6.318-1.979Zm12.378-84.26c-4.811-24.587-1.616-43.134 6.425-47.789 8.564-4.958 27.502 2.111 47.463 19.835a144.318 144.318 0 0 1 3.841 3.545c-7.438 7.987-14.787 17.08-21.808 26.988-12.04 1.116-23.565 2.908-34.161 5.309a160.342 160.342 0 0 1-1.76-7.887Zm110.427 27.268a347.8 347.8 0 0 0-7.785-12.803c8.168 1.033 15.994 2.404 23.343 4.08-2.206 7.072-4.956 14.465-8.193 22.045a381.151 381.151 0 0 0-7.365-13.322Zm-45.032-43.861c5.044 5.465 10.096 11.566 15.065 18.186a322.04 322.04 0 0 0-30.257-.006c4.974-6.559 10.069-12.652 15.192-18.18ZM82.802 87.83a323.167 323.167 0 0 0-7.227 13.238c-3.184-7.553-5.909-14.98-8.134-22.152 7.304-1.634 15.093-2.97 23.209-3.984a321.524 321.524 0 0 0-7.848 12.897Zm8.081 65.352c-8.385-.936-16.291-2.203-23.593-3.793 2.26-7.3 5.045-14.885 8.298-22.6a321.187 321.187 0 0 0 7.257 13.246c2.594 4.48 5.28 8.868 8.038 13.147Zm37.542 31.03c-5.184-5.592-10.354-11.779-15.403-18.433 4.902.192 9.899.29 14.978.29 5.218 0 10.376-.117 15.453-.343-4.985 6.774-10.018 12.97-15.028 18.486Zm52.198-57.817c3.422 7.8 6.306 15.345 8.596 22.52-7.422 1.694-15.436 3.058-23.88 4.071a382.417 382.417 0 0 0 7.859-13.026 347.403 347.403 0 0 0 7.425-13.565Zm-16.898 8.101a358.557 358.557 0 0 1-12.281 19.815 329.4 329.4 0 0 1-23.444.823c-7.967 0-15.716-.248-23.178-.732a310.202 310.202 0 0 1-12.513-19.846h.001a307.41 307.41 0 0 1-10.923-20.627 310.278 310.278 0 0 1 10.89-20.637l-.001.001a307.318 307.318 0 0 1 12.413-19.761c7.613-.576 15.42-.876 23.31-.876H128c7.926 0 15.743.303 23.354.883a329.357 329.357 0 0 1 12.335 19.695 358.489 358.489 0 0 1 11.036 20.54 329.472 329.472 0 0 1-11 20.722Zm22.56-122.124c8.572 4.944 11.906 24.881 6.52 51.026-.344 1.668-.73 3.367-1.15 5.09-10.622-2.452-22.155-4.275-34.23-5.408-7.034-10.017-14.323-19.124-21.64-27.008a160.789 160.789 0 0 1 5.888-5.4c18.9-16.447 36.564-22.941 44.612-18.3ZM128 90.808c12.625 0 22.86 10.235 22.86 22.86s-10.235 22.86-22.86 22.86-22.86-10.235-22.86-22.86 10.235-22.86 22.86-22.86Z"
            ></path>
          </svg>
        </div>
        <h3 class="font-bold text-lg mb-2">React</h3>
        <p class="text-sm text-gray-400">Interaktive UI-Komponenten</p>
      </div>

      <!-- Tailwind CSS -->
      <div class="flex flex-col items-center text-center group">
        <div
          class="w-20 h-20 bg-white rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
        >
          <svg viewBox="0 0 256 154" class="w-12 h-12">
            <defs>
              <linearGradient
                x1="-2.778%"
                y1="32%"
                x2="100%"
                y2="67.556%"
                id="gradient"
              >
                <stop stop-color="#2298BD" offset="0%"></stop>
                <stop stop-color="#0ED7B5" offset="100%"></stop>
              </linearGradient>
            </defs>
            <path
              d="M128 0C93.867 0 72.533 17.067 64 51.2 76.8 34.133 91.733 27.733 108.8 32c9.737 2.434 16.697 9.499 24.401 17.318C145.751 62.057 160.275 76.8 192 76.8c34.133 0 55.467-17.067 64-51.2-12.8 17.067-27.733 23.467-44.8 19.2-9.737-2.434-16.697-9.499-24.401-17.318C174.249 14.743 159.725 0 128 0ZM64 76.8C29.867 76.8 8.533 93.867 0 128c12.8-17.067 27.733-23.467 44.8-19.2 9.737 2.434 16.697 9.499 24.401 17.318C81.751 138.857 96.275 153.6 128 153.6c34.133 0 55.467-17.067 64-51.2-12.8 17.067-27.733 23.467-44.8 19.2-9.737-2.434-16.697-9.499-24.401-17.318C110.249 91.543 95.725 76.8 64 76.8Z"
              fill="url(#gradient)"></path>
          </svg>
        </div>
        <h3 class="font-bold text-lg mb-2">Tailwind CSS</h3>
        <p class="text-sm text-gray-400">Utility-First Styling</p>
      </div>

      <!-- WordPress -->
      <div class="flex flex-col items-center text-center group">
        <div
          class="w-20 h-20 bg-white rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
        >
          <svg viewBox="0 0 256 255" class="w-12 h-12">
            <path
              d="M18.124 127.5c0 43.296 25.16 80.711 61.646 98.442L27.594 82.986a108.965 108.965 0 0 0-9.47 44.514zm183.221-5.52c0-13.517-4.856-22.879-9.02-30.165-5.545-9.01-10.742-16.64-10.742-25.65 0-10.055 7.626-19.415 18.368-19.415.486 0 .947.06 1.417.088-19.46-17.828-45.387-28.714-73.863-28.714-38.213 0-71.832 19.606-91.39 49.302 2.566.077 4.984.13 7.039.13 11.44 0 29.151-1.387 29.151-1.387 5.897-.348 6.592 8.312.702 9.01 0 0-5.926.697-12.52 1.042l39.832 118.48 23.937-71.79-17.042-46.692c-5.886-.345-11.47-1.042-11.47-1.042-5.894-.346-5.209-9.358.691-9.01 0 0 18.064 1.388 28.811 1.388 11.44 0 29.151-1.388 29.151-1.388 5.897-.346 6.592 8.313.702 9.01 0 0-5.938.697-12.52 1.042l39.528 117.581 10.91-36.458c4.72-15.093 8.322-25.946 8.322-35.3z"
              fill="#464342"></path>
            <path
              d="M131.11 136.805l-32.846 95.434c9.613 2.84 19.745 4.356 30.233 4.356 12.449 0 24.419-2.147 35.599-6.088a10.495 10.495 0 0 1-.766-1.477l-32.22-92.225zm92.278-60.607c.478 3.542.748 7.346.748 11.434 0 11.27-2.108 23.94-8.449 39.795l-33.93 98.116c33.015-19.245 55.235-54.974 55.235-96.238 0-19.492-5.02-37.816-13.82-53.603l.216.496z"
              fill="#464342"></path>
            <path
              d="M127.505 0C57.2 0 0 57.196 0 127.5c0 70.313 57.2 127.5 127.505 127.5 70.302 0 127.505-57.187 127.505-127.5C255.01 57.196 197.807 0 127.505 0zm0 249.163c-67.08 0-121.581-54.578-121.581-121.663 0-67.08 54.576-121.654 121.581-121.654 67.082 0 121.659 54.575 121.659 121.654 0 67.085-54.577 121.663-121.66 121.663z"
              fill="#464342"></path>
          </svg>
        </div>
        <h3 class="font-bold text-lg mb-2">WordPress</h3>
        <p class="text-sm text-gray-400">Headless CMS Option</p>
      </div>
    </div>

    <!-- Comparison Section -->
    <div class="bg-gray-800/50 rounded-xl p-8 backdrop-blur-sm">
      <h3 class="text-2xl font-bold text-center mb-8">
        Unsere Websites vs. Standard-WordPress
      </h3>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Links: Standard WordPress -->
        <div class="space-y-4">
          <h4 class="text-xl font-semibold text-red-400 mb-4">
            ❌ Standard WordPress
          </h4>
          <div class="space-y-3">
            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-red-400 mr-3 mt-1 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-medium">Ladezeit: 4-8 Sekunden</p>
                <p class="text-sm text-gray-400">Langsame Page Performance</p>
              </div>
            </div>

            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-red-400 mr-3 mt-1 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-medium">PageSpeed: 40-60/100</p>
                <p class="text-sm text-gray-400">Schlechte Google-Rankings</p>
              </div>
            </div>

            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-red-400 mr-3 mt-1 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-medium">Viele Plugins = Sicherheitsrisiko</p>
                <p class="text-sm text-gray-400">Ständige Updates nötig</p>
              </div>
            </div>

            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-red-400 mr-3 mt-1 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-medium">Hohe Server-Kosten</p>
                <p class="text-sm text-gray-400">Ressourcenhungrig</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Rechts: Unsere Lösung -->
        <div class="space-y-4">
          <h4 class="text-xl font-semibold text-green-400 mb-4">
            ✅ Unsere Performance-Websites
          </h4>
          <div class="space-y-3">
            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-green-400 mr-3 mt-1 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-medium">Ladezeit: 0,5-1,5 Sekunden</p>
                <p class="text-sm text-gray-400">Blitzschnelle Performance</p>
              </div>
            </div>

            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-green-400 mr-3 mt-1 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-medium">PageSpeed: 95-100/100</p>
                <p class="text-sm text-gray-400">Top Google-Rankings</p>
              </div>
            </div>

            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-green-400 mr-3 mt-1 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-medium">Höchste Sicherheit</p>
                <p class="text-sm text-gray-400">Keine Plugin-Abhängigkeit</p>
              </div>
            </div>

            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-green-400 mr-3 mt-1 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-medium">Günstigeres Hosting</p>
                <p class="text-sm text-gray-400">Minimaler Server-Bedarf</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Stats -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12 pt-8 border-t border-gray-700"
      >
        <div class="text-center">
          <p class="text-3xl font-bold text-green-400">5x</p>
          <p class="text-sm text-gray-400 mt-1">Schneller</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-green-400">98+</p>
          <p class="text-sm text-gray-400 mt-1">PageSpeed Score</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-green-400">-70%</p>
          <p class="text-sm text-gray-400 mt-1">Server-Kosten</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-green-400">100%</p>
          <p class="text-sm text-gray-400 mt-1">SEO-Optimiert</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <p class="text-lg text-gray-300 mb-6">
        Überzeugt? Lassen Sie uns Ihre Website mit modernsten Technologien
        umsetzen.
      </p>
      <a
        href="/kontakt"
        class="inline-block bg-gradient-to-r from-blue-500 to-blue-600 text-white px-8 py-4 rounded-lg font-semibold hover:from-blue-600 hover:to-blue-700 transition-all shadow-lg hover:shadow-xl"
      >
        Kostenlose Technologie-Beratung
      </a>
    </div>
  </div>
</section>

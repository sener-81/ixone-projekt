---
// SimpleHero.astro
interface Props {
  backgroundBase: string; // z.B. "/assets/webdesigner-aus-regensburg"
  alt: string;
  title: string;
  subtitle?: string;
}
const { backgroundBase, alt, title, subtitle } = Astro.props;
---

<section
  class="relative min-h-[80vh] text-white overflow-hidden bg-black"
  aria-label={alt}
>
  <!-- 1. Responsive <img> mit srcset/sizes -->
  <img
    srcset={`
      ${backgroundBase}-1920.webp 1920w,
      ${backgroundBase}-1200.webp 1200w,
      ${backgroundBase}-768.webp 768w
    `}
    sizes="(max-width: 768px) 100vw, (max-width: 1200px) 100vw, 1920px"
    src={`${backgroundBase}-768.webp`}
    alt={alt}
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="eager"
    decoding="async"
  />

  <!-- 2. Dunkler Overlay für +Kontrast -->
  <div class="absolute inset-0 bg-black/60"></div>

  <!-- … deine Farb-Blobs, Pattern etc. … -->

  <!-- 3. Content -->
  <div
    class="container mx-auto px-4 py-20 relative z-10 flex items-center min-h-[80vh]"
  >
    <div
      class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center"
    >
      <div class="lg:col-span-8 text-center lg:text-left space-y-6">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          {title}
        </h1>
        {
          subtitle && (
            <p class="text-xl md:text-2xl max-w-2xl mx-auto lg:mx-0">
              {subtitle}
            </p>
          )
        }
        <!-- 4. Slot für CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <slot />
        </div>
      </div>
      <div class="hidden lg:block lg:col-span-4"></div>
    </div>
  </div>
</section>

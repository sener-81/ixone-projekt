---
// ═══════════════════════════════════════════════════════════════
// src/components/WebdesignCarousel.astro
//
// Auto-Loop-Carousel OHNE Lightbox für die Seite
// /webdesign-regensburg/ und optional für Landingpages.
// Reine Anzeige – kein Popup, keine Klick-Interaktion.
//
// Datenquelle: src/data/galerieData.ts (NUR Website-Projekte)
// Bilder:      src/assets/galerie/
// Neues Website-Projekt = 1 Bild + 1 Eintrag in galerieData.ts
// → erscheint automatisch im Carousel.
//
// Verhalten wie das Archiv-Carousel: Autoplay, Pfeile, Drag,
// Snap – keine Lightbox, keine Hover-Effekte auf den Bildern.
// Alt-Texte bleiben im HTML → voll SEO-wirksam.
// Eigene Selektoren (wdc-) → kollisionsfrei.
//
// Performance:
// - Thumbnails: 640px WebP, loading="lazy"
// - Autoplay pausiert bei Hover/Touch, startet erst wenn
//   sichtbar, respektiert prefers-reduced-motion
//
// Einbinden (id "webdesign-galerie" bleibt Anker für den
// Hero-Button "Projekte ansehen"):
//   import WebdesignCarousel from "../components/WebdesignCarousel.astro";
//   <WebdesignCarousel />
// ═══════════════════════════════════════════════════════════════
import { getImage } from "astro:assets";
import { galerieData } from "../data/galerieData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/galerie/*.{webp,jpg,jpeg,png,avif}",
);

const slides = await Promise.all(
  galerieData.map(async (item) => {
    const path = `../assets/galerie/${item.file}`;
    const loader = imageModules[path];
    if (!loader) {
      throw new Error(
        `[WebdesignCarousel] Bild nicht gefunden: src/assets/galerie/${item.file}`,
      );
    }
    const mod = await loader();
    const thumb = await getImage({
      src: mod.default,
      width: 640,
      format: "webp",
    });
    return { ...item, thumb };
  }),
);
---

<section
  id="webdesign-galerie"
  class="py-20 md:py-28 lg:py-32 bg-white overflow-hidden"
  aria-labelledby="webdesign-carousel-heading"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12 md:mb-16">
        <h2
          id="webdesign-carousel-heading"
          class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
        >
          Unsere <span class="gradient-text-brand-inline">Webdesign</span> Projekte
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Ausgewählte Referenzen aus Regensburg und Bayern – performant, modern
          und conversion-optimiert.
        </p>
      </div>
    </div>
  </div>

  <div class="relative max-w-[100rem] mx-auto" data-wdc-carousel>
    <!-- Track -->
    <ul
      class="wdc-track flex gap-5 md:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth px-4 sm:px-6 lg:px-8 pb-4 cursor-grab select-none"
      data-wdc-track
      aria-label="Webdesign Referenzen ixOne Regensburg"
    >
      {
        slides.map((slide) => (
          <li class="snap-center shrink-0 w-[82%] sm:w-[52%] lg:w-[31%] xl:w-[26%]">
            <figure class="relative block w-full overflow-hidden rounded-2xl shadow-md">
              <img
                src={slide.thumb.src}
                width={slide.thumb.attributes.width}
                height={slide.thumb.attributes.height}
                alt={slide.alt}
                loading="lazy"
                decoding="async"
                draggable="false"
                class="w-full h-auto aspect-[4/3] object-cover object-top"
              />
            </figure>
          </li>
        ))
      }
    </ul>

    <!-- Pfeile (Desktop) -->
    <button
      type="button"
      class="hidden md:flex absolute left-4 top-1/2 -translate-y-1/2 items-center justify-center w-11 h-11 rounded-full bg-white shadow-lg text-gray-700 hover:text-brand-orange transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange"
      data-wdc-prev
      aria-label="Vorheriges Projekt"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    <button
      type="button"
      class="hidden md:flex absolute right-4 top-1/2 -translate-y-1/2 items-center justify-center w-11 h-11 rounded-full bg-white shadow-lg text-gray-700 hover:text-brand-orange transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange"
      data-wdc-next
      aria-label="Nächstes Projekt"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>

  <div class="text-center mt-12 px-4 sm:px-6 lg:px-8">
    <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-8">
      Wer hinter diesen Projekten steckt und was genau umgesetzt wurde, finden
      Sie bei den{" "}
      <a
        href="/referenzen/"
        class="text-brand-orange font-semibold hover:underline">Referenzen</a
      >. Welche Schwerpunkte in Ihrer Branche zählen, steht in der{" "}
      <a
        href="/branchen/"
        class="text-brand-orange font-semibold hover:underline"
        >Branchenübersicht</a
      >.
    </p>
    <a
      href={CALENDLY}
      target="_blank"
      rel="noopener"
      data-calendly-popup-url={CALENDLY}
      class="cta-button-compact"
      style="display:inline-flex; align-items:center; gap:0.5rem;"
    >
      <span>Ihr Projekt starten</span>
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .wdc-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .wdc-track::-webkit-scrollbar {
    display: none;
  }
  .wdc-track.wdc-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }
</style>

<script>
  function initWebdesignCarousel() {
    const root = document.querySelector<HTMLElement>("[data-wdc-carousel]");
    if (!root) return;

    const track = root.querySelector<HTMLElement>("[data-wdc-track]");
    const prevBtn = root.querySelector<HTMLElement>("[data-wdc-prev]");
    const nextBtn = root.querySelector<HTMLElement>("[data-wdc-next]");
    if (!track) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // ── Slide-Breite ermitteln ────────────────────────────────
    const slideStep = () => {
      const first = track.querySelector<HTMLElement>("li");
      if (!first) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
      return first.offsetWidth + gap;
    };

    const atEnd = () =>
      track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;

    const goNext = () => {
      if (atEnd()) {
        track.scrollTo({ left: 0, behavior: "smooth" });
      } else {
        track.scrollBy({ left: slideStep(), behavior: "smooth" });
      }
    };
    const goPrev = () => {
      if (track.scrollLeft <= 8) {
        track.scrollTo({ left: track.scrollWidth, behavior: "smooth" });
      } else {
        track.scrollBy({ left: -slideStep(), behavior: "smooth" });
      }
    };

    nextBtn?.addEventListener("click", goNext);
    prevBtn?.addEventListener("click", goPrev);

    // ── Autoplay (Loop) ───────────────────────────────────────
    let timer: number | undefined;
    let paused = false;

    const start = () => {
      if (reducedMotion || timer) return;
      timer = window.setInterval(() => {
        if (!paused && !document.hidden) goNext();
      }, 3500);
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    ["mouseenter", "focusin", "touchstart", "pointerdown"].forEach((ev) =>
      track.addEventListener(ev, () => (paused = true), { passive: true }),
    );
    ["mouseleave", "focusout"].forEach((ev) =>
      track.addEventListener(ev, () => (paused = false)),
    );
    track.addEventListener(
      "touchend",
      () => {
        window.setTimeout(() => (paused = false), 5000);
      },
      { passive: true },
    );

    // Autoplay erst starten, wenn das Carousel sichtbar ist
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) start();
          else stop();
        });
      },
      { threshold: 0.25 },
    );
    io.observe(root);

    // ── Maus-Drag (Desktop) ───────────────────────────────────
    let isDown = false;
    let startX = 0;
    let startScroll = 0;

    track.addEventListener("mousedown", (e) => {
      isDown = true;
      startX = e.pageX;
      startScroll = track.scrollLeft;
      track.classList.add("wdc-dragging");
    });
    window.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      track.scrollLeft = startScroll - (e.pageX - startX);
    });
    window.addEventListener("mouseup", () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove("wdc-dragging");
      window.setTimeout(() => (paused = false), 4000);
    });
  }

  initWebdesignCarousel();
</script>

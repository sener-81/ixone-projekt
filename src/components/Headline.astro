---
interface Props {
  tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  className?: string;
  size?: "small" | "medium" | "large" | "xl";
}

const { tag = "h2", className = "", size = "medium" }: Props = Astro.props;

const sizeClasses = {
  small: "text-2xl md:text-3xl",
  medium: "text-3xl md:text-4xl",
  large: "text-4xl md:text-5xl",
  xl: "text-5xl md:text-6xl",
} as const;

const Element = tag;
---

<Element class={`${sizeClasses[size]} font-black mb-6 ${className}`}>
  <slot />
</Element>

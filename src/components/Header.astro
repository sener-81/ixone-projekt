---
import { navItems } from "../data/navigation";
import Logo from "./Logo.astro";
import MobileMenu from "./MobileMenu.astro";

const CALENDLY_URL =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const pfad = Astro.url.pathname;
const istAktiv = (item: (typeof navItems)[number]) =>
  item.href === pfad ||
  (item.children ?? []).some((kind) => kind.href === pfad);
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white border-b border-gray-200 shadow-sm"
  id="header"
>
  <div
    class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 xl:px-12 2xl:px-16"
  >
    <div
      class="flex justify-between items-center h-14 sm:h-16 md:h-18 lg:h-20 xl:h-22"
    >
      <div class="flex-shrink-0 z-50">
        <Logo />
      </div>

      <nav
        class="hidden lg:flex items-center space-x-0.5 xl:space-x-1"
        aria-label="Hauptnavigation"
      >
        {
          navItems.map((item) =>
            item.children ? (
              <div class="nav-dropdown relative" data-dropdown>
                <button
                  type="button"
                  class="nav-item relative flex items-center gap-1 px-2.5 xl:px-3.5 py-2 text-sm lg:text-[0.95rem] xl:text-lg text-gray-700 hover:text-brand-orange transition-colors duration-300 font-medium group outline-none"
                  aria-expanded="false"
                  aria-haspopup="true"
                  data-dropdown-trigger
                >
                  <span class="relative z-10">{item.label}</span>
                  <svg
                    class="w-4 h-4 transition-transform duration-300"
                    data-dropdown-chevron
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                  <span
                    class:list={[
                      "absolute bottom-1 left-2.5 xl:left-3.5 right-6 h-0.5 bg-gradient-to-r from-brand-orange to-yellow-500 transform transition-transform duration-300 origin-left rounded-full",
                      istAktiv(item)
                        ? "scale-x-100"
                        : "scale-x-0 group-hover:scale-x-100",
                    ]}
                  />
                </button>

                <div
                  class="dropdown-panel absolute left-0 top-full pt-3 w-64"
                  data-dropdown-panel
                >
                  <ul class="bg-white rounded-2xl border border-gray-100 shadow-xl overflow-hidden py-2">
                    {item.children.map((kind) => (
                      <li>
                        <a
                          href={kind.href}
                          class:list={[
                            "flex items-center gap-3 px-5 py-3 text-base transition-colors duration-200 hover:bg-brand-orange/5 hover:text-brand-orange",
                            kind.href === pfad
                              ? "text-brand-orange font-semibold"
                              : "text-gray-700",
                          ]}
                          aria-label={kind.description}
                          aria-current={kind.href === pfad ? "page" : undefined}
                        >
                          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange/40 flex-shrink-0" />
                          {kind.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="nav-item relative px-2.5 xl:px-3.5 py-2 text-sm lg:text-[0.95rem] xl:text-lg text-gray-700 hover:text-brand-orange transition-colors duration-300 font-medium group outline-none"
                aria-label={item.description}
                aria-current={item.href === pfad ? "page" : undefined}
              >
                <span class="relative z-10">{item.label}</span>
                <span
                  class:list={[
                    "absolute bottom-1 left-2.5 xl:left-3.5 right-2.5 xl:right-3.5 h-0.5 bg-gradient-to-r from-brand-orange to-yellow-500 transform transition-transform duration-300 origin-left rounded-full",
                    item.href === pfad
                      ? "scale-x-100"
                      : "scale-x-0 group-hover:scale-x-100",
                  ]}
                />
              </a>
            ),
          )
        }
      </nav>

      <div class="hidden lg:flex">
        <a
          href={CALENDLY_URL}
          class="group relative px-4 lg:px-5 xl:px-7 py-2.5 lg:py-3 xl:py-4 bg-gradient-to-r from-brand-orange to-yellow-500 text-white font-semibold text-sm lg:text-base xl:text-lg rounded-lg xl:rounded-xl shadow-lg hover:shadow-brand-orange/25 transition-all duration-300 transform hover:-translate-y-0.5 hover:scale-105 outline-none overflow-hidden"
          aria-label="Kostenloses Beratungsgespräch vereinbaren"
          data-calendly-popup-url={CALENDLY_URL}
        >
          <span
            class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
          ></span>

          <span class="relative z-10 flex items-center gap-1.5 lg:gap-2">
            <span class="hidden xl:inline">Projekt starten</span>
            <span class="xl:hidden">Starten</span>
            <svg
              class="w-3 h-3 lg:w-4 lg:h-4 group-hover:translate-x-1 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        </a>
      </div>

      <MobileMenu />
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("header");
  const dropdowns = Array.from(
    document.querySelectorAll<HTMLElement>("[data-dropdown]"),
  );

  function schliesseAlle(ausser?: HTMLElement) {
    dropdowns.forEach((d) => {
      if (d === ausser) return;
      d.removeAttribute("data-open");
      d.querySelector("[data-dropdown-trigger]")?.setAttribute(
        "aria-expanded",
        "false",
      );
    });
  }

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLElement>(
      "[data-dropdown-trigger]",
    );

    trigger?.addEventListener("click", (event) => {
      event.preventDefault();
      const offen = dropdown.hasAttribute("data-open");
      schliesseAlle(dropdown);
      if (offen) {
        dropdown.removeAttribute("data-open");
        trigger.setAttribute("aria-expanded", "false");
      } else {
        dropdown.setAttribute("data-open", "");
        trigger.setAttribute("aria-expanded", "true");
      }
    });

    dropdown.addEventListener("focusout", (event) => {
      const ziel = event.relatedTarget;
      if (ziel instanceof Node && dropdown.contains(ziel)) return;
      dropdown.removeAttribute("data-open");
      trigger?.setAttribute("aria-expanded", "false");
    });
  });

  document.addEventListener("click", (event) => {
    const ziel = event.target;
    if (ziel instanceof Element && ziel.closest("[data-dropdown]")) return;
    schliesseAlle();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") schliesseAlle();
  });

  let ticking = false;
  let lastScrollY = 0;

  function updateHeader() {
    const scrollY = window.scrollY;
    const richtung = scrollY > lastScrollY ? "down" : "up";
    const differenz = Math.abs(scrollY - lastScrollY);

    if (differenz < 5) {
      ticking = false;
      return;
    }

    if (scrollY > 50) {
      header?.classList.add("scrolled");
    } else {
      header?.classList.remove("scrolled");
    }

    if (richtung === "down" && scrollY > 100) {
      header?.classList.add("header-hidden");
      schliesseAlle();
    } else if (richtung === "up" || scrollY <= 100) {
      header?.classList.remove("header-hidden");
    }

    lastScrollY = scrollY;
    ticking = false;
  }

  function requestTick() {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }

  window.addEventListener("scroll", requestTick, { passive: true });
</script>

<style>
  #header {
    will-change: background-color, backdrop-filter, transform;
    transition:
      transform 0.3s ease-in-out,
      background-color 0.3s ease,
      backdrop-filter 0.3s ease;
  }

  #header.header-hidden {
    transform: translateY(-100%);
  }

  #header.scrolled {
    background-color: #ffffff;
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
  }

  .nav-item {
    position: relative;
  }

  .nav-item:focus,
  .nav-item:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  .dropdown-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    pointer-events: none;
  }

  .nav-dropdown:hover .dropdown-panel,
  .nav-dropdown:focus-within .dropdown-panel,
  .nav-dropdown[data-open] .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-dropdown:hover [data-dropdown-chevron],
  .nav-dropdown[data-open] [data-dropdown-chevron] {
    transform: rotate(180deg);
  }

  @media (max-width: 1024px) {
    .nav-item {
      font-size: 0.875rem;
      padding: 0.5rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #header,
    #header.header-hidden,
    .nav-item,
    .nav-item span,
    .dropdown-panel,
    [data-dropdown-chevron] {
      transition: none;
      animation: none;
    }
  }

  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    #header {
      border-bottom-width: 0.5px;
    }
  }
</style>

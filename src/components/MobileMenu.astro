---
import { navItems } from '../data/navigation';

const CALENDLY_URL =
  'https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b';
---

<div class="lg:hidden relative z-50">
  <!-- Mobile Menu Button -->
  <button 
    id="mobile-menu-button" 
    class="relative p-2 text-gray-700 hover:text-brand-orange transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand-orange focus:ring-offset-2 rounded-lg"
    aria-label="Hauptmenü öffnen"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <!-- Hamburger Icon mit Animation -->
    <div class="w-6 h-6 relative">
      <span class="hamburger-line absolute left-0 top-1 w-6 h-0.5 bg-current transform transition-all duration-300"></span>
      <span class="hamburger-line absolute left-0 top-2.5 w-6 h-0.5 bg-current transform transition-all duration-300"></span>
      <span class="hamburger-line absolute left-0 top-4 w-6 h-0.5 bg-current transform transition-all duration-300"></span>
    </div>
  </button>
  
  <!-- Mobile Menu Fullscreen Overlay -->
  <div 
    id="mobile-menu" 
    class="fixed inset-0 bg-white z-[9999] transform translate-x-full transition-transform duration-300 ease-out"
    role="navigation"
    aria-label="Mobile Navigation"
    aria-hidden="true"
  >
    <div class="flex flex-col h-full">
      <!-- Header mit Close Button -->
      <div class="flex justify-between items-center p-6 border-b border-gray-100">
        <div class="text-xl font-bold text-gray-900">
          <span class="text-gray-900">i</span>
          <span class="text-brand-orange">X</span>
          <span class="text-gray-900">one</span>
        </div>
        <button 
          id="mobile-menu-close" 
          class="p-2 text-gray-700 hover:text-brand-orange hover:bg-gray-100 rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-orange focus:ring-offset-2"
          aria-label="Menü schließen"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <!-- Navigation Links -->
      <div class="flex-1 overflow-y-auto py-6">
        <ul class="space-y-1 px-6">
          {navItems.map((item) => (
            <li>
              <a 
                href={item.href} 
                class="mobile-nav-link group flex items-center justify-between py-4 px-4 text-gray-800 hover:text-brand-orange hover:bg-brand-orange/5 rounded-xl font-medium transition-all duration-200 border-b border-gray-100 last:border-b-0"
                aria-label={item.description}
              >
                <span class="flex items-center gap-3">
                  <!-- Icon ohne Emojis -->
                  <span class="w-8 h-8 bg-gray-100 group-hover:bg-brand-orange/10 rounded-lg flex items-center justify-center text-sm font-bold text-gray-600 group-hover:text-brand-orange transition-all duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      {item.href === '/' ? (
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                      ) : item.href === '/webdesign-regensburg' ? (
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                      ) : item.href === '/seo-regensburg' ? (
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                      ) : item.href === '/online-marketing-regensburg' ? (
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                      ) : item.href === '/social-media-marketing-regensburg' ? (
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path>
                      ) : (
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                      )}
                    </svg>
                  </span>
                  <span>{item.label}</span>
                </span>
                
                <!-- Arrow Icon -->
                <svg class="w-5 h-5 text-gray-400 group-hover:text-brand-orange group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Footer mit CTA -->
      <div class="p-6 border-t border-gray-100 bg-gray-50">
        <!-- Hauptaktion -->
        <a 
          href={CALENDLY_URL}
          class="block w-full bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white px-6 py-4 rounded-xl font-semibold text-center transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 mb-4"
          aria-label="Kostenloses Beratungsgespräch vereinbaren"
          data-calendly-popup-url={CALENDLY_URL}
        >
          Kostenlose Beratung
        </a>
        
        <!-- Kontakt-Info -->
        <div class="text-center space-y-2">
          <a 
            href="tel:+4994015338873" 
            class="flex items-center justify-center gap-2 text-gray-600 hover:text-brand-orange text-sm transition-colors duration-200"
            aria-label="Digitalagentur Regensburg anrufen"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            +49 9401 5338873
          </a>
          
          <p class="text-xs text-gray-500">
            Digitalagentur Regensburg • Seit 2007
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  class MobileMenu {
    // ── Typ-Deklarationen (verhindern TypeScript-Warnungen) ──
    button: HTMLElement | null;
    menu: HTMLElement | null;
    closeButton: HTMLElement | null;
    navLinks: NodeListOf<Element>;
    hamburgerLines: NodeListOf<Element>;
    isOpen: boolean;

    constructor() {
      this.button = document.getElementById('mobile-menu-button');
      this.menu = document.getElementById('mobile-menu');
      this.closeButton = document.getElementById('mobile-menu-close');
      this.navLinks = document.querySelectorAll('.mobile-nav-link');
      this.hamburgerLines = document.querySelectorAll('.hamburger-line');
      this.isOpen = false;

      this.init();
    }

    init() {
      this.button?.addEventListener('click', () => this.toggle());
      this.closeButton?.addEventListener('click', () => this.close());

      this.navLinks.forEach((link) => {
        link.addEventListener('click', () => this.close());
      });

      document.addEventListener('keydown', (event) =>
        this.handleKeydown(event)
      );
    }

    toggle() {
      if (this.isOpen) {
        this.close();
      } else {
        this.open();
      }
    }

    open() {
      if (!this.menu || !this.button) return;

      this.isOpen = true;
      this.menu.classList.remove('translate-x-full');
      this.menu.setAttribute('aria-hidden', 'false');
      this.button.setAttribute('aria-expanded', 'true');
      this.animateHamburgerToX();

      setTimeout(() => {
        this.closeButton?.focus();
      }, 300);
    }

    close() {
      if (!this.menu || !this.button) return;

      this.isOpen = false;
      this.menu.classList.add('translate-x-full');
      this.menu.setAttribute('aria-hidden', 'true');
      this.button.setAttribute('aria-expanded', 'false');
      this.animateXToHamburger();
      this.button.focus();
    }

    animateHamburgerToX() {
      if (this.hamburgerLines.length < 3) return;

      const [line1, line2, line3] = this.hamburgerLines;
      if (line1 instanceof HTMLElement) {
        line1.style.transform = 'rotate(45deg) translate(5px, 5px)';
      }
      if (line2 instanceof HTMLElement) {
        line2.style.opacity = '0';
      }
      if (line3 instanceof HTMLElement) {
        line3.style.transform = 'rotate(-45deg) translate(7px, -6px)';
      }
    }

    animateXToHamburger() {
      if (this.hamburgerLines.length < 3) return;

      const [line1, line2, line3] = this.hamburgerLines;
      if (line1 instanceof HTMLElement) {
        line1.style.transform = '';
      }
      if (line2 instanceof HTMLElement) {
        line2.style.opacity = '1';
      }
      if (line3 instanceof HTMLElement) {
        line3.style.transform = '';
      }
    }

    handleKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape' && this.isOpen) {
        this.close();
      }

      if (this.isOpen && event.key === 'Tab') {
        this.trapFocus(event);
      }
    }

    trapFocus(event: KeyboardEvent) {
      if (!this.menu) return;

      const focusableElements = this.menu.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );

      const firstElement = focusableElements[0];
      const lastElement =
        focusableElements[focusableElements.length - 1];

      if (!(firstElement instanceof HTMLElement) || !(lastElement instanceof HTMLElement)) {
        return;
      }

      if (event.shiftKey) {
        if (document.activeElement === firstElement) {
          lastElement.focus();
          event.preventDefault();
        }
      } else if (document.activeElement === lastElement) {
        firstElement.focus();
        event.preventDefault();
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new MobileMenu();
  });
</script>

<style>
  /* Mobile Menu Styles - Fullscreen */
  #mobile-menu {
    will-change: transform;
    height: 100vh;
    height: 100dvh; /* Dynamic viewport height für mobile */
  }
  
  /* Hamburger Animation */
  .hamburger-line {
    will-change: transform, opacity;
  }
  
  /* Navigation Links */
  .mobile-nav-link {
    min-height: 56px; /* Touch-friendly */
  }
  
  .mobile-nav-link:active {
    transform: scale(0.98);
  }
  
  /* Smooth Scrolling für Menu */
  #mobile-menu {
    -webkit-overflow-scrolling: touch;
  }
  
  /* Focus Styles */
  .mobile-nav-link:focus,
  #mobile-menu-close:focus,
  #mobile-menu-button:focus {
    outline: 2px solid #ec6a1b;
    outline-offset: 2px;
  }
  
  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    .mobile-nav-link,
    .hamburger-line {
      transition: none;
      animation: none;
    }
  }
  
  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    .mobile-nav-link {
      border: 1px solid currentColor;
    }
  }
  
  /* Safe Area für Notch-Geräte */
  @supports (padding: max(0px)) {
    #mobile-menu {
      padding-top: max(env(safe-area-inset-top), 0px);
      padding-bottom: max(env(safe-area-inset-bottom), 0px);
    }
  }
</style>

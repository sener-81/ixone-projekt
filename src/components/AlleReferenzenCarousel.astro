---
import { getImage } from "astro:assets";
import { referenzenData } from "../data/referenzenData";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/referenzen/*.{webp,jpg,jpeg,png,avif}",
);

const slides = await Promise.all(
  referenzenData.map(async (item) => {
    const path = `../assets/referenzen/${item.file}`;
    const loader = imageModules[path];
    if (!loader) {
      throw new Error(
        `[AlleReferenzenCarousel] Bild nicht gefunden: src/assets/referenzen/${item.file}`,
      );
    }
    const mod = await loader();
    const thumb = await getImage({
      src: mod.default,
      width: 480,
      format: "webp",
    });
    return { ...item, thumb };
  }),
);
---

<section
  class="py-20 md:py-28 lg:py-32 bg-gray-50 overflow-hidden"
  aria-labelledby="alle-referenzen-heading"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12 md:mb-16">
        <h2
          id="alle-referenzen-heading"
          class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
        >
          Unsere <span class="gradient-text-brand-inline">Referenzen</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Websites, Shops und Landingpages. Hier ist nicht jedes Projekt
          abgebildet und nicht jede Ansicht tagesaktuell. Gerne senden wir
          Ihnen auf Anfrage passende Referenzen aus Ihrer Branche zu.
        </p>
      </div>
    </div>
  </div>

  <div class="relative max-w-[100rem] mx-auto" data-alr-carousel>
    <ul
      class="alr-track grid grid-rows-2 lg:grid-rows-3 grid-flow-col auto-cols-[70%] sm:auto-cols-[42%] lg:auto-cols-[27%] xl:auto-cols-[23%] gap-4 md:gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth px-4 sm:px-6 lg:px-8 pb-4 cursor-grab select-none"
      data-alr-track
      aria-label="Referenzen der ixOne Digitalagentur"
    >
      {
        slides.map((slide) => (
          <li class="snap-start">
            <figure class="relative block w-full overflow-hidden rounded-xl shadow-md">
              <img
                src={slide.thumb.src}
                width={slide.thumb.attributes.width}
                height={slide.thumb.attributes.height}
                alt={slide.alt}
                loading="lazy"
                decoding="async"
                draggable="false"
                class="w-full h-auto aspect-[4/3] object-cover object-top"
              />
            </figure>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      class="hidden md:flex absolute left-4 top-1/2 -translate-y-1/2 items-center justify-center w-11 h-11 rounded-full bg-white shadow-lg text-gray-700 hover:text-brand-orange transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange"
      data-alr-prev
      aria-label="Vorherige Projekte"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    <button
      type="button"
      class="hidden md:flex absolute right-4 top-1/2 -translate-y-1/2 items-center justify-center w-11 h-11 rounded-full bg-white shadow-lg text-gray-700 hover:text-brand-orange transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange"
      data-alr-next
      aria-label="Nächste Projekte"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>
</section>

<style>
  .alr-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .alr-track::-webkit-scrollbar {
    display: none;
  }
  .alr-track.alr-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }
</style>

<script>
  function initAlleReferenzenCarousel() {
    const root = document.querySelector<HTMLElement>("[data-alr-carousel]");
    if (!root) return;

    const track = root.querySelector<HTMLElement>("[data-alr-track]");
    const prevBtn = root.querySelector<HTMLElement>("[data-alr-prev]");
    const nextBtn = root.querySelector<HTMLElement>("[data-alr-next]");
    if (!track) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const slideStep = () => {
      const first = track.querySelector<HTMLElement>("li");
      if (!first) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
      return first.offsetWidth + gap;
    };

    const atEnd = () =>
      track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;

    const goNext = () => {
      if (atEnd()) {
        track.scrollTo({ left: 0, behavior: "smooth" });
      } else {
        track.scrollBy({ left: slideStep(), behavior: "smooth" });
      }
    };
    const goPrev = () => {
      if (track.scrollLeft <= 8) {
        track.scrollTo({ left: track.scrollWidth, behavior: "smooth" });
      } else {
        track.scrollBy({ left: -slideStep(), behavior: "smooth" });
      }
    };

    nextBtn?.addEventListener("click", goNext);
    prevBtn?.addEventListener("click", goPrev);

    let timer: number | undefined;
    let paused = false;

    const start = () => {
      if (reducedMotion || timer) return;
      timer = window.setInterval(() => {
        if (!paused && !document.hidden) goNext();
      }, 3500);
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    ["mouseenter", "focusin", "touchstart", "pointerdown"].forEach((ev) =>
      track.addEventListener(ev, () => (paused = true), { passive: true }),
    );
    ["mouseleave", "focusout"].forEach((ev) =>
      track.addEventListener(ev, () => (paused = false)),
    );
    track.addEventListener(
      "touchend",
      () => {
        window.setTimeout(() => (paused = false), 5000);
      },
      { passive: true },
    );

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) start();
          else stop();
        });
      },
      { threshold: 0.25 },
    );
    io.observe(root);

    let isDown = false;
    let startX = 0;
    let startScroll = 0;

    track.addEventListener("mousedown", (e) => {
      isDown = true;
      startX = e.pageX;
      startScroll = track.scrollLeft;
      track.classList.add("alr-dragging");
    });
    window.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      track.scrollLeft = startScroll - (e.pageX - startX);
    });
    window.addEventListener("mouseup", () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove("alr-dragging");
      window.setTimeout(() => (paused = false), 4000);
    });
  }

  initAlleReferenzenCarousel();
</script>
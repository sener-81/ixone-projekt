---
import { footerLinks } from "../data/navigation";

const aktuellesJahr = new Date().getFullYear();

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const standorte = [
  {
    zusatz: "Hauptstandort",
    strasse: "Oder-Neisse-Str. 1",
    plz: "93073",
    ort: "Neutraubling",
  },
  {
    zusatz: "Zweigstelle",
    strasse: "Humboldtstr. 48",
    plz: "93053",
    ort: "Regensburg",
  },
];

const socialLinks = [
  {
    label: "Facebook",
    href: "https://www.facebook.com/ixonemarketing",
    farbe: "bg-[#1877F2]",
    icon: "M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/ixone.werbeagentur/",
    farbe: "bg-[#E1306C]",
    icon: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@ixone-onlinemarketing",
    farbe: "bg-[#FF0000]",
    icon: "M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
  },
  {
    label: "ProvenExpert",
    href: "https://www.provenexpert.com/ixone-onlinemarketing-seo-werbeagentur/",
    farbe: "bg-[#AB9044]",
    icon: "M12 2l2.955 6.377 6.545.66-4.9 4.52 1.36 6.443L12 16.77l-5.96 3.23 1.36-6.443-4.9-4.52 6.545-.66L12 2z",
  },
];
---

<footer class="bg-gray-900 text-white">
  <div
    class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 xl:px-12 2xl:px-16"
  >
    <!-- ══ Vier Spalten ══ -->
    <div
      class="py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8"
    >
      <nav aria-labelledby="footer-leistungen">
        <p
          id="footer-leistungen"
          class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-5"
        >
          Leistungen
        </p>
        <ul class="space-y-3 text-gray-300 text-sm">
          {
            footerLinks.services.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-brand-orange transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-agentur">
        <p
          id="footer-agentur"
          class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-5"
        >
          Agentur
        </p>
        <ul class="space-y-3 text-gray-300 text-sm">
          {
            footerLinks.company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-brand-orange transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p
          class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-5"
        >
          Standorte
        </p>
        <div class="space-y-5">
          {
            standorte.map((ort) => (
              <address class="not-italic text-sm">
                <span class="block text-xs text-gray-500 mb-1">
                  {ort.zusatz}
                </span>
                <span class="block text-gray-300 leading-relaxed">
                  {ort.strasse}
                  <br />
                  {ort.plz} {ort.ort}
                </span>
              </address>
            ))
          }
        </div>
        <a
          href="/standorte/"
          class="inline-block mt-5 text-sm font-medium text-brand-orange hover:underline"
        >
          Anfahrt ansehen
        </a>
      </div>

      <div>
        <p
          class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-5"
        >
          Kontakt
        </p>
        <ul class="space-y-3 text-sm mb-7">
          <li>
            <a
              href="tel:+4994015338873"
              class="text-gray-300 hover:text-brand-orange transition-colors duration-200"
            >
              +49 9401 5338873
            </a>
          </li>
          <li>
            <a
              href="mailto:info@ixone.de"
              class="text-gray-300 hover:text-brand-orange transition-colors duration-200"
            >
              info@ixone.de
            </a>
          </li>
        </ul>

        <a
          href={CALENDLY}
          target="_blank"
          rel="noopener"
          data-calendly-popup-url={CALENDLY}
          class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white text-sm font-semibold rounded-xl transition-all duration-300"
          aria-label="Kostenloses Erstgespräch vereinbaren"
        >
          <svg
            class="w-4 h-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          Termin vereinbaren
        </a>
      </div>
    </div>

    <!-- ══ Bottom Bar: Logo · Copyright & Recht · Social ══ -->
    <div
      class="border-t border-gray-800 py-8 flex flex-col md:flex-row items-center justify-between gap-6"
    >
      <a href="/" class="flex-shrink-0" aria-label="Zur Startseite">
        <img
          src="/weiss-orange.svg"
          alt="ixOne Digitalagentur Regensburg"
          width="182"
          height="102"
          loading="lazy"
          decoding="async"
          class="h-10 w-auto"
        />
      </a>

      <div
        class="flex flex-col sm:flex-row items-center gap-x-5 gap-y-2 order-last md:order-none"
      >
        <p class="text-gray-500 text-xs sm:text-sm text-center">
          © {aktuellesJahr} ixOne Digitalagentur
        </p>

        <nav aria-label="Rechtliches">
          <ul class="flex items-center gap-5">
            {
              footerLinks.legal.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-gray-500 hover:text-brand-orange text-xs sm:text-sm transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="flex gap-2.5 flex-shrink-0">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener"
              class={`w-10 h-10 rounded-lg flex items-center justify-center transition-transform duration-200 hover:-translate-y-0.5 ${social.farbe}`}
              aria-label={`ixOne auf ${social.label}`}
            >
              <svg
                class="w-[18px] h-[18px] text-white"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d={social.icon} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

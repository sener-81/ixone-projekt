---
// Google-Rezensionen – Build-Time-Fetch über die Places API (New).
// Benötigt zwei Environment-Variablen (lokal in .env, bei Cloudflare Pages unter Settings → Environment variables):
//   GOOGLE_PLACES_API_KEY  – API-Key aus der Google Cloud Console (Places API (New) aktivieren)
//   GOOGLE_PLACE_ID        – Place ID des Google-Unternehmensprofils
// Liefert die API nichts (kein Key, Fehler, keine Rezensionen), rendert die Sektion gar nicht.

interface Review {
  author: string;
  rating: number;
  text: string;
  relativeTime: string;
}

const API_KEY = import.meta.env.GOOGLE_PLACES_API_KEY;
const PLACE_ID = import.meta.env.GOOGLE_PLACE_ID;

let reviews: Review[] = [];
let ratingAvg: number | null = null;
let ratingCount: number | null = null;
let mapsUri = "https://maps.google.com/?q=ixOne+Digitalagentur+Neutraubling";

if (API_KEY && PLACE_ID) {
  try {
    const res = await fetch(
      `https://places.googleapis.com/v1/places/${PLACE_ID}?languageCode=de`,
      {
        headers: {
          "X-Goog-Api-Key": API_KEY,
          "X-Goog-FieldMask":
            "rating,userRatingCount,googleMapsUri,reviews.rating,reviews.text.text,reviews.relativePublishTimeDescription,reviews.authorAttribution.displayName",
        },
      },
    );
    if (res.ok) {
      const place = await res.json();
      ratingAvg = place.rating ?? null;
      ratingCount = place.userRatingCount ?? null;
      if (place.googleMapsUri) mapsUri = place.googleMapsUri;
      reviews = (place.reviews ?? [])
        .filter((r: any) => r?.text?.text && r?.rating >= 4)
        .map((r: any) => ({
          author: r.authorAttribution?.displayName ?? "Google-Nutzer",
          rating: r.rating,
          text: r.text.text,
          relativeTime: r.relativePublishTimeDescription ?? "",
        }));
    } else {
      console.warn("GoogleReviews: API-Antwort", res.status);
    }
  } catch (err) {
    console.warn("GoogleReviews: Fetch fehlgeschlagen", err);
  }
} else {
  console.warn(
    "GoogleReviews: GOOGLE_PLACES_API_KEY oder GOOGLE_PLACE_ID fehlt – .env im Projektstamm vorhanden und Dev-Server neu gestartet?",
  );
}
---

{
  reviews.length > 0 && (
    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="reviews-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
        <div class="text-center mb-12 md:mb-16">
          <span class="inline-flex items-center px-4 py-2 rounded-full bg-gradient-to-r from-brand-orange to-yellow-500 text-white text-sm font-semibold mb-6">
            <span class="w-2 h-2 bg-white rounded-full mr-2" />
            Google-Bewertungen
          </span>
          <h2
            id="reviews-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Das sagen unsere Kunden
          </h2>
          {ratingAvg && ratingCount && (
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
              {ratingAvg.toFixed(1).replace(".", ",")}&nbsp;★ bei {ratingCount}{" "}
              Bewertungen auf Google
            </p>
          )}
        </div>

        <div class="relative" data-reviews-carousel>
          <div
            class="flex gap-6 md:gap-8 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 reviews-track"
            data-reviews-track
            tabindex="0"
            aria-label="Kundenrezensionen – horizontal scrollbar"
          >
            {reviews.map((review) => (
              <article class="snap-start shrink-0 w-[85%] sm:w-[45%] lg:w-[31%] bg-white rounded-2xl shadow-md p-8 flex flex-col">
                <div
                  class="flex text-yellow-400 text-xl mb-4"
                  aria-label={`${review.rating} von 5 Sternen`}
                >
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.rating ? "" : "text-gray-200"}>
                      ★
                    </span>
                  ))}
                </div>
                <blockquote class="text-gray-700 italic leading-relaxed flex-1">
                  "{review.text}"
                </blockquote>
                <div class="mt-6 pt-4 border-t border-gray-200 flex items-center justify-between gap-2">
                  <div>
                    <p class="font-semibold text-gray-900">{review.author}</p>
                    <p class="text-xs text-gray-500">{review.relativeTime}</p>
                  </div>
                  <span class="text-xs text-gray-400 whitespace-nowrap">
                    Quelle: Google
                  </span>
                </div>
              </article>
            ))}
          </div>

          <button
            type="button"
            class="reviews-arrow hidden md:flex absolute -left-4 top-1/2 -translate-y-1/2 w-10 h-10 items-center justify-center rounded-full bg-white shadow-lg border border-gray-200 text-gray-700 hover:text-brand-orange transition-colors duration-200"
            data-reviews-prev
            aria-label="Vorherige Rezensionen"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19l-7-7 7-7"
              />
            </svg>
          </button>
          <button
            type="button"
            class="reviews-arrow hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 w-10 h-10 items-center justify-center rounded-full bg-white shadow-lg border border-gray-200 text-gray-700 hover:text-brand-orange transition-colors duration-200"
            data-reviews-next
            aria-label="Weitere Rezensionen"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </button>
        </div>

        <div class="text-center mt-10">
          <a
            href={mapsUri}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-brand-orange font-semibold hover:underline"
            aria-label="Alle Google-Bewertungen von ixOne ansehen"
          >
            Alle Bewertungen auf Google ansehen
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .reviews-track {
    scrollbar-width: none;
    cursor: grab;
  }
  .reviews-track.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
  }
  .reviews-track::-webkit-scrollbar {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reviews-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-reviews-carousel]").forEach((carousel) => {
    const track = carousel.querySelector("[data-reviews-track]");
    if (!(track instanceof HTMLElement)) return;

    const step = () => {
      const card = track.querySelector("article");
      return card instanceof HTMLElement ? card.offsetWidth + 24 : 320;
    };

    carousel
      .querySelector("[data-reviews-prev]")
      ?.addEventListener("click", () =>
        track.scrollBy({ left: -step(), behavior: "smooth" }),
      );
    carousel
      .querySelector("[data-reviews-next]")
      ?.addEventListener("click", () =>
        track.scrollBy({ left: step(), behavior: "smooth" }),
      );

    // Maus-Drag: greifen und schieben (Touch läuft nativ über Scroll-Snap)
    let isDown = false;
    let startX = 0;
    let startScroll = 0;

    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      isDown = true;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.classList.add("dragging");
    });

    window.addEventListener("pointermove", (e) => {
      if (!isDown) return;
      e.preventDefault();
      track.scrollLeft = startScroll - (e.clientX - startX);
    });

    window.addEventListener("pointerup", () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove("dragging");
    });
  });
</script>

---

---

<section
  class="section-padding py-16 sm:py-24 bg-gradient-to-br from-gray-900 via-gray-800 to-slate-900 relative overflow-hidden"
>
  <!-- Enhanced Animated Background Elements -->
  <div class="bg-animated-blobs">
    <div class="blob-1"></div>
    <div class="blob-2"></div>
    <div class="blob-3"></div>
  </div>

  <!-- Modernized Glassmorphism Grid Pattern with Animated Orange Background -->
  <div class="glassmorphism-grid">
    <div class="h-full w-full modern-grid-pattern"></div>
  </div>

<div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto text-center text-white">
      <!-- Kleine Überschrift für SEO -->
      <h2
        class="text-sm sm:text-base font-medium mb-3 text-gray-400 opacity-80"
      >
        Bereit für digitalen Erfolg mit der Digitalagentur Regensburg?
      </h2>

      <!-- Hauptüberschrift wird zu h3 -->
      <h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-6 leading-tight">
        Lassen Sie uns gemeinsam Ihre
        <span
          class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
          >Online-Präsenz</span
        >
        <span class="text-white"> auf das nächste Level bringen</span>
      </h3>

      <p class="hero-subtitle mb-8 opacity-90">
        <strong class="text-white"
          >Kostenlose Erstberatung und unverbindliches Angebot von Ihrer</strong
        >
        <em
          class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent"
          >Digitalagentur aus Regensburg</em
        > – für nachhaltigen digitalen Erfolg.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/kontakt"
          class="bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 hover:scale-105 relative overflow-hidden group"
          aria-label="Kostenlose Digitalagentur-Beratung aus Regensburg anfragen"
        >
          <!-- Shimmer Effect -->
          <span
            class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
          ></span>
          <span class="relative z-10">Kostenlos beraten lassen</span>
        </a>
       <a
  href="#"
  data-calendly-popup-url="https://calendly.com/senerbayram-info/30min?primary_color=ff8b00"
  class="border-2 border-white text-white hover:bg-white hover:text-gray-900
         px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300
         flex items-center justify-center gap-2"
  aria-label="Kostenlose Beratung per Termin buchen"
>
  <svg
    class="w-5 h-5"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M8 7V3m8 4V3m-9 8h10m-11 9h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v10a2 2 0 002 2z"
    />
  </svg>
  Termin buchen
</a>
      </div>

      <!-- Trust Signals with Enhanced Orange Styling -->
      <div class="mt-8 pt-8 border-t border-white/20">
        <p class="text-white/80 text-sm mb-4">
          <strong
            class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent"
            >Vertrauen Sie auf über 15 Jahre Digitalagentur-Erfahrung aus
            Regensburg</strong
          >
        </p>
        <div class="flex flex-wrap justify-center gap-6 text-white/70 text-sm">
          <span class="trust-indicator">
            <span class="trust-dot"></span>
            <span class="text-white/90">500+ erfolgreiche Projekte</span>
          </span>
          <span class="trust-indicator">
            <span class="trust-dot"></span>
            <span class="text-white/90">Kostenlose SEO-Analyse</span>
          </span>
          <span class="trust-indicator">
            <span class="trust-dot"></span>
            <span class="text-white/90">Persönlicher Ansprechpartner</span>
          </span>
          <span class="trust-indicator">
            <span class="trust-dot"></span>
            <span class="text-white/90">Faire Preise ohne Mindestlaufzeit</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

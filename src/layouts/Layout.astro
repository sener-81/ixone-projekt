---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackTop from "../components/BackTop.astro";
import Head from "../components/Head.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import "../styles/global.css";
import "../styles/fonts.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  structuredData?: object[];
  breadcrumbLabel?: string;
  breadcrumbOverlay?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  structuredData,
  breadcrumbLabel,
  breadcrumbOverlay = true,
} = Astro.props as Props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <Head
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      structuredData={structuredData}
    />
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <a href="#main-content" class="skip-to-main">Zum Hauptinhalt springen</a>

    <Header />

    <main id="main-content" class="pt-14 sm:pt-16 md:pt-18 lg:pt-20 xl:pt-22">
      <div class="relative">
        <Breadcrumbs label={breadcrumbLabel} overlay={breadcrumbOverlay} />
        <slot />
      </div>
    </main>

    <Footer />

    <BackTop />

    <script is:inline>
      (() => {
        const CALENDLY_JS =
          "https://assets.calendly.com/assets/external/widget.js";
        const CALENDLY_CSS =
          "https://assets.calendly.com/assets/external/widget.css";

        let readyPromise = null;

        function isReady() {
          return Boolean(window.Calendly && window.Calendly.initPopupWidget);
        }

        function ensureStylesheet() {
          if (document.querySelector("link[data-calendly-stylesheet]")) return;
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = CALENDLY_CSS;
          link.setAttribute("data-calendly-stylesheet", "");
          document.head.appendChild(link);
        }

        function loadCalendly() {
          ensureStylesheet();

          if (readyPromise) return readyPromise;

          readyPromise = new Promise((resolve) => {
            if (isReady()) {
              resolve();
              return;
            }

            let settled = false;
            const finish = () => {
              if (settled) return;
              settled = true;
              resolve();
            };

            let script = document.querySelector(
              'script[src^="https://assets.calendly.com/assets/external/widget.js"]',
            );

            if (!script) {
              script = document.createElement("script");
              script.src = CALENDLY_JS;
              script.async = true;
              script.setAttribute("data-calendly-script", "");
              script.addEventListener("load", finish);
              script.addEventListener("error", finish);
              document.body.appendChild(script);
            } else {
              script.addEventListener("load", finish);
              script.addEventListener("error", finish);
            }

            setTimeout(finish, 4000);
          });

          return readyPromise;
        }

        async function openCalendlyPopup(url) {
          await loadCalendly();

          if (isReady()) {
            window.Calendly.initPopupWidget({ url });
            return;
          }

          window.open(url, "_blank", "noopener");
        }

        document.addEventListener("click", (event) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          const target =
            event.target instanceof Element
              ? event.target.closest("[data-calendly-popup-url]")
              : null;
          if (!target) return;

          const url = target.getAttribute("data-calendly-popup-url");
          if (!url) return;

          event.preventDefault();
          openCalendlyPopup(url);
        });
      })();
    </script>
  </body>
</html>

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackTop from "../components/BackTop.astro";
import Head from "../components/Head.astro";
import "../styles/global.css";
import "../styles/fonts.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  structuredData?: object[];
}

const { title, description, canonical, ogImage, noindex, structuredData } =
  Astro.props as Props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <Head
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      structuredData={structuredData}
    />
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <a href="#main-content" class="skip-to-main">Zum Hauptinhalt springen</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <BackTop />

    <script is:inline>
      (() => {
        const CALENDLY_JS =
          "https://assets.calendly.com/assets/external/widget.js";
        const CALENDLY_CSS =
          "https://assets.calendly.com/assets/external/widget.css";

        let assetsRequested = false;

        function loadAssets() {
          if (assetsRequested) return;
          assetsRequested = true;

          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = CALENDLY_CSS;
          document.head.appendChild(link);

          const script = document.createElement("script");
          script.src = CALENDLY_JS;
          script.async = true;
          script.setAttribute("data-calendly-script", "");
          document.body.appendChild(script);
        }

        function whenReady() {
          return new Promise((resolve) => {
            if (window.Calendly && window.Calendly.initPopupWidget) {
              resolve();
              return;
            }
            loadAssets();
            const script = document.querySelector(
              "script[data-calendly-script]",
            );
            if (!script) {
              resolve();
              return;
            }
            script.addEventListener("load", () => resolve());
            script.addEventListener("error", () => resolve());
          });
        }

        async function openCalendlyPopup(url) {
          await whenReady();
          if (window.Calendly && window.Calendly.initPopupWidget) {
            window.Calendly.initPopupWidget({ url });
          } else {
            window.open(url, "_blank", "noopener");
          }
        }

        document.addEventListener("click", (event) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          const target =
            event.target instanceof Element
              ? event.target.closest("[data-calendly-popup-url]")
              : null;
          if (!target) return;

          const url = target.getAttribute("data-calendly-popup-url");
          if (!url) return;

          event.preventDefault();
          openCalendlyPopup(url);
        });
      })();
    </script>
  </body>
</html>

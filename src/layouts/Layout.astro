---
// src/layouts/Layout.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackTop from "../components/BackTop.astro";
import Head from "../components/Head.astro";
import "../styles/global.css";
import "../styles/fonts.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  structuredData?: object[];
}

const { title, description, canonical, ogImage, noindex, structuredData } =
  Astro.props as Props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <Head
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      structuredData={structuredData}
    />
    <link
      rel="stylesheet"
      href="https://assets.calendly.com/assets/external/widget.css"
      data-calendly-stylesheet
    />
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <!-- Skip Link für Accessibility -->
    <a href="#main-content" class="skip-to-main">Zum Hauptinhalt springen</a>

    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- BackTop Button -->
    <BackTop />

    <!-- Calendly Popup Script -->
    <script
      src="https://assets.calendly.com/assets/external/widget.js"
      type="text/javascript"
      async
      data-calendly-script></script>
    <script is:inline>
      (() => {
        const CALENDLY_SRC =
          "https://assets.calendly.com/assets/external/widget.js";

        // Ensure script is present (in case async load was blocked)
        function ensureCalendlyScript() {
          if (window.Calendly) return Promise.resolve();

          return new Promise((resolve) => {
            const existing = document.querySelector(
              "script[data-calendly-script]",
            );
            if (existing) {
              existing.addEventListener("load", () => resolve());
              existing.addEventListener("error", () => resolve());
              return;
            }

            const script = document.createElement("script");
            script.src = CALENDLY_SRC;
            script.async = true;
            script.setAttribute("data-calendly-script", "");
            script.addEventListener("load", () => resolve());
            script.addEventListener("error", () => resolve());
            document.body.appendChild(script);
          });
        }

        async function openCalendlyPopup(url) {
          await ensureCalendlyScript();
          if (window.Calendly?.initPopupWidget) {
            window.Calendly.initPopupWidget({ url });
          }
        }

        document.addEventListener("click", (event) => {
          const target =
            event.target instanceof Element
              ? event.target.closest("[data-calendly-popup-url]")
              : null;
          if (!target) return;

          event.preventDefault();
          const url = target.getAttribute("data-calendly-popup-url");
          if (!url) return;
          openCalendlyPopup(url);
        });
      })();
    </script>
  </body>
</html>

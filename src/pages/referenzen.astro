---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";
import { areaServedFull } from "../data/structuredData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

interface Referenz {
  kunde: string;
  ort: string;
  branche: string;
  brancheHref?: string;
  website?: string;
  satz: string;
  punkte: string[];
  bild: string;
  alt: string;
}

const referenzen: Referenz[] = [
  {
    kunde: "S.E.D Immobilien & Management",
    ort: "Bruck i.d.OPf.",
    branche: "Immobilien",
    brancheHref: "/branchen/#branchen-uebersicht",
    website: "https://www.sed-immobilien.de/",
    satz: "Auftritt mit Objektdarstellung und klaren Kontaktwegen.",
    punkte: ["Website neu aufgebaut", "Local SEO", "Laufende Pflege"],
    bild: "referenz-sed-immobilien-bruck.webp",
    alt: "Website von S.E.D Immobilien & Management aus Bruck in der Oberpfalz",
  },
  {
    kunde: "Gebäudereinigung",
    ort: "Regensburg",
    branche: "Reinigung",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Website für B2B-Anfragen von Hausverwaltungen und Gewerbekunden.",
    punkte: ["Referenzobjekte", "Google Business Profil", "Websitepflege"],
    bild: "referenz-gebaeudereinigung-regensburg.webp",
    alt: "Website einer Gebäudereinigung aus Regensburg, umgesetzt von ixOne",
  },
  {
    kunde: "Rohrreinigungsdienst",
    ort: "Landkreis Regensburg",
    branche: "Notdienste",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Notdienst-Website, die auf dem Handy sofort zum Anruf führt.",
    punkte: [
      "Mobile First",
      "Google Ads mit Anruferweiterung",
      "Zeitsteuerung",
    ],
    bild: "referenz-rohrreinigung-regensburg.webp",
    alt: "Website eines Rohrreinigungsdienstes aus dem Landkreis Regensburg",
  },
  {
    kunde: "Friseursalon",
    ort: "Regensburg",
    branche: "Beauty",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Auftritt mit Online-Terminbuchung und laufender Instagram-Betreuung.",
    punkte: ["Terminbuchung", "Instagram", "Visitenkarten & Preiskarten"],
    bild: "referenz-friseursalon-regensburg.webp",
    alt: "Website und Social-Media-Auftritt eines Friseursalons in Regensburg",
  },
  {
    kunde: "Photovoltaik-Anbieter",
    ort: "Ostbayern",
    branche: "Bau & Energie",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Website mit Projektreferenzen und Anfrageformular für Beratungstermine.",
    punkte: ["Projektgalerie", "Regionale SEO", "Google Ads"],
    bild: "referenz-photovoltaik-ostbayern.webp",
    alt: "Website eines Photovoltaik-Anbieters aus Ostbayern",
  },
  {
    kunde: "Kfz-Werkstatt",
    ort: "Neutraubling",
    branche: "Kfz",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Übersichtliche Website mit Leistungen, Öffnungszeiten und Anfahrt.",
    punkte: ["Website", "Google Business Profil", "Bewertungsstrategie"],
    bild: "referenz-kfz-werkstatt-neutraubling.webp",
    alt: "Website einer Kfz-Werkstatt in Neutraubling bei Regensburg",
  },
  {
    kunde: "Trockenbaubetrieb",
    ort: "Ingolstadt",
    branche: "Handwerk",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Erster professioneller Webauftritt mit echten Projektfotos.",
    punkte: ["Website", "Logo & Corporate Design", "Fahrzeugbeschriftung"],
    bild: "referenz-trockenbau-ingolstadt.webp",
    alt: "Website und Corporate Design eines Trockenbaubetriebs aus Ingolstadt",
  },
  {
    kunde: "Feinkosthandel",
    ort: "Stuttgart",
    branche: "Handel",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Website mit Sortimentsübersicht, angebunden an Google Maps.",
    punkte: ["Website", "Google Maps", "Social Media"],
    bild: "referenz-feinkost-stuttgart.webp",
    alt: "Website eines Feinkosthandels in Stuttgart",
  },
  {
    kunde: "Onlineshop für Ausrüstung",
    ort: "Berlin",
    branche: "E-Commerce",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Shopumbau mit überarbeiteter Kategoriestruktur und Produkttexten.",
    punkte: ["Shop-Relaunch", "Produkttexte", "Google Shopping"],
    bild: "referenz-onlineshop-berlin.webp",
    alt: "Onlineshop aus Berlin, umgesetzt und betreut von ixOne",
  },
  {
    kunde: "Dienstleistungsbetrieb",
    ort: "Kiel",
    branche: "Dienstleistung",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Relaunch einer veralteten Website mit Fokus auf Anfragen.",
    punkte: ["Relaunch", "Google Ads", "Betreuung per Videocall"],
    bild: "referenz-dienstleister-kiel.webp",
    alt: "Website eines Dienstleistungsbetriebs aus Kiel",
  },
  {
    kunde: "Handwerksbetrieb",
    ort: "Österreich",
    branche: "Handwerk",
    brancheHref: "/branchen/#branchen-uebersicht",
    satz: "Auftritt mit regionaler Suchmaschinenoptimierung für den österreichischen Markt.",
    punkte: ["Website", "SEO Österreich", "Ortsunabhängige Abstimmung"],
    bild: "referenz-handwerk-oesterreich.webp",
    alt: "Website eines Handwerksbetriebs aus Österreich",
  },
];

const laufband = [...referenzen, ...referenzen];

const zahlen = [
  { wert: "500+", label: "umgesetzte Projekte" },
  { wert: "seit 2007", label: "durchgehend inhabergeführt" },
  { wert: "DACH", label: "Kunden im gesamten Sprachraum" },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Referenzen der ixOne Digitalagentur Regensburg",
  numberOfItems: referenzen.length,
  itemListElement: referenzen.map((r, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: `${r.kunde}, ${r.ort}`,
    ...(r.website ? { url: r.website } : {}),
  })),
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://ixone.de/referenzen/#collection",
  name: "Referenzen ixOne Digitalagentur Regensburg",
  description:
    "Ausgewählte Kundenprojekte der ixOne Digitalagentur aus Regensburg: Webdesign, SEO, Google Ads, Social Media und Grafikdesign für Betriebe in Bayern, bundesweit und im deutschsprachigen Raum.",
  url: "https://ixone.de/referenzen/",
  about: { "@id": "https://ixone.de/#organization" },
  areaServed: areaServedFull,
};
---

<Layout
  title="Referenzen | Projekte aus Regensburg & bundesweit | ixOne"
  description="Kundenprojekte der Digitalagentur ixOne: Webdesign, SEO und Google Ads für Betriebe in Regensburg, bundesweit und im deutschsprachigen Raum."
  canonical="https://ixone.de/referenzen/"
  structuredData={[collectionSchema, itemListSchema]}
>
  <div class="bg-white">
    <section
      class="relative bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
      aria-label="Referenzen ixOne Digitalagentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-28 lg:py-32 relative z-10"
      >
        <div class="max-w-4xl mx-auto text-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
          >
            <span
              class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
              aria-hidden="true"></span>
            Über 500 Projekte seit 2007
          </span>

          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            <span class="block text-white">Projekte aus</span>
            <span class="gradient-text-brand">ganz Deutschland</span>
            <span
              class="block text-white/80 text-2xl md:text-3xl font-normal mt-2"
            >
              Referenzen unserer Kunden
            </span>
          </h1>

          <p
            class="text-lg md:text-xl text-gray-200 leading-relaxed mb-10 max-w-2xl mx-auto"
          >
            Zuhause in Regensburg, tätig weit darüber hinaus – von Ostbayern
            über Berlin und Kiel bis Österreich. Wer dahintersteckt, lesen Sie{
              " "
            }
            <a
              href="/ueber-uns/"
              class="font-semibold text-white underline decoration-brand-orange decoration-2 underline-offset-4 hover:text-brand-orange transition-colors duration-200"
              >über uns</a
            >.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto">
            {
              zahlen.map((z) => (
                <div class="rounded-2xl border border-white/20 bg-white/5 backdrop-blur-md p-5 text-center">
                  <p class="text-2xl md:text-3xl font-bold text-white mb-1">
                    {z.wert}
                  </p>
                  <p class="text-white/70 text-sm">{z.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div
        class="relative z-10 border-t border-white/10 bg-black/10 backdrop-blur-sm py-6 overflow-hidden"
        aria-hidden="true"
      >
        <div class="laufband flex gap-4 w-max">
          {
            laufband.map((r) => (
              <span class="flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 border border-white/20 text-white/80 text-sm font-medium whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-orange" />
                {r.kunde}
                <span class="text-white/40">·</span>
                <span class="text-white/50">{r.ort}</span>
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="projekte-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="projekte-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Ausgewählte Kundenprojekte
            </h2>
            <p class="text-xl text-gray-600">
              Was wir umgesetzt haben – wie wir in Ihrer Branche vorgehen, steht
              in der{" "}<a
                href="/branchen/"
                class="font-semibold text-brand-orange hover:underline"
                >Branchenübersicht</a
              >
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
              referenzen.map((r) => (
                <article class="bg-white rounded-2xl border border-gray-100 shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden flex flex-col">
                  <div class="bg-gray-100 border-b border-gray-200 px-4 py-2.5 flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-gray-300" />
                    <span class="w-2.5 h-2.5 rounded-full bg-gray-300" />
                    <span class="w-2.5 h-2.5 rounded-full bg-gray-300" />
                  </div>

                  <div
                    class="relative aspect-[16/10] bg-gradient-to-br from-gray-50 to-white flex items-center justify-center"
                    data-bild={r.bild}
                    data-alt={r.alt}
                  >
                    <svg
                      class="w-12 h-12 text-gray-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                  </div>

                  <div class="p-6 md:p-7 flex flex-col flex-grow">
                    <div class="flex items-start justify-between gap-3 mb-1">
                      <h3 class="text-lg font-bold text-gray-900 leading-snug">
                        {r.kunde}
                      </h3>
                      {r.brancheHref && (
                        <a
                          href={r.brancheHref}
                          class="shrink-0 mt-0.5 px-2.5 py-1 rounded-full bg-brand-orange/10 border border-brand-orange/20 text-brand-orange text-xs font-semibold hover:bg-brand-orange/20 transition-colors duration-200"
                        >
                          {r.branche}
                        </a>
                      )}
                    </div>

                    <p class="flex items-center gap-1.5 text-sm text-gray-500 mb-4">
                      <svg
                        class="w-4 h-4 flex-shrink-0"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                        />
                      </svg>
                      {r.ort}
                    </p>

                    <p class="text-gray-600 leading-relaxed mb-4">{r.satz}</p>

                    <ul class="space-y-1.5 mb-6 flex-grow">
                      {r.punkte.map((punkt) => (
                        <li class="flex items-start gap-2 text-sm text-gray-700">
                          <svg
                            class="w-4 h-4 flex-shrink-0 mt-0.5 text-brand-orange"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M9 12.75L11.25 15 15 9.75"
                            />
                          </svg>
                          {punkt}
                        </li>
                      ))}
                    </ul>

                    {r.website && (
                      <a
                        href={r.website}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-1.5 font-semibold text-brand-orange hover:underline text-sm"
                      >
                        Website ansehen
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                          />
                        </svg>
                      </a>
                    )}
                  </div>
                </article>
              ))
            }
          </div>

          <div class="mt-16 max-w-3xl mx-auto text-center">
            <p class="text-gray-500 text-sm leading-relaxed mb-8">
              Einige Kunden möchten nicht namentlich genannt werden. Auf Anfrage
              zeigen wir Ihnen im Gespräch gerne konkrete Projekte aus Ihrer
              Branche. Überregionale Zusammenarbeit läuft seit Jahren
              reibungslos per Videocall – der Ansprechpartner bleibt derselbe.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a
                href={CALENDLY}
                target="_blank"
                rel="noopener"
                data-calendly-popup-url={CALENDLY}
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-brand-orange text-white font-semibold rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl"
                aria-label="Termin per Videocall oder vor Ort vereinbaren"
              >
                <svg
                  class="w-5 h-5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                  ></path>
                </svg>
                Termin per Videocall
              </a>

              <a
                href="/kontakt/"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border-2 border-gray-200 text-gray-700 font-semibold rounded-full hover:border-brand-orange hover:text-brand-orange transition-all duration-300"
                aria-label="Termin vor Ort in Regensburg oder Neutraubling vereinbaren"
              >
                <svg
                  class="w-5 h-5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                  ></path>
                </svg>
                Termin vor Ort
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ServiceCrosslinks
      headline="Was wir für diese Kunden umsetzen"
      intro="Die Bausteine, aus denen die gezeigten Projekte bestehen."
    />

    <section
      class="py-20 md:py-28 lg:py-32 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white"
      aria-labelledby="cta-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-3xl mx-auto text-center">
          <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold mb-6">
            Wird Ihr Projekt das nächste?
          </h2>
          <p class="text-xl text-gray-300 leading-relaxed mb-10">
            Erzählen Sie uns, wo Sie stehen und was Sie erreichen wollen. Im
            kostenlosen Erstgespräch zeigen wir Ihnen, wie wir vergleichbare
            Aufgaben gelöst haben.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={CALENDLY}
              target="_blank"
              rel="noopener"
              data-calendly-popup-url={CALENDLY}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-brand-orange text-white font-semibold rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl"
              aria-label="Kostenlosen Beratungstermin vereinbaren"
            >
              Termin vereinbaren
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
            <a
              href="mailto:info@ixone.de"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-semibold rounded-full hover:bg-white/10 transition-all duration-300"
              aria-label="E-Mail an ixOne Digitalagentur Regensburg schreiben"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              info@ixone.de
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .laufband {
    animation: laufband-scroll 45s linear infinite;
  }

  .laufband:hover {
    animation-play-state: paused;
  }

  @keyframes laufband-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .laufband {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";
import { areaServedFull } from "../data/structuredData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const PROVENEXPERT =
  "https://www.provenexpert.com/ixone-onlinemarketing-seo-werbeagentur/";

interface Referenz {
  kunde: string;
  branche: string;
  leistungen: string[];
  text: string;
  bild: string;
  alt: string;
  href?: string;
}

const referenzen: Referenz[] = [
  {
    kunde: "Gebäudereinigung aus Regensburg",
    branche: "Reinigung & Gebäudeservice",
    leistungen: ["Webdesign", "Local SEO", "Websitepflege"],
    text: "Neue Website mit Referenzobjekten und klaren Leistungspaketen für Hausverwaltungen. Dazu laufende Pflege und Optimierung des Google Business Profils.",
    bild: "referenz-gebaeudereinigung-regensburg.webp",
    alt: "Website einer Gebäudereinigung aus Regensburg, umgesetzt von ixOne",
  },
  {
    kunde: "Rohrreinigungsdienst aus dem Landkreis",
    branche: "Notdienste",
    leistungen: ["Webdesign", "Google Ads"],
    text: "Mobil optimierte Website mit sofort sichtbarer Notrufnummer. Google Ads mit Anruferweiterung und Zeitsteuerung für Abende und Wochenenden.",
    bild: "referenz-rohrreinigung-regensburg.webp",
    alt: "Website eines Rohrreinigungsdienstes aus dem Landkreis Regensburg",
  },
  {
    kunde: "Friseursalon in Regensburg",
    branche: "Beauty & Wellness",
    leistungen: ["Webdesign", "Social Media", "Grafikdesign"],
    text: "Auftritt mit Online-Terminbuchung und Instagram-Betreuung. Dazu Visitenkarten und Preiskarten im einheitlichen Erscheinungsbild.",
    bild: "referenz-friseursalon-regensburg.webp",
    alt: "Website und Social-Media-Auftritt eines Friseursalons in Regensburg",
  },
  {
    kunde: "Photovoltaik-Anbieter aus Ostbayern",
    branche: "Bau & Energie",
    leistungen: ["Webdesign", "SEO", "Google Ads"],
    text: "Website mit Projektreferenzen und Anfrageformular für Beratungstermine. Suchmaschinenoptimierung auf regionale Anfragen rund um Photovoltaik.",
    bild: "referenz-photovoltaik-regensburg.webp",
    alt: "Website eines Photovoltaik-Anbieters aus Ostbayern",
  },
  {
    kunde: "Kfz-Werkstatt bei Regensburg",
    branche: "Kfz & Fahrzeugservice",
    leistungen: ["Webdesign", "Local SEO"],
    text: "Übersichtliche Website mit Leistungen, Öffnungszeiten und Anfahrt. Optimiertes Google Business Profil mit aktuellen Fotos und Bewertungsstrategie.",
    bild: "referenz-kfz-werkstatt-regensburg.webp",
    alt: "Website einer Kfz-Werkstatt bei Regensburg",
  },
  {
    kunde: "Trockenbaubetrieb aus dem Landkreis",
    branche: "Handwerk & Bau",
    leistungen: ["Webdesign", "Grafikdesign"],
    text: "Erster professioneller Webauftritt mit echten Projektfotos statt Stockbildern. Dazu Logo, Visitenkarten und Fahrzeugbeschriftung.",
    bild: "referenz-trockenbau-regensburg.webp",
    alt: "Website und Corporate Design eines Trockenbaubetriebs aus dem Landkreis Regensburg",
  },
  {
    kunde: "Feinkosthandel in Regensburg",
    branche: "Handel & Gastronomie",
    leistungen: ["Webdesign", "Social Media"],
    text: "Website mit Sortimentsübersicht und Öffnungszeiten, angebunden an Google Maps. Regelmäßige Beiträge zu saisonalen Angeboten.",
    bild: "referenz-feinkost-regensburg.webp",
    alt: "Website eines Feinkosthandels in Regensburg",
  },
  {
    kunde: "Immobilienmakler aus Regensburg",
    branche: "Immobilien",
    leistungen: ["Webdesign", "SEO", "Websitepflege"],
    text: "Hochwertiger Auftritt mit Objektdarstellung und klaren Kontaktwegen. Laufende Pflege, damit neue Objekte schnell online sind.",
    bild: "referenz-immobilienmakler-regensburg.webp",
    alt: "Website eines Immobilienmaklers aus Regensburg",
  },
];

const zahlen = [
  { wert: "500+", label: "umgesetzte Projekte" },
  { wert: "166", label: "Bewertungen auf ProvenExpert" },
  { wert: "seit 2007", label: "durchgehend inhabergeführt" },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Referenzen der ixOne Digitalagentur Regensburg",
  numberOfItems: referenzen.length,
  itemListElement: referenzen.map((r, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: `${r.branche} – ${r.leistungen.join(", ")}`,
    ...(r.href ? { url: `https://ixone.de${r.href}` } : {}),
  })),
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://ixone.de/referenzen/#collection",
  name: "Referenzen ixOne Digitalagentur Regensburg",
  description:
    "Ausgewählte Kundenprojekte der ixOne Digitalagentur aus Regensburg: Webdesign, SEO, Google Ads, Social Media und Grafikdesign für Betriebe aus der Region.",
  url: "https://ixone.de/referenzen/",
  about: { "@id": "https://ixone.de/#organization" },
  areaServed: areaServedFull,
};
---

<Layout
  title="Referenzen | Kundenprojekte aus Regensburg | ixOne"
  description="Ausgewählte Kundenprojekte der Digitalagentur ixOne aus Regensburg: Webdesign, SEO, Google Ads und Grafikdesign für Handwerk, Notdienste, Handel und mehr."
  canonical="https://ixone.de/referenzen/"
  structuredData={[collectionSchema, itemListSchema]}
>
  <div class="bg-white">
    <section
      class="relative bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
      aria-label="Referenzen ixOne Digitalagentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/4 w-72 h-72 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div
          class="h-full w-full"
          style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div class="max-w-4xl mx-auto text-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
          >
            <span
              class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
              aria-hidden="true"></span>
            Über 500 Projekte seit 2007
          </span>

          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            <span class="block text-white">Projekte aus</span>
            <span class="gradient-text-brand">Regensburg</span>
            <span
              class="block text-white/80 text-2xl md:text-3xl font-normal mt-2"
            >
              Referenzen und Kundenstimmen
            </span>
          </h1>

          <p
            class="text-lg md:text-xl text-gray-200 leading-relaxed mb-10 max-w-2xl mx-auto"
          >
            Ein Auszug aus unserer Arbeit: Betriebe aus Handwerk, Notdiensten,
            Handel und Dienstleistung, die wir beim Auftritt und beim Marketing
            begleiten.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto">
            {
              zahlen.map((z) => (
                <div class="rounded-2xl border border-white/20 bg-white/5 backdrop-blur-md p-5 text-center">
                  <p class="text-2xl md:text-3xl font-bold text-white mb-1">
                    {z.wert}
                  </p>
                  <p class="text-white/70 text-sm">{z.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="projekte-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="projekte-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Ausgewählte Kundenprojekte
            </h2>
            <p class="text-xl text-gray-600">
              Aus Regensburg, dem Landkreis und der weiteren Region
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
              referenzen.map((r) => (
                <article class="bg-white rounded-2xl border border-gray-100 shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden flex flex-col">
                  <div
                    class="relative aspect-[16/10] bg-gradient-to-br from-gray-100 to-gray-50 border-b border-gray-100 flex items-center justify-center"
                    data-bild={r.bild}
                    data-alt={r.alt}
                  >
                    <svg
                      class="w-14 h-14 text-gray-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1"
                        d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                      />
                    </svg>
                  </div>

                  <div class="p-8 flex flex-col flex-grow">
                    <span class="text-xs font-semibold text-brand-orange uppercase tracking-wider mb-2">
                      {r.branche}
                    </span>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">
                      {r.kunde}
                    </h3>
                    <p class="text-gray-600 leading-relaxed mb-6 flex-grow">
                      {r.text}
                    </p>

                    <ul class="flex flex-wrap gap-2 mb-6">
                      {r.leistungen.map((l) => (
                        <li class="px-3 py-1 rounded-full bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium">
                          {l}
                        </li>
                      ))}
                    </ul>

                    {r.href && (
                      <a
                        href={r.href}
                        class="inline-flex items-center gap-1 font-semibold text-brand-orange hover:underline"
                      >
                        Projekt ansehen
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"
                          />
                        </svg>
                      </a>
                    )}
                  </div>
                </article>
              ))
            }
          </div>

          <p
            class="text-center text-gray-500 text-sm mt-12 max-w-2xl mx-auto leading-relaxed"
          >
            Einige Kunden möchten nicht namentlich genannt werden. Auf Anfrage
            zeigen wir Ihnen im Gespräch gerne konkrete Projekte aus Ihrer
            Branche.
          </p>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="bewertungen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-4xl mx-auto text-center">
          <h2
            id="bewertungen-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
          >
            Was Kunden über uns sagen
          </h2>
          <p class="text-xl text-gray-600 leading-relaxed mb-10">
            Statt selbst ausgewählter Zitate zeigen wir lieber, was unabhängig
            erfasst wird. Alle Bewertungen sind auf ProvenExpert einsehbar –
            ungefiltert und für jeden nachprüfbar.
          </p>

          <a
            href={PROVENEXPERT}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-white border-2 border-gray-200 text-gray-700 font-semibold hover:border-brand-orange hover:text-brand-orange transition-all duration-300"
          >
            <span class="flex text-yellow-400" aria-hidden="true">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.363 1.118l1.286 3.958c.3.922-.755 1.688-1.539 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.367 2.446c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.063 9.385c-.783-.57-.38-1.81.588-1.81h4.161a1 1 0 00.951-.69l1.286-3.958z"
                ></path>
              </svg>
            </span>
            166 Bewertungen ansehen
          </a>
        </div>
      </div>
    </section>

    <ServiceCrosslinks
      headline="Was wir für diese Kunden umsetzen"
      intro="Die Bausteine, aus denen die gezeigten Projekte bestehen."
    />

    <section
      class="py-20 md:py-28 lg:py-32 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white"
      aria-labelledby="cta-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-3xl mx-auto text-center">
          <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold mb-6">
            Wird Ihr Projekt das nächste?
          </h2>
          <p class="text-xl text-gray-300 leading-relaxed mb-10">
            Erzählen Sie uns, wo Sie stehen und was Sie erreichen wollen. Im
            kostenlosen Erstgespräch zeigen wir Ihnen, wie wir vergleichbare
            Aufgaben gelöst haben.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={CALENDLY}
              target="_blank"
              rel="noopener"
              data-calendly-popup-url={CALENDLY}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-brand-orange text-white font-semibold rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl"
              aria-label="Kostenlosen Beratungstermin vereinbaren"
            >
              Termin vereinbaren
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
            <a
              href="mailto:info@ixone.de"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-semibold rounded-full hover:bg-white/10 transition-all duration-300"
              aria-label="E-Mail an ixOne Digitalagentur Regensburg schreiben"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              info@ixone.de
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

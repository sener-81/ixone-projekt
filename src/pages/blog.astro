---
import Layout from "../layouts/Layout.astro";

import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "Blog", url: "https://ixone.de/blog" },
]);

// Blog-spezifische Structured Data
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "iXone Digitalagentur Blog",
  description:
    "Aktuelle Tipps und Insights zu Webdesign, SEO und Online-Marketing von der iXone Digitalagentur Regensburg",
  url: "https://ixone.de/blog",
  publisher: {
    "@type": "Organization",
    name: "iXone Digitalagentur",
    logo: {
      "@type": "ImageObject",
      url: "https://ixone.de/logo.png",
    },
  },
  blogPost: [
    {
      "@type": "BlogPosting",
      headline:
        "SEO Trends 2025: Was Sie jetzt wissen müssen für bessere Google Rankings",
      url: "https://ixone.de/blog/seo-trends-2025",
      datePublished: "2025-01-15T09:00:00+01:00",
      author: {
        "@type": "Organization",
        name: "iXone Digitalagentur",
      },
    },
  ],
};
---

<Layout
  title="Blog - iXone Digitalagentur | Tipps zu Webdesign, SEO & Online-Marketing"
  description="Aktuelle Tipps und Insights zu Webdesign, SEO und Online-Marketing. Bleiben Sie auf dem Laufenden mit unserem Blog der iXone Digitalagentur Regensburg."
  structuredData={[breadcrumbs, blogSchema]}
>
  <div class="pt-16 md:pt-20 bg-white">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-br from-gray-900 to-gray-800 text-white py-20 md:py-32"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-6xl font-bold mb-6">
            Digital <span
              class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
              >Insights</span
            >
          </h1>
          <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
            <strong>Aktuelle Tipps, Trends und Insights</strong> zu Webdesign, SEO
            und Online-Marketing. Bleiben Sie auf dem Laufenden mit unserem <em
              >Expertenwissen aus Regensburg</em
            >.
          </p>

          <!-- Blog Stats -->
          <div class="flex flex-wrap justify-center gap-8 mt-12 text-white/80">
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-orange">50+</div>
              <p class="text-sm">Artikel</p>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-orange">15+</div>
              <p class="text-sm">Jahre Erfahrung</p>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-brand-orange">1000+</div>
              <p class="text-sm">Leser monatlich</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Article -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto">

              <!-- Content Section -->
              <div class="p-8 lg:p-12 flex flex-col justify-center">
                <div class="flex items-center text-sm text-gray-500 mb-4">
                  <time datetime="2025-01-15">15. Januar 2025</time>
                  <span class="mx-2">•</span>
                  <span
                    class="bg-gradient-to-r from-brand-orange to-yellow-500 text-white px-3 py-1 rounded-full text-xs font-medium"
                  >
                    🔥 Trending
                  </span>
                  <span class="mx-2">•</span>
                  <span>8 Min. Lesezeit</span>
                </div>

                <h2
                  class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4 hover:text-brand-orange transition-colors duration-200"

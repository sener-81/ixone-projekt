---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/webdesigner-aus-regensburg.webp";
import performanceImage from "../assets/ixone-online-marketing-regensburg.webp";
import { areaServedFull } from "../data/structuredData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://ixone.de/online-marketing-regensburg/#service",
  name: "Online Marketing Agentur Regensburg",
  description:
    "Online Marketing Agentur aus Regensburg. Google Ads, SEA, Social Media Ads, Content Marketing, E-Mail Marketing und Conversion-Optimierung für messbare Erfolge und maximalen ROI.",
  provider: { "@id": "https://ixone.de/#organization" },
  areaServed: areaServedFull,
  serviceType: "Online Marketing",
  url: "https://ixone.de/online-marketing-regensburg/",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was umfasst Online Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Online Marketing umfasst alle digitalen Maßnahmen, die Ihre Sichtbarkeit erhöhen und neue Kunden erreichen: Suchmaschinenoptimierung (SEO), Google Ads (SEA), Social Media Marketing, Content Marketing und E-Mail Marketing. Wir entwickeln eine ganzheitliche Strategie, die alle relevanten Kanäle berücksichtigt – für maximale Reichweite und planbare Leadgenerierung.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet Online Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die Kosten sind individuell und hängen von Umfang und Zielen Ihres Projekts ab. Wir erstellen ein maßgeschneidertes Angebot, das genau zu Ihren Anforderungen passt. In einer kostenlosen Erstberatung besprechen wir Ihre Ziele und nennen Ihnen einen transparenten Preis auf Anfrage – ohne versteckte Kosten.",
      },
    },
    {
      "@type": "Question",
      name: "Wie schnell zeigt Online Marketing Erfolge?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Das hängt von der Strategie ab. Google Ads (SEA) liefert oft schon nach wenigen Tagen erste Ergebnisse, während Suchmaschinenoptimierung (SEO) mehr Zeit braucht, dafür aber nachhaltig wirkt. Wir kombinieren kurzfristige und langfristige Maßnahmen, damit Sie schnelle Gewinne und dauerhaften Erfolg erzielen.",
      },
    },
    {
      "@type": "Question",
      name: "Was ist der Unterschied zwischen SEO und SEA / Google Ads?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SEO (Suchmaschinenoptimierung) verbessert die organische Sichtbarkeit in den Suchergebnissen – ohne pro Klick zu zahlen, dafür mit längerem Vorlauf. SEA (Suchmaschinenwerbung über Google Ads) schaltet bezahlte Anzeigen für sofortige Präsenz. Wir beraten Sie, welche Kombination für Ihre Ziele am effektivsten ist.",
      },
    },
    {
      "@type": "Question",
      name: "Wie verbessert man den Google Ads Qualitätsfaktor?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der Qualitätsfaktor steigt durch hohe Anzeigenrelevanz, eine gute erwartete Klickrate (CTR) und eine hervorragende Landingpage-Erfahrung. Wir optimieren Keywords, Anzeigentexte und Landingpages kontinuierlich. Das führt zu besseren Anzeigenpositionen, senkt die Klickpreise und nutzt Ihr Werbebudget optimal – was Ihren ROAS spürbar verbessert.",
      },
    },
    {
      "@type": "Question",
      name: "Lohnt sich Online Marketing für kleine Unternehmen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja. Online Marketing bietet kleinen und mittelständischen Unternehmen kosteneffiziente Wege, neue Kunden zu erreichen und sich gegen größere Wettbewerber durchzusetzen. Als lokale Agentur kennen wir die Herausforderungen von KMU und entwickeln datengetriebene Strategien, die auch mit kleinerem Budget messbare Erfolge erzielen.",
      },
    },
    {
      "@type": "Question",
      name: "Wie wird der Erfolg im Online Marketing gemessen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Über präzises Tracking und transparentes Reporting, zum Beispiel mit Google Analytics. Wir überwachen Kennzahlen wie Traffic, Conversion-Rate, Cost-per-Lead, ROI und ROAS. Diese Daten ermöglichen es uns, Ihre Strategie laufend zu optimieren und Ihnen nachvollziehbare Ergebnisse zu präsentieren.",
      },
    },
    {
      "@type": "Question",
      name: "Warum eine lokale Online Marketing Agentur aus Regensburg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Eine lokale Agentur wie ixOne bietet Ihnen einen persönlichen Ansprechpartner und ein tiefes Verständnis für den regionalen Markt. Wir kennen die Besonderheiten von Regensburg und Umgebung und stimmen Ihre Strategie präzise auf Ihre Zielgruppe ab. Die räumliche Nähe ermöglicht enge Zusammenarbeit, schnelle Reaktionszeiten und maßgeschneiderte Lösungen.",
      },
    },
  ],
};

const services = [
  {
    title: "Google Ads / SEA",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    desc: "Professionelle Google Ads Kampagnen für sofortige Sichtbarkeit – Search, Shopping, Display und YouTube Ads, optimiert auf niedrige Klickpreise und maximalen ROI.",
    items: ["Search & Shopping Ads", "Display & YouTube Ads", "Remarketing"],
  },
  {
    title: "Social Media Ads",
    icon: "M7 20l4-16m2 16l4-16M6 9h14M4 15h14",
    desc: "Zielgerichtete Kampagnen auf Facebook, Instagram, LinkedIn und TikTok. Präzises Targeting für maximale Reichweite und Engagement Ihrer Zielgruppe in Regensburg und Umgebung.",
    items: ["Facebook & Instagram Ads", "LinkedIn Ads", "TikTok Ads"],
  },
  {
    title: "Content Marketing",
    icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
    desc: "Hochwertige Inhalte, die Ihre Zielgruppe ansprechen, informieren und zur Conversion anregen – Blogartikel, Landingpages und Videos, die Ihre Expertise zeigen und Kunden binden.",
    items: ["Content-Strategie", "Blog & SEO-Texte", "Video-Content"],
  },
  {
    title: "E-Mail Marketing",
    icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    desc: "Personalisierte E-Mail-Kampagnen für nachhaltige Kundenbindung. Newsletter, Marketing Automation und segmentierte Customer Journeys, die Ihren Umsatz steigern.",
    items: ["Newsletter", "Marketing Automation", "Segmentierung"],
  },
  {
    title: "Conversion-Optimierung",
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    desc: "Mehr aus Ihrem bestehenden Traffic herausholen: durch A/B-Testing, Funnel-Optimierung und bessere Landingpages verwandeln wir Besucher effektiver in Kunden.",
    items: ["A/B-Testing", "Funnel-Optimierung", "Landingpages"],
  },
  {
    title: "Analytics & Reporting",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    desc: "Transparente Insights statt Bauchgefühl: Mit Google Analytics, Tag Manager und individuellen Dashboards verfolgen wir die Performance und treffen datengetriebene Entscheidungen.",
    items: ["Google Analytics 4", "Individuelle Dashboards", "KPI-Tracking"],
  },
];

const qualityFactors = [
  {
    label: "Faktor 1",
    title: "Anzeigenrelevanz",
    desc: "Je besser Ihre Anzeigeninhalte zur Suchanfrage passen, desto höher der Qualitätsfaktor – und desto niedriger die Kosten pro Klick. Wir stimmen Keywords und Anzeigentexte präzise aufeinander ab.",
    webdesignLink: false,
  },
  {
    label: "Faktor 2",
    title: "Erwartete CTR",
    desc: "Eine hohe erwartete Klickrate signalisiert Google, dass Ihre Anzeige relevant ist. Durch durchdachte Anzeigentexte und passendes Targeting steigern wir die CTR nachhaltig.",
    webdesignLink: false,
  },
  {
    label: "Faktor 3",
    title: "Landingpage-Erfahrung",
    desc: "Eine schnelle, relevante Landingpage erhöht den Qualitätsfaktor und steigert gleichzeitig die Conversion-Rate.",
    webdesignLink: true,
  },
];
---

<Layout
  title="Online Marketing Agentur Regensburg | Google Ads | ixOne"
  description="Online Marketing Agentur aus Regensburg: Google Ads, Social Ads und Conversion-Optimierung für messbare Ergebnisse und mehr qualifizierte Anfragen."
  canonical="https://ixone.de/online-marketing-regensburg/"
  structuredData={[serviceSchema, faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-gray-900 text-white"
      aria-label="Online Marketing Agentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute -top-24 -left-24 w-96 h-96 bg-brand-orange rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -right-24 w-96 h-96 bg-amber-500 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div
          class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"
        >
          <div class="text-center lg:text-left">
            <span
              class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
            >
              <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"
              ></span>
              Digitalagentur aus Regensburg · seit 2007
            </span>

            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
            >
              <span class="block">Online Marketing</span>
              <span class="block gradient-text-brand">Agentur Regensburg</span>
            </h1>

            <p
              class="text-lg md:text-xl text-gray-200 leading-relaxed mb-10 max-w-xl mx-auto lg:mx-0"
            >
              Ganzheitliches Online Marketing aus Regensburg –
              <strong class="text-white">Google Ads</strong>,{" "}
              <strong class="text-white">Performance Marketing</strong> und{" "}
              <strong class="text-white">Conversion-Optimierung</strong> für messbare
              Erfolge und nachhaltiges Wachstum.
            </p>

            <div
              class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
            >
              <a
                href={CALENDLY}
                target="_blank"
                rel="noopener"
                class="cta-button-primary text-center"
                aria-label="Kostenlose Erstberatung Online Marketing"
                data-calendly-popup-url={CALENDLY}
              >
                Kostenlose Erstberatung
              </a>
              <a
                href="#marketing-services"
                class="px-8 py-4 rounded-2xl font-semibold text-white border border-white/30 bg-white/5 backdrop-blur-md hover:bg-white/15 transition-all duration-300 text-center"
              >
                Leistungen entdecken
              </a>
            </div>
          </div>

          <div class="relative">
            <Image
              src={heroImage}
              alt="Online Marketing Agentur Regensburg – ixOne Team bei der Kampagnenplanung"
              class="w-full h-auto rounded-3xl shadow-2xl"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              width="1200"
              height="900"
            />
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="intro-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <h2
            id="intro-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-8"
          >
            Online Marketing als
            <span class="gradient-text-brand">Wachstumshebel</span> für Unternehmen
            aus Regensburg
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            In der digitalen Welt entscheidet eine starke Online-Präsenz
            darüber, ob Sie im Wettbewerb sichtbar sind und neue Kunden
            gewinnen. Als erfahrene Online Marketing Agentur aus Regensburg
            helfen wir Unternehmen aus der Region, ihr volles Potenzial
            auszuschöpfen – mit einer durchdachten Strategie statt
            Einzelmaßnahmen.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Digitale Kanäle eröffnen Wachstumschancen, die über klassisches
            Marketing hinausgehen: Sie sprechen Ihre Zielgruppe präzise an,
            gewinnen Neukunden, stärken die Kundenbindung und steigern Ihren
            Umsatz nachhaltig. Eng verzahnt mit unserem{" "}
            <a
              href="/seo-regensburg/"
              class="text-brand-orange font-semibold hover:underline">SEO</a
            > und{" "}
            <a
              href="/webdesign-regensburg/"
              class="text-brand-orange font-semibold hover:underline"
              >Webdesign</a
            > greifen alle Maßnahmen sauber ineinander.
          </p>
        </div>
      </div>
    </section>

    <section
      id="marketing-services"
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="services-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <h2
            id="services-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Unsere <span class="gradient-text-brand"
              >Online Marketing Leistungen</span
            >
          </h2>
          <p class="text-xl text-gray-600">
            Ganzheitliche Digital-Marketing-Strategien, exakt auf Ihre
            Unternehmensziele zugeschnitten.
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto"
        >
          {
            services.map((service) => (
              <article class="bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 p-8 border border-gray-100">
                <div class="w-12 h-12 rounded-xl border border-brand-orange/30 flex items-center justify-center mb-6">
                  <svg
                    class="w-6 h-6 text-brand-orange"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={service.icon}
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  {service.title}
                </h3>
                <p class="text-gray-600 leading-relaxed mb-4">{service.desc}</p>
                <ul class="text-gray-600 text-sm space-y-2">
                  {service.items.map((item) => (
                    <li class="flex items-center gap-2">
                      <span class="w-1.5 h-1.5 bg-brand-orange rounded-full" />
                      {item}
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="qualitaetsfaktor-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16 md:mb-20">
          <h2
            id="qualitaetsfaktor-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
          >
            Google Ads &amp;
            <span class="gradient-text-brand">Qualitätsfaktor</span>
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            Erfolgreiche Suchmaschinenwerbung hängt entscheidend vom
            Qualitätsfaktor ab. Wir optimieren Ihre Google Ads nicht nur auf
            Sichtbarkeit, sondern gezielt darauf, Ihre Klickpreise zu senken und
            Ihr Werbebudget effizient einzusetzen.
          </p>
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto mb-12"
        >
          {
            qualityFactors.map((factor) => (
              <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
                <div class="text-brand-orange font-bold text-sm mb-3 tracking-wide uppercase">
                  {factor.label}
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  {factor.title}
                </h3>
                <p class="text-gray-600 leading-relaxed">
                  {factor.desc}
                  {factor.webdesignLink && (
                    <>
                      {" "}
                      Hier zahlt sich unser{" "}
                      <a
                        href="/webdesign-regensburg/"
                        class="text-brand-orange font-semibold hover:underline"
                      >
                        Webdesign
                      </a>{" "}
                      direkt aus.
                    </>
                  )}
                </p>
              </div>
            ))
          }
        </div>

        <div
          class="max-w-4xl mx-auto bg-gradient-to-br from-orange-50 to-amber-50 rounded-2xl p-8 md:p-10 border border-orange-100"
        >
          <h3 class="text-xl font-bold text-gray-900 mb-3">
            Das Ergebnis: niedrigere Klickpreise, besserer ROAS
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Wir optimieren Keywords, Anzeigentexte und Landingpages
            kontinuierlich und werten die Daten über Google Analytics aus. So
            verbessern wir den Qualitätsfaktor systematisch – Ihre Anzeigen
            erscheinen auf besseren Positionen, kosten weniger pro Klick und
            liefern mehr qualifizierte Leads. Ergänzend dazu stärkt{" "}
            <a
              href="/seo-regensburg/"
              class="text-brand-orange font-semibold hover:underline"
              >organisches SEO</a
            > Ihre Sichtbarkeit langfristig und unabhängig vom Werbebudget.
          </p>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="termin-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="relative max-w-5xl mx-auto rounded-3xl overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-gray-900 text-white"
        >
          <div class="absolute inset-0 opacity-20" aria-hidden="true">
            <div
              class="absolute -top-20 -right-20 w-72 h-72 bg-brand-orange rounded-full blur-3xl"
            >
            </div>
            <div
              class="absolute -bottom-20 -left-20 w-72 h-72 bg-amber-500 rounded-full blur-3xl"
            >
            </div>
          </div>

          <div class="relative z-10 p-8 md:p-12 lg:p-16 text-center">
            <span
              class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
            >
              <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"
              ></span>
              Kostenlos &amp; unverbindlich
            </span>

            <h2 id="termin-heading" class="text-3xl md:text-4xl font-bold mb-4">
              Online Termin jetzt buchen
            </h2>
            <p
              class="text-lg text-gray-200 leading-relaxed mb-10 max-w-2xl mx-auto"
            >
              Lassen Sie uns über Ihre Ziele sprechen – ganz wie es Ihnen passt:
              persönlich bei uns vor Ort in Regensburg oder Neutraubling, oder
              bequem per Videokonferenz. Sie wählen den Termin, wir bringen die
              Ideen mit.
            </p>

            <div class="flex justify-center">
              <a
                href={CALENDLY}
                target="_blank"
                rel="noopener"
                class="group inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl bg-white text-gray-900 font-bold text-lg hover:bg-gray-100 transition-all duration-300 transform hover:-translate-y-1 shadow-lg"
                aria-label="Jetzt Termin vereinbaren – vor Ort oder per Videokonferenz"
                data-calendly-popup-url={CALENDLY}
              >
                <svg
                  class="w-6 h-6 text-brand-orange flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
                Jetzt Termin vereinbaren
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="performance-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-6xl mx-auto"
        >
          <div
            class="relative rounded-2xl overflow-hidden aspect-[4/3] border border-gray-200"
          >
            <Image
              src={performanceImage}
              alt="Conversion-Optimierung und Performance Marketing – ixOne Regensburg"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
              width="1200"
              height="900"
            />
          </div>

          <div>
            <h2
              id="performance-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
            >
              Mehr aus jedem Besucher:
              <span class="gradient-text-brand">Performance Marketing</span>
            </h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-8">
              Wir analysieren Ihre Daten genau und verwandeln jeden Besucher
              möglichst effizient in einen Kunden – datengetrieben, messbar und
              transparent.
            </p>
            <ul class="space-y-5">
              <li class="flex gap-3">
                <span
                  class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-orange/10 flex items-center justify-center mt-0.5"
                >
                  <span class="w-2 h-2 rounded-full bg-brand-orange"></span>
                </span>
                <span class="text-gray-600">
                  <strong class="text-gray-900">A/B-Testing</strong> – wir testen
                  Anzeigen, Landingpages und CTAs, um die effektivsten Varianten zu
                  finden.
                </span>
              </li>
              <li class="flex gap-3">
                <span

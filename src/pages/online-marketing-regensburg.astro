];

const performancePunkte = [
  {
    strong: "A/B-Testing",
    text: " – wir testen Anzeigen, Landingpages und CTAs, um die effektivsten Varianten zu finden.",
  },
  {
    strong: "Funnel-Optimierung",
    text: " – wir identifizieren Engpässe in der Customer Journey und beseitigen sie gezielt.",
  },
  {
    strong: "Landingpages, die verkaufen",
    text: " – klar strukturiert, überzeugend, auf die gewünschte Aktion ausgerichtet.",
  },
  {
    strong: "Messbarer ROI",
    text: " – über Google Analytics und detailliertes Tracking zeigen wir genau, was Ihre Investition bringt.",

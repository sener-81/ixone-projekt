  {
    icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
    title: "Search Ads",
    desc: "Textanzeigen genau dann, wenn Ihre Kunden aktiv suchen. Die kaufstärkste Kampagnenform – Nutzer mit konkreter Absicht landen direkt bei Ihnen statt bei der Konkurrenz.",
    ideal: "Dienstleister & lokale Unternehmen",
  },
  {
    icon: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
    title: "Performance Max",
    desc: "KI-gestützte Kampagnen über alle Google-Kanäle gleichzeitig – Suche, Maps, YouTube, Gmail und Display. Google optimiert automatisch auf Ihre Conversion-Ziele.",
    ideal: "Maximale Reichweite mit einem Budget",
  },
  {
    icon: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z",
    title: "Shopping Ads",
    desc: "Produktanzeigen mit Bild, Preis und Shop-Name direkt in den Suchergebnissen. Käufer sehen Ihr Angebot, bevor sie überhaupt eine Website öffnen.",
    ideal: "Onlineshops mit Produktkatalog",
  },
  {
    icon: "M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
    title: "Display Ads",
    desc: "Bannerwerbung auf Millionen Websites im Google Displaynetzwerk. Ideal, um Ihre Marke sichtbar zu machen und im Kopf Ihrer Zielgruppe zu bleiben.",
    ideal: "Markenbekanntheit & Branding",
  },
  {
    icon: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    title: "YouTube Ads",
    desc: "Videoanzeigen vor und zwischen YouTube-Inhalten – zielgenau nach Interessen, Suchverhalten und Demografie ausgesteuert. Bewegtbild, das hängen bleibt.",

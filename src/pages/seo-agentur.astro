---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "SEO Agentur", url: "https://ixone.de/seo-agentur" },
]);

// Service Schema für SEO Agentur
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "SEO Agentur Regensburg",
  description:
    "Professionelle SEO Agentur aus Regensburg. Suchmaschinenoptimierung, OnPage SEO, OffPage SEO und Technical SEO für bessere Google Rankings und mehr organischen Traffic.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "SEO",
  offers: {
    "@type": "Offer",
    price: "800",
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: "800",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: true,
    },
  },
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was macht eine SEO Agentur?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Eine SEO Agentur optimiert Websites für bessere Google Rankings. Wir bieten OnPage SEO, OffPage SEO, Technical SEO, Content-Optimierung und Local SEO für mehr organischen Traffic und höhere Sichtbarkeit.",
      },
    },
    {
      "@type": "Question",
      name: "Wie lange dauert SEO?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SEO ist ein langfristiger Prozess. Erste Verbesserungen sind nach 2-3 Monaten sichtbar, signifikante Ranking-Verbesserungen zeigen sich nach 6-12 Monaten. Wir setzen auf nachhaltige White-Hat-SEO-Strategien.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet eine SEO Agentur?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SEO-Betreuung startet bei 800€ monatlich für kleinere Websites. Umfassende SEO-Strategien für größere Unternehmen kosten 1.500-3.000€ monatlich. Wir erstellen transparente Angebote ohne versteckte Kosten.",
      },
    },
  ],
};
---

<Layout
  title="SEO Agentur Regensburg | Suchmaschinenoptimierung & OnPage SEO | iXone"
  description="Professionelle SEO Agentur aus Regensburg. Mehr Sichtbarkeit bei Google durch maßgeschneiderte SEO-Strategien. OnPage SEO, OffPage SEO und Technical SEO für Top-Rankings."
  canonical="https://ixone.de/seo-agentur"
  structuredData={[breadcrumbs, serviceSchema, faqSchema]}
>
  <main class="pt-16 md:pt-20 bg-white">
    <!-- Hero Section -->
    <section
      class="relative min-h-[80vh] bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
    >
      <!-- Animated Background -->
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <!-- SEO Pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="h-full w-full flex items-center justify-center">
          <div class="grid grid-cols-8 gap-4 transform rotate-12">
            <div class="w-4 h-4 bg-white rounded"></div>
            <div class="w-8 h-4 bg-white rounded"></div>
            <div class="w-6 h-4 bg-white rounded"></div>
            <div class="w-4 h-4 bg-white rounded"></div>
            <div class="w-10 h-4 bg-white rounded"></div>
            <div class="w-4 h-4 bg-white rounded"></div>
            <div class="w-6 h-4 bg-white rounded"></div>
            <div class="w-8 h-4 bg-white rounded"></div>
          </div>
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex items-center min-h-[80vh]"
      >
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Content -->
            <div class="lg:col-span-8 text-center lg:text-left">
              <header>
                <h1
                  class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight"
                >
                  <span class="block text-white">SEO Agentur</span>
                  <span
                    class="block bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
                  >
                    Regensburg
                  </span>
                  <span
                    class="block text-white/90 text-2xl md:text-3xl font-normal"
                  >
                    Suchmaschinenoptimierung
                  </span>
                </h1>
              </header>

              <div
                class="bg-white/10 backdrop-blur-md rounded-2xl p-6 md:p-8 border border-white/20 mb-8"
              >
                <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
                  <strong class="text-white"
                    >Professionelle SEO Agentur aus Regensburg</strong
                  > –
                  <em class="text-brand-orange">OnPage SEO</em>,
                  <em class="text-brand-orange">OffPage SEO</em> und
                  <em class="text-brand-orange">Technical SEO</em> für Top-Rankings
                  bei Google und mehr organischen Traffic.
                </p>
              </div>

              <!-- CTA Buttons -->
              <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a
                  href="/kontakt"
                  class="group relative px-8 py-4 bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white font-bold text-lg rounded-2xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 shadow-2xl hover:shadow-brand-orange/25 overflow-hidden text-center"
                  aria-label="SEO-Analyse anfordern"
                >
                  <span
                    class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
                  ></span>
                  <span class="relative z-10">SEO-Analyse anfordern</span>
                </a>

                <a
                  href="#seo-services"
                  class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-1 text-center"
                >
                  <span class="flex items-center justify-center gap-2">
                    SEO Services entdecken
                    <svg
                      class="w-5 h-5 group-hover:translate-y-1 transition-transform duration-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                  </span>
                </a>
              </div>

              <!-- Trust Indicators -->
              <div
                class="flex flex-wrap justify-center lg:justify-start gap-6 text-white/70 text-sm"
              >
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium">White-Hat SEO</span>
                </span>
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium"
                    >Nachhaltige Erfolge</span
                  >
                </span>
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium"
                    >Transparente Reports</span
                  >
                </span>
              </div>
            </div>

            <!-- Visual Element -->
            <div class="lg:col-span-4 relative">
              <!-- SEO Cards -->
              <div class="relative">
                <!-- OnPage SEO Card -->
                <div
                  class="w-72 h-40 bg-gradient-to-br from-blue-500/20 to-cyan-500/20 backdrop-blur-md rounded-3xl border border-white/20 p-6 transform rotate-2 hover:rotate-1 transition-transform duration-500 animate-float relative z-10"
                >
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center"
                    >
                      <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                        ></path>
                      </svg>
                    </div>
                    <h3 class="text-white font-bold">OnPage SEO</h3>
                  </div>
                  <p class="text-gray-200 text-sm">
                    Website-Optimierung für Google
                  </p>
                </div>

                <!-- Rankings Card -->
                <div
                  class="absolute top-8 right-8 w-72 h-40 bg-gradient-to-br from-purple-500/20 to-pink-500/20 backdrop-blur-md rounded-3xl border border-white/20 p-6 transform -rotate-3 hover:rotate-0 transition-transform duration-500 animate-float-delayed"
                >
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center"
                    >
                      <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                      </svg>
                    </div>
                    <h3 class="text-white font-bold">Top Rankings</h3>
                  </div>
                  <p class="text-gray-200 text-sm">Bessere Google Positionen</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="seo-services" class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Unsere <span
              class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent"
              >SEO Services</span
            >
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Maßgeschneiderte SEO-Strategien für bessere Google Rankings
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto"
        >
          <!-- OnPage Optimierung -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              OnPage Optimierung
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Optimierung Ihrer Website-Struktur</strong>, Inhalte und
              technischen Aspekte. Meta-Tags, Headlines, interne Verlinkung und
              Content-Optimierung.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                Technical SEO
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                Content-Optimierung
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                Meta-Tags
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 800€/Monat</div>
            <a
              href="/onpage-optimierung"
              class="inline-block mt-4 text-brand-orange font-semibold hover:text-brand-orange-dark transition-colors duration-200"
            >
              Mehr erfahren →
            </a>
          </article>

          <!-- OffPage Optimierung -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              OffPage Optimierung
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Aufbau hochwertiger Backlinks</strong> und Stärkung Ihrer Domain-Autorität.
              Link Building, PR-Arbeit und strategische Partnerschaften.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Link Building
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Domain Authority
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                PR & Outreach
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">
              ab 1.200€/Monat
            </div>
          </article>

          <!-- Local SEO -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Local SEO Regensburg
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Optimierung für lokale Suchanfragen</strong> und Google My
              Business. Lokale Rankings, Bewertungsmanagement und regionale Sichtbarkeit.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-purple-500 rounded-full"></span>

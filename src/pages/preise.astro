const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://ixone.de/preise/#service",
  name: "Preise Digitalagentur Regensburg",
  description:
    "Richtwerte für Webdesign, SEO, Google Ads, Social Media und Websitepflege bei ixOne in Regensburg. Individuelle Angebote nach kostenlosem Erstgespräch.",
  provider: { "@id": "https://ixone.de/#organization" },
  telephone: "+4994015338873",
  areaServed: areaServedFull,
};
---

<Layout
  title="Preise | Was kostet eine Website? | ixOne Regensburg"
  description="Grobe Preisorientierung für Webdesign, SEO, Google Ads und Websitepflege aus Regensburg. Onepager ab 1.200 € netto. Kostenloses Erstgespräch."
  canonical="https://ixone.de/preise/"
  structuredData={[serviceSchema, offerCatalogSchema, faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
      aria-label="Preise Digitalagentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/4 w-72 h-72 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div
          class="h-full w-full"
          style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div class="max-w-4xl mx-auto text-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
          >
            <span
              class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
              aria-hidden="true"></span>
            Grobe Preisorientierung – transparent von Anfang an
          </span>

          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            <span class="block text-white">Was kostet eine</span>
            <span class="gradient-text-brand">Website?</span>
            <span
              class="block text-white/80 text-2xl md:text-3xl font-normal mt-2"
            >
              Eine grobe Orientierung für Ihr Projekt
            </span>
          </h1>

          <p
            class="text-lg md:text-xl text-gray-200 leading-relaxed mb-8 max-w-2xl mx-auto"
          >
            Ehrliche Antwort: pauschal lässt sich das nicht sagen. Aber wir
            lassen Sie nicht im Dunkeln – hier finden Sie eine <strong
              class="text-white">grobe Preisorientierung</strong
            >, damit Sie einschätzen können, ob wir zusammenpassen.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={CALENDLY}
              target="_blank"
              rel="noopener"
              data-calendly-popup-url={CALENDLY}
              class="cta-button-primary"
              aria-label="Kostenloses Erstgespräch vereinbaren"
            >
              <span>Termin vereinbaren</span>
            </a>
            <a
              href="#preisorientierung"
              class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 text-center"
            >
              <span class="flex items-center justify-center gap-2">
                Preisorientierung ansehen
                <svg
                  class="w-5 h-5 group-hover:translate-y-1 transition-transform duration-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-28 bg-white" aria-labelledby="warum-heading">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-3xl mx-auto text-center">
          <h2
            id="warum-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
          >
            Warum wir keine <span class="gradient-text-brand-inline"
              >Pauschalpreise</span
            > nennen
          </h2>
          <div class="space-y-5 text-gray-600 text-lg leading-relaxed">
            <p>
              Jedes Projekt ist anders. Manche Kunden brauchen eine schlanke
              Infoseite, andere ein System mit Shop, Buchung und laufender
              Kampagnenbetreuung. Ein einziger Preis wäre für den einen zu hoch
              und für den anderen unrealistisch niedrig.
            </p>
            <p>
              Deshalb kalkulieren wir nach Ziel, Umfang, Funktionen und Aufwand
              – und besprechen jedes Projekt persönlich. Damit Sie trotzdem eine
              Vorstellung bekommen, finden Sie unten eine grobe Orientierung aus
              typischen Projekten.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="preisorientierung"
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="einmalig-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="einmalig-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Grobe Preisorientierung: Einmalige Leistungen
            </h2>
            <p class="text-xl text-gray-600">
              Website, Gestaltung und einmalige Analysen
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
              einmalig.map((posten) => (
                <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-md flex flex-col">
                  <h3 class="text-xl font-bold text-gray-900 mb-3">
                    {posten.leistung}
                  </h3>
                  <p class="text-gray-600 leading-relaxed mb-6 flex-grow">
                    {posten.beschreibung}
                  </p>
                  <p class="text-3xl font-bold text-brand-orange mb-4">
                    {posten.preis}
                  </p>
                  <a
                    href={posten.href}
                    class="inline-flex items-center gap-1 font-medium text-brand-orange hover:underline"
                  >
                    Mehr zur Leistung
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="laufend-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="laufend-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Grobe Preisorientierung: Laufende Betreuung
            </h2>
            <p class="text-xl text-gray-600">
              Monatlich kündbar, ohne Mindestlaufzeit – einzeln oder kombiniert
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
              laufend.map((posten) => (
                <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100 flex flex-col">
                  <div class="flex items-start justify-between gap-4 mb-3">
                    <h3 class="text-xl font-bold text-gray-900">
                      {posten.leistung}
                    </h3>
                    <div class="text-right shrink-0">
                      <span class="text-2xl font-bold text-brand-orange block">
                        {posten.preis}
                      </span>
                      {posten.zeitraum && (
                        <span class="text-gray-500 text-xs">
                          {posten.zeitraum}
                        </span>
                      )}
                    </div>
                  </div>
                  <p class="text-gray-600 leading-relaxed mb-6 flex-grow">
                    {posten.beschreibung}
                  </p>
                  <a
                    href={posten.href}
                    class="inline-flex items-center gap-1 font-medium text-brand-orange hover:underline"
                  >
                    Mehr zur Leistung
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </a>
                </div>
              ))
            }
          </div>

          <div
            class="mt-12 rounded-2xl border-2 border-brand-orange bg-white p-8 md:p-10 shadow-xl"
          >
            <div
              class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-12"
            >
              <div class="flex-grow">
                <span
                  class="inline-flex items-center px-3 py-1 mb-4 rounded-full bg-brand-orange text-white text-xs font-semibold"
                >
                  Kombi-Pakete
                </span>
                <h3 class="text-2xl font-bold text-gray-900 mb-4">
                  Mehrere Leistungen zusammen? Dann wird es günstiger.
                </h3>
                <p class="text-gray-600 leading-relaxed mb-4">
                  Website, SEO und Google Ads greifen ineinander. Wer mehrere
                  Bausteine kombiniert, spart nicht nur Abstimmungsaufwand – wir
                  kalkulieren Kombi-Pakete auch günstiger als die Summe der
                  Einzelleistungen.
                </p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-gray-700">
                  {
                    [
                      "Website + Websitepflege",
                      "Website + SEO + Pflege",
                      "SEO + Google Ads",
                      "Rundum-Betreuung aller Kanäle",
                    ].map((kombi) => (
                      <li class="flex items-start gap-2">
                        <svg
                          class="w-5 h-5 flex-shrink-0 mt-0.5 text-brand-orange"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        <span>{kombi}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="lg:w-64 shrink-0 text-center lg:text-left">
                <p class="text-3xl font-bold text-gray-900 mb-2">Auf Anfrage</p>
                <p class="text-gray-500 text-sm mb-6">
                  Der Preis richtet sich nach Leistungsumfang und Zielsetzung
                </p>
                <a
                  href={CALENDLY}
                  target="_blank"
                  rel="noopener"
                  data-calendly-popup-url={CALENDLY}
                  class="inline-flex items-center justify-center w-full px-6 py-3 bg-brand-orange text-white font-semibold rounded-full transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
                  aria-label="Beratungstermin für ein Kombi-Paket vereinbaren"
                >
                  Paket zusammenstellen
                </a>
              </div>
            </div>
          </div>

          <p class="text-center text-gray-500 text-sm mt-10 max-w-3xl mx-auto">

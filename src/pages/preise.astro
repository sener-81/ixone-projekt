const ablauf = [
  {
    schritt: "01",
    titel: "Kostenloses Erstgespräch",
    text: "Wir sprechen über Ihr Ziel, Ihre Zielgruppe und Ihr Budget. Etwa 30 Minuten, unverbindlich, ohne Verkaufsdruck.",
  },
  {
    schritt: "02",
    titel: "Konzept & Angebot",
    text: "Sie erhalten ein schriftliches Angebot mit klarem Leistungsumfang und Zeitplan. Keine versteckten Posten.",
  },
  {
    schritt: "03",
    titel: "Umsetzung",
    text: "Wir setzen um und halten Sie auf dem Laufenden. Änderungswünsche während der Entwicklung sind eingeplant.",
  },
  {
    schritt: "04",
    titel: "Übergabe & Betreuung",
    text: "Nach dem Launch entscheiden Sie, ob wir die Website weiter betreuen oder Sie selbst übernehmen.",

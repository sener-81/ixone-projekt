];

const faqs = [
  {
    q: "Warum nennen Sie keine Festpreise?",
    a: "Weil die Anforderungen zu unterschiedlich sind. Ein Handwerksbetrieb mit fünf Seiten und ein Onlineshop mit dreihundert Artikeln haben nichts gemeinsam außer dem Wort Website. Ein Pauschalpreis wäre für den einen zu teuer und für den anderen unrealistisch niedrig. Die genannten Richtwerte geben Ihnen eine Orientierung – das verbindliche Angebot folgt nach dem Erstgespräch.",
  },
  {
    q: "Was kostet eine Website bei ixOne ungefähr?",
    a: "Ein Onepager startet bei etwa 1.200 €, eine mehrseitige Unternehmenswebsite bei rund 2.500 €. Nach oben ist die Spanne offen, je nach Funktionsumfang und Individualität. Für Onlineshops, Grafikdesign und KI-Lösungen kalkulieren wir grundsätzlich individuell, weil der Aufwand zu stark schwankt.",
  },
  {
    q: "Ist das Werbebudget bei Google Ads inbegriffen?",
    a: "Nein. Die Betreuungspauschale ab 499 € pro Monat deckt Einrichtung, laufende Optimierung und Reporting ab. Das Werbebudget zahlen Sie direkt an Google. Wie hoch es sein sollte, hängt von Branche und Wettbewerb ab – in ländlichen Regionen wie dem Landkreis Regensburg liegen die Klickpreise deutlich unter denen von Großstädten.",
  },
  {
    q: "Bieten Sie auch Kombi-Pakete an?",
    a: "Ja. Die meisten Kunden buchen mehrere Bausteine zusammen, etwa Website mit Pflege oder SEO mit Google Ads. Solche Kombinationen kalkulieren wir günstiger als die Einzelleistungen, weil Abstimmung und Einarbeitung nur einmal anfallen. Da sich Umfang und Zielsetzung stark unterscheiden, stellen wir jedes Paket im persönlichen Gespräch individuell zusammen.",
  },
  {
    q: "Sind die Preise netto oder brutto?",
    a: "Alle genannten Beträge sind Nettopreise zzgl. der gesetzlichen Umsatzsteuer. Unsere Angebote richten sich ausschließlich an Unternehmer im Sinne des § 14 BGB – also an Gewerbetreibende, Freiberufler, juristische Personen und öffentliche Einrichtungen. Ein Vertragsschluss mit Verbrauchern ist ausgeschlossen.",
  },
  {
    q: "Sind die genannten Preise verbindlich?",
    a: "Nein. Die Angaben auf dieser Seite sind unverbindliche Richtwerte und stellen kein rechtsverbindliches Angebot dar. Verbindlich ist ausschließlich das schriftliche Angebot, das Sie nach dem Erstgespräch von uns erhalten. Darin stehen Leistungsumfang, Preis und Zeitplan im Detail.",
  },
  {
    q: "Gibt es versteckte Kosten?",
    a: "Nein. Im Angebot steht, was enthalten ist und was extra berechnet wird. Laufende Kosten wie Hosting, Domain und Lizenzen Dritter weisen wir separat aus, damit Sie wissen, was jährlich anfällt. Wenn während des Projekts Wünsche dazukommen, die über den vereinbarten Umfang hinausgehen, besprechen wir den Mehraufwand vorher und halten ihn schriftlich fest.",
  },
  {
    q: "Kostet Local SEO weniger als klassisches SEO?",
    a: "Nein, beide starten bei 499 € netto im Monat. Der Aufwand ist vergleichbar, nur die Schwerpunkte unterscheiden sich: Bei Local SEO liegt der Fokus auf Google Business Profil, Bewertungen und regionalen Suchanfragen, bei klassischem SEO stärker auf Inhalten und überregionalen Rankings. Für die meisten Betriebe aus Regensburg ist Local SEO der wirksamere Weg.",
  },
  {
    q: "Gibt es eine Mindestlaufzeit bei laufenden Leistungen?",
    a: "Nein. SEO, Google Ads, Social Media und Websitepflege sind monatlich kündbar. Bei SEO sollten Sie allerdings mit sechs bis zwölf Monaten rechnen, bis sich Ergebnisse zeigen – das ist keine Vertragsbindung, sondern die Natur der Sache.",
  },
  {
    q: "Ist mein Budget zu klein für Sie?",
    a: "Sagen Sie uns einfach, was möglich ist. Manchmal ist ein schlanker Onepager der bessere Start als eine große Website, die das Budget sprengt. Wenn wir nicht der richtige Partner sind, sagen wir das offen – auch das gehört zu ehrlicher Beratung.",
  },
];

const offerCatalogSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Leistungen und Preise der ixOne Digitalagentur Regensburg",
  description:
    "Unverbindliche Richtpreise für Unternehmer im Sinne des § 14 BGB, alle Beträge netto zzgl. gesetzlicher Umsatzsteuer.",
  itemListElement: [
    {
      "@type": "Offer",
      name: "Onepager Webdesign",
      url: "https://ixone.de/webdesign-regensburg/",
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: 1200,
        priceCurrency: "EUR",
        valueAddedTaxIncluded: false,
      },
    },
    {
      "@type": "Offer",
      name: "Unternehmenswebsite",
      url: "https://ixone.de/webdesign-regensburg/",
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: 2500,
        priceCurrency: "EUR",
        valueAddedTaxIncluded: false,
      },
    },
    {
      "@type": "Offer",
      name: "SEO-Betreuung",
      url: "https://ixone.de/seo-regensburg/",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        minPrice: 499,
        priceCurrency: "EUR",
        valueAddedTaxIncluded: false,
        unitCode: "MON",
      },
    },
    {
      "@type": "Offer",
      name: "Google Ads Betreuung",
      url: "https://ixone.de/online-marketing-regensburg/",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        minPrice: 499,
        priceCurrency: "EUR",
        valueAddedTaxIncluded: false,
        unitCode: "MON",
      },
    },
    {
      "@type": "Offer",
      name: "Social Media Betreuung",
      url: "https://ixone.de/social-media-marketing-regensburg/",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        minPrice: 499,
        priceCurrency: "EUR",
        valueAddedTaxIncluded: false,
        unitCode: "MON",
      },
    },
    {
      "@type": "Offer",
      name: "Websitepflege",
      url: "https://ixone.de/websitepflege-regensburg/",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: 49.95,

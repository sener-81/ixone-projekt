---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";
import { areaServedFull } from "../data/structuredData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const kategorien = [
  {
    id: "zusammenarbeit",
    titel: "Zusammenarbeit",
    fragen: [
      {
        q: "Wie läuft der erste Kontakt ab?",
        a: "Sie buchen ein kostenloses Erstgespräch oder rufen einfach an. Wir sprechen etwa 30 Minuten über Ihr Ziel, Ihre Zielgruppe und Ihren Rahmen. Danach erhalten Sie ein schriftliches Angebot. Bis dahin entstehen Ihnen weder Kosten noch Verpflichtungen.",
      },
      {
        q: "Mit wem habe ich es während des Projekts zu tun?",
        a: "Mit derselben Person von der ersten Anfrage bis zur laufenden Betreuung. Es gibt bei uns kein Callcenter und keine wechselnden Projektmanager. Bei Bedarf ziehen wir Fachleute aus unserem Netzwerk hinzu, die Abstimmung läuft aber weiterhin über einen Ansprechpartner.",
      },
      {
        q: "Kann ich Sie persönlich treffen?",
        a: "Ja. Wir haben zwei Standorte: das Ladenbüro in Neutraubling mit Parkmöglichkeit direkt vor der Tür und ein Büro in Regensburg. Viele Kunden besuchen wir auch im eigenen Betrieb – gerade bei Handwerkern versteht man das Geschäft vor Ort deutlich besser.",
      },
      {
        q: "Wie lange dauert ein Website-Projekt?",
        a: "Je nach Umfang vier bis zehn Wochen. Den größten Einfluss hat, wie schnell Inhalte wie Texte und Bilder vorliegen. Wenn wir die Inhalte mit erstellen, planen wir das von vornherein ein. Bei eiligen Projekten sagen Sie es gleich – vieles lässt sich beschleunigen.",
      },
      {
        q: "Was passiert nach dem Launch?",
        a: "Sie entscheiden. Entweder Sie übernehmen die Website selbst, dann übergeben wir alle Zugangsdaten und erklären die Bedienung. Oder wir übernehmen die laufende Pflege mit Updates, Backups und Inhaltsänderungen. Beides ist möglich, nichts davon ist Pflicht.",
      },
    ],
  },
  {
    id: "kosten",
    titel: "Kosten & Verträge",
    fragen: [
      {
        q: "Warum nennen Sie keine Festpreise?",
        a: "Weil die Anforderungen zu unterschiedlich sind. Ein Handwerksbetrieb mit fünf Seiten und ein Onlineshop mit dreihundert Artikeln haben nichts gemeinsam außer dem Wort Website. Auf unserer Preisseite finden Sie Richtwerte zur Orientierung, das verbindliche Angebot folgt nach dem Erstgespräch.",
      },
      {
        q: "Gibt es Mindestlaufzeiten?",
        a: "Nein. Laufende Leistungen wie SEO, Google Ads, Social Media und Websitepflege sind monatlich kündbar. Bei SEO sollten Sie allerdings mit sechs bis zwölf Monaten rechnen, bis sich Ergebnisse zeigen – das ist keine Vertragsbindung, sondern die Natur der Sache.",
      },
      {
        q: "Welche laufenden Kosten kommen auf mich zu?",
        a: "Neben der Betreuung sind das vor allem Hosting und Domain, je nach Umfang meist im niedrigen zweistelligen Bereich pro Monat. Kommen kostenpflichtige Erweiterungen oder Lizenzen hinzu, weisen wir sie im Angebot separat aus. Sie sollen wissen, was jährlich anfällt.",
      },
      {
        q: "Ist das Werbebudget in der Google-Ads-Betreuung enthalten?",
        a: "Nein. Die Betreuungspauschale deckt Einrichtung, laufende Optimierung und Reporting ab. Das Werbebudget zahlen Sie direkt an Google. So sehen Sie jederzeit transparent, wie viel in Anzeigen fließt und wie viel in unsere Arbeit.",
      },
      {
        q: "Gehört die Website danach mir?",
        a: "Ja. Nach vollständiger Bezahlung erhalten Sie alle Nutzungsrechte, Zugangsdaten und Dateien. Wenn Sie den Anbieter wechseln möchten, übergeben wir alles vollständig. Wir arbeiten nicht mit Systemen, die Sie an uns binden.",
      },
    ],
  },
  {
    id: "technik",
    titel: "Technik & Datenschutz",
    fragen: [
      {
        q: "Mit welcher Technik arbeiten Sie?",
        a: "Wir wählen nach Projekt. Für schnelle, inhaltlich stabile Websites nutzen wir moderne Static-Site-Technologie, die sehr gute Ladezeiten erreicht. Für Projekte mit häufiger Redaktion oder Shop-Funktion bleibt ein CMS die sinnvollere Wahl. Entscheidend ist, was zu Ihren Abläufen passt.",
      },
      {
        q: "Ist meine Website DSGVO-konform?",
        a: "Wir richten sie so ein, dass die technischen Voraussetzungen stimmen: Cookie-Banner mit echter Einwilligung, Ladeblockade für externe Dienste bis zur Zustimmung, Schriften und Skripte lokal eingebunden. Die Datenschutzerklärung selbst sollte von einem Anwalt oder einem spezialisierten Dienst erstellt werden – wir sind Techniker, keine Juristen.",
      },
      {
        q: "Kann ich Inhalte selbst ändern?",
        a: "Das hängt vom gewählten System ab und besprechen wir vorab. Bei CMS-Projekten bekommen Sie einen Zugang und eine Einweisung. Bei technisch schlanken Websites übernehmen wir Änderungen meist selbst – das ist im Wartungsvertrag enthalten und in der Regel schneller, als sich einzuarbeiten.",
      },
      {
        q: "Was ist mit Barrierefreiheit?",
        a: "Wir achten grundsätzlich auf Kontraste, Tastaturbedienbarkeit, sinnvolle Überschriftenstruktur und Alternativtexte für Bilder. Für Unternehmen, die unter das Barrierefreiheitsstärkungsgesetz fallen, ist eine gesonderte Prüfung nötig – sprechen Sie uns an, wenn das für Sie relevant ist.",
      },
    ],
  },
  {
    id: "marketing",
    titel: "SEO & Marketing",
    fragen: [
      {
        q: "Wie lange dauert es, bis SEO wirkt?",
        a: "Erste Bewegungen sieht man meist nach zwei bis drei Monaten, belastbare Ergebnisse nach sechs bis zwölf. Wie schnell es geht, hängt vom Wettbewerb in Ihrer Branche ab und davon, wie die Website vorher aufgestellt war. Wer schnellere Sichtbarkeit braucht, kombiniert SEO mit Google Ads.",
      },
      {
        q: "Können Sie Platz 1 bei Google garantieren?",
        a: "Nein, und wer das verspricht, sollte Sie misstrauisch machen. Rankings hängen von Faktoren ab, die niemand vollständig kontrolliert. Was wir zusichern können, ist saubere Arbeit an allen Stellschrauben, die beeinflussbar sind – und ein monatliches Reporting, das zeigt, was sich bewegt.",
      },
      {
        q: "Lohnt sich Google Ads für meinen Betrieb?",
        a: "Das hängt vom Auftragswert ab. Eine qualifizierte Anfrage kostet über Google Ads häufig 60 bis 80 €. Bei Photovoltaik, Sanierung oder Immobilien rechnet sich das sofort. Bei einem Friseurbesuch für 40 € nicht – dort bringen Local SEO und Instagram mehr für dasselbe Geld.",
      },
      {
        q: "Brauche ich wirklich Social Media?",
        a: "Nicht jeder Betrieb. In Branchen, in denen das Bild verkauft – Beauty, Gastronomie, Handwerk mit sichtbarem Ergebnis – ist Social Media oft der stärkste Kanal. Bei B2B-Dienstleistern mit langen Entscheidungswegen bringt eine gute Website mit Referenzen meist mehr.",
      },
      {
        q: "Was bringt mir ein Google Business Profil?",
        a: "Für lokale Betriebe oft mehr als die Website selbst. Wer nach einer Werkstatt oder einem Handwerker in der Nähe sucht, sieht zuerst die Kartenergebnisse. Aktuelle Fotos, korrekte Öffnungszeiten und Bewertungen entscheiden dort darüber, wer angerufen wird.",
      },
    ],
  },
  {
    id: "regional",
    titel: "Region & Branchen",
    fragen: [
      {
        q: "Betreuen Sie auch Betriebe außerhalb von Regensburg?",
        a: "Ja. Unser Schwerpunkt liegt in Regensburg und dem Landkreis – von Neutraubling und Barbing über Wenzenbach und Nittendorf bis Regenstauf und Bad Abbach. Darüber hinaus arbeiten wir auch überregional, dann läuft die Abstimmung per Videocall statt vor Ort.",
      },
      {
        q: "Ist Werbung in Regensburg günstiger als in München?",
        a: "Ja, deutlich. Klickpreise liegen in ländlicheren Regionen typischerweise 20 bis 40 Prozent unter denen von Ballungsräumen. Für Betriebe aus der Region bedeutet das: dasselbe Budget bringt spürbar mehr Anfragen.",
      },
      {
        q: "Meine Branche steht nicht auf Ihrer Liste – geht das trotzdem?",
        a: "Ja. Die aufgeführten Branchen sind unsere Schwerpunkte aus über 500 Projekten. Die Prinzipien lassen sich auf nahezu jeden Betrieb übertragen. Im Erstgespräch schauen wir uns Ihren Markt konkret an und sagen Ihnen ehrlich, ob wir der richtige Partner sind.",
      },
      {
        q: "Arbeiten Sie auch mit sehr kleinen Betrieben?",
        a: "Ja, das ist sogar unser Alltag. Viele Kunden sind Einzelunternehmer oder Betriebe mit wenigen Mitarbeitern. Manchmal ist ein schlanker Onepager der bessere Start als eine große Website, die das Budget sprengt. Sagen Sie einfach, was möglich ist.",
      },
    ],
  },
];

const alleFragen = kategorien.flatMap((k) => k.fragen);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://ixone.de/faq/#faq",
  mainEntity: alleFragen.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const seitenSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://ixone.de/faq/#webpage",
  name: "Häufige Fragen an die Digitalagentur ixOne Regensburg",
  description:
    "Antworten zu Zusammenarbeit, Kosten, Technik, SEO und Marketing der Digitalagentur ixOne aus Regensburg.",
  url: "https://ixone.de/faq/",
  about: { "@id": "https://ixone.de/#organization" },
  areaServed: areaServedFull,
};
---

<Layout
  title="FAQ | Häufige Fragen an die Digitalagentur | ixOne"
  description="Antworten auf die wichtigsten Fragen zu Zusammenarbeit, Kosten, Technik, SEO und Marketing – von der Digitalagentur ixOne aus Regensburg."
  canonical="https://ixone.de/faq/"
  structuredData={[seitenSchema, faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
      aria-label="Häufige Fragen ixOne Digitalagentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/4 w-72 h-72 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div
          class="h-full w-full"
          style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div class="max-w-4xl mx-auto text-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
          >
            <span
              class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
              aria-hidden="true"></span>
            {alleFragen.length} Antworten auf einen Blick
          </span>

          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            <span class="block text-white">Häufige</span>
            <span class="gradient-text-brand">Fragen</span>
            <span
              class="block text-white/80 text-2xl md:text-3xl font-normal mt-2"
            >
              Klare Antworten, ohne Agenturdeutsch
            </span>
          </h1>

          <p
            class="text-lg md:text-xl text-gray-200 leading-relaxed mb-10 max-w-2xl mx-auto"
          >
            Was Betriebe aus Regensburg uns am häufigsten fragen – zu Ablauf,
            Kosten, Technik und Marketing. Falls Ihre Frage fehlt, rufen Sie
            einfach an.
          </p>

          <nav aria-label="Themenübersicht">
            <ul class="flex flex-wrap justify-center gap-3">
              {
                kategorien.map((k) => (
                  <li>
                    <a
                      href={`#${k.id}`}
                      class="inline-flex px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-md text-sm font-medium text-white/90 hover:bg-white/20 transition-colors duration-300"
                    >
                      {k.titel}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </section>

    {
      kategorien.map((kategorie, index) => (
        <section
          id={kategorie.id}
          class:list={[
            "py-16 md:py-20 lg:py-24 scroll-mt-24",
            index % 2 === 0 ? "bg-white" : "bg-gray-50",
          ]}
          aria-labelledby={`${kategorie.id}-heading`}
        >
          <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
            <div class="max-w-4xl mx-auto">
              <h2
                id={`${kategorie.id}-heading`}
                class="text-3xl md:text-4xl font-bold text-gray-900 mb-10"
              >
                {kategorie.titel}
              </h2>

              <div class="space-y-3">
                {kategorie.fragen.map((faq) => (
                  <details
                    class:list={[
                      "faq-item rounded-2xl border border-gray-100 shadow-sm overflow-hidden group",
                      index % 2 === 0 ? "bg-gray-50" : "bg-white",
                    ]}
                  >
                    <summary class="flex items-center justify-between p-5 md:p-6 cursor-pointer list-none gap-4">
                      <h3 class="text-lg font-semibold text-gray-900 text-left">
                        {faq.q}
                      </h3>
                      <svg
                        class="w-5 h-5 flex-shrink-0 text-brand-orange transition-transform duration-300 group-open:rotate-180"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 9l-7 7-7-7"
                        />
                      </svg>
                    </summary>
                    <div class="faq-body px-5 md:px-6 pb-5 md:pb-6 border-t border-gray-100 pt-4">
                      <p class="text-gray-600 leading-relaxed">{faq.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <ServiceCrosslinks
      headline="Antwort gefunden – und jetzt?"
      intro="Hier geht es weiter zu den Leistungen, um die es in den Fragen ging."
    />

    <section
      class="py-20 md:py-28 lg:py-32 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white"
      aria-labelledby="cta-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-3xl mx-auto text-center">
          <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold mb-6">
            Ihre Frage war nicht dabei?
          </h2>
          <p class="text-xl text-gray-300 leading-relaxed mb-10">
            Rufen Sie an oder buchen Sie ein kostenloses Erstgespräch. Wir
            beantworten auch Fragen, aus denen kein Auftrag wird.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={CALENDLY}
              target="_blank"
              rel="noopener"
              data-calendly-popup-url={CALENDLY}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-brand-orange text-white font-semibold rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl"
              aria-label="Kostenlosen Beratungstermin vereinbaren"
            >
              Termin vereinbaren
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
            <a
              href="tel:+4994015338873"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-white/30 text-white font-semibold rounded-full hover:bg-white/10 transition-all duration-300"
              aria-label="ixOne Digitalagentur Regensburg anrufen"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              09401 5338873
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

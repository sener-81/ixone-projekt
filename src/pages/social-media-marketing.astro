---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  {
    name: "Social Media Marketing",
    url: "https://ixone.de/social-media-marketing",
  },
]);

// Service Schema für Social Media Marketing
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Social Media Marketing Agentur Regensburg",
  description:
    "Professionelles Social Media Marketing aus Regensburg. Facebook, Instagram, TikTok, LinkedIn Marketing und Social Media Recruiting für mehr Reichweite und Engagement.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "Social Media Marketing",
  offers: {
    "@type": "Offer",
    price: "600",
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: "600",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: true,
    },
  },
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was umfasst Social Media Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Social Media Marketing umfasst Content-Erstellung, Community Management, Social Media Ads, Influencer Marketing, Social Media Recruiting und strategische Kampagnen auf Facebook, Instagram, TikTok, LinkedIn und anderen Plattformen.",
      },
    },
    {
      "@type": "Question",
      name: "Welche Social Media Plattformen betreuen Sie?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Wir betreuen alle relevanten Social Media Plattformen: Facebook, Instagram, TikTok, LinkedIn, YouTube, Twitter/X und Xing. Je nach Zielgruppe und Branche wählen wir die optimalen Kanäle für Ihr Unternehmen.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet Social Media Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Social Media Marketing startet bei 600€ monatlich für eine Plattform. Multi-Channel-Strategien kosten 1.200-2.500€ monatlich. Wir erstellen individuelle Pakete basierend auf Ihren Zielen und Budget.",
      },
    },
  ],
};
---

<Layout
  title="Social Media Marketing Regensburg | Facebook, Instagram & TikTok | iXone"
  description="Professionelles Social Media Marketing aus Regensburg. Facebook, Instagram, TikTok Marketing und Social Media Recruiting für mehr Reichweite, Engagement und Kunden."
  canonical="https://ixone.de/social-media-marketing"
  structuredData={[breadcrumbs, serviceSchema, faqSchema]}

---
// src/pages/social-media-marketing.astro
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  {
    name: "Social Media Marketing",
    url: "https://ixone.de/social-media-marketing",
  },
]);

// Service Schema für Social Media Marketing (ohne Preisangaben)
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://ixone.de/social-media-marketing#service",
  name: "Social Media Marketing Agentur Regensburg",
  description:
    "Social Media Marketing aus Regensburg: Facebook, Instagram, TikTok und YouTube Marketing, Content-Erstellung, Social Media Ads, Recruiting und Influencer Marketing für mehr Reichweite, Engagement und Kunden.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "Social Media Marketing",
  url: "https://ixone.de/social-media-marketing",
};

// FAQ Schema – aus NeuronWriter-Content, optimiert
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was umfasst Social Media Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Social Media Marketing umfasst alle Maßnahmen, um Ihre Marke und Leistungen über soziale Medien zu bewerben und Ihre Zielgruppe zu erreichen: Social-Media-Strategie, Content-Erstellung (Bilder, Videos, Texte), Community Management, Social Media Ads, Influencer Marketing und Recruiting über Kanäle wie LinkedIn. Ziel ist mehr Sichtbarkeit, Interaktion und Leads für Ihr Unternehmen aus Regensburg.",
      },
    },
    {
      "@type": "Question",
      name: "Welche Social-Media-Plattformen lohnen sich für mein Unternehmen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Das hängt von Zielgruppe und Zielen ab. Facebook und Instagram bieten breite Reichweite und Community-Aufbau, TikTok erreicht jüngere Zielgruppen über virale Trends, YouTube punktet mit Video-Content und Sichtbarkeit in der Suche, LinkedIn und Xing eignen sich für B2B und Employer Branding. Wir analysieren Ihre Zielgruppe und wählen die effektivsten Kanäle.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet Social Media Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die Kosten sind individuell und hängen von Plattformen, Umfang und Zielen ab. Wir erstellen ein maßgeschneidertes Angebot, das genau zu Ihren Anforderungen passt. In einer kostenlosen Erstberatung besprechen wir Ihre Ziele und nennen Ihnen einen transparenten Preis auf Anfrage – ohne versteckte Kosten.",
      },
    },
    {
      "@type": "Question",
      name: "Wie schnell sieht man Erfolge im Social Media Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Das variiert je nach Ausgangslage, Budget und Intensität. Organische Reichweite und Community-Aufbau brauchen meist mehrere Monate kontinuierlicher Content-Erstellung. Über gezielte Social Media Ads sind dagegen schon innerhalb weniger Wochen erste messbare Ergebnisse möglich. Langfristig zahlt sich eine strategische, nachhaltige Betreuung immer aus.",
      },
    },
    {
      "@type": "Question",
      name: "Was ist der Unterschied zwischen organischem Content und Social Media Ads?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Organischer Content (reguläre Posts, Reels, Stories) baut langfristig Reichweite, Vertrauen und Community auf, wirkt aber langsamer. Social Media Ads sind bezahlte Anzeigen mit präzisem Targeting, die schnell Sichtbarkeit und Leads bringen. Die beste Wirkung entsteht aus der Kombination beider Ansätze.",
      },
    },
    {
      "@type": "Question",
      name: "Lohnt sich Social Media Marketing für kleine Unternehmen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja. Social Media Marketing ist gerade für kleine und mittelständische Unternehmen aus Regensburg ein kosteneffizienter Weg, lokale Sichtbarkeit aufzubauen, neue Kunden zu erreichen und sich gegen größere Wettbewerber zu behaupten. Schon mit überschaubarem Budget lassen sich über lokales Targeting messbare Ergebnisse erzielen.",
      },
    },
    {
      "@type": "Question",
      name: "Wie wird der Erfolg im Social Media Marketing gemessen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Über Kennzahlen wie Reichweite, Engagement, Klicks, Lead-Anfragen und letztlich Conversions und Umsatz. Für lokale Unternehmen sind zusätzlich regionale KPIs sinnvoll – etwa wie viele Anfragen aus Regensburg und Umgebung stammen. Sie erhalten von uns regelmäßige, transparente Reports.",
      },
    },
    {
      "@type": "Question",
      name: "Warum eine lokale Social Media Agentur aus Regensburg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Eine lokale Agentur wie iXone bietet Ihnen einen persönlichen Ansprechpartner und ein tiefes Verständnis für den regionalen Markt. Wir kennen die Besonderheiten von Regensburg und Umgebung, stimmen Ihre Strategie präzise auf Ihre Zielgruppe ab und reagieren durch die räumliche Nähe schnell und flexibel.",
      },
    },
  ],
};
---

<Layout
  title="Social Media Marketing Regensburg | Facebook, Instagram & TikTok | iXone"
  description="Social Media Marketing Agentur aus Regensburg: Facebook, Instagram, TikTok & YouTube Marketing, Content & Ads für mehr Reichweite, Engagement und Kunden. Jetzt kostenlos beraten lassen."
  canonical="https://ixone.de/social-media-marketing"
  structuredData={[breadcrumbs, serviceSchema, faqSchema]}
>
  <main class="pt-14 sm:pt-16 md:pt-18 lg:pt-20 xl:pt-22 bg-white">
    <!-- ═══════════════════════════════════════════════════
         HERO – Pink/Purple, einheitlich mit Countern
    ════════════════════════════════════════════════════ -->
    <section
      class="relative overflow-hidden bg-gradient-to-br from-pink-900 via-purple-800 to-indigo-900 text-white"
      aria-label="Social Media Marketing Agentur Regensburg Hero"
    >
      <!-- Hintergrund-Akzente -->
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute -top-24 -left-24 w-96 h-96 bg-pink-400 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -right-24 w-96 h-96 bg-purple-400 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"
        >
          <!-- Linke Spalte: Text -->
          <div class="text-center lg:text-left">
            <span
              class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
            >
              <span class="w-2 h-2 rounded-full bg-pink-400 animate-pulse"
              ></span>
              Digitalagentur aus Regensburg · seit 2007
            </span>

            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
            >
              <span class="block">Social Media Marketing</span>
              <span class="block gradient-text-brand">Agentur Regensburg</span>
            </h1>

            <p
              class="text-lg md:text-xl text-gray-200 leading-relaxed mb-10 max-w-xl mx-auto lg:mx-0"
            >
              Strategisches Social Media Marketing aus Regensburg –
              <strong class="text-white">Facebook</strong>,
              <strong class="text-white">Instagram</strong>,
              <strong class="text-white">TikTok</strong> und
              <strong class="text-white">YouTube</strong> für mehr Reichweite, Engagement
              und qualifizierte Leads.
            </p>

            <div
              class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
            >
              <a
                href="#"
                class="cta-button-primary text-center"
                aria-label="Kostenlose Erstberatung Social Media Marketing"
                data-calendly-popup-url="https://calendly.com/senerbayram-info/30min?primary_color=ff8b00"
              >
                Kostenlose Erstberatung
              </a>
              <a
                href="#plattformen"
                class="px-8 py-4 rounded-2xl font-semibold text-white border border-white/30 bg-white/5 backdrop-blur-md hover:bg-white/15 transition-all duration-300 text-center"
              >
                Plattformen entdecken
              </a>
            </div>
          </div>

          <!-- Rechte Spalte: Counter-Karten -->
          <div class="grid grid-cols-2 gap-4 sm:gap-6">
            <div
              class="bg-white/10 backdrop-blur-md rounded-2xl p-6 lg:p-8 border border-white/20 text-center"
            >
              <div
                class="counter text-4xl md:text-5xl font-bold gradient-text-brand"
                data-target="4"
                data-suffix=""
              >
                0
              </div>
              <p class="mt-3 text-sm text-gray-300">Haupt-Plattformen</p>
            </div>
            <div
              class="bg-white/10 backdrop-blur-md rounded-2xl p-6 lg:p-8 border border-white/20 text-center"
            >
              <div
                class="counter text-4xl md:text-5xl font-bold gradient-text-brand"
                data-target="500"
                data-suffix="+"
              >
                0+
              </div>
              <p class="mt-3 text-sm text-gray-300">Projekte umgesetzt</p>
            </div>
            <div
              class="bg-white/10 backdrop-blur-md rounded-2xl p-6 lg:p-8 border border-white/20 text-center"
            >
              <div
                class="counter text-4xl md:text-5xl font-bold gradient-text-brand"
                data-target="15"
                data-suffix="+"
              >
                0+
              </div>
              <p class="mt-3 text-sm text-gray-300">Jahre Erfahrung</p>
            </div>
            <div
              class="bg-white/10 backdrop-blur-md rounded-2xl p-6 lg:p-8 border border-white/20 text-center"
            >
              <div
                class="counter text-4xl md:text-5xl font-bold gradient-text-brand"
                data-target="100"
                data-suffix="%"
              >
                0%
              </div>
              <p class="mt-3 text-sm text-gray-300">lokaler Fokus</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         INTRO
    ════════════════════════════════════════════════════ -->
    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="intro-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <h2
            id="intro-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-8"
          >
            Social Media Marketing als Schlüssel zur
            <span class="gradient-text-brand">Sichtbarkeit</span> in Regensburg
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Eine starke Präsenz in den sozialen Medien ist für Unternehmen aus
            Regensburg unverzichtbar, um neue Kunden zu gewinnen und die
            Markenbekanntheit zu steigern. Social-Media-Kanäle sind heute
            leistungsstarke Marketing-Plattformen, über die Sie eine breite
            Reichweite erzielen und direkt mit potenziellen Kunden in den Dialog
            treten.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Als lokale Social Media Agentur aus Regensburg analysieren wir Ihre
            Zielgruppe präzise und entwickeln eine Strategie, die Ihre Marke
            stärkt und Ihre Botschaft über die richtigen Plattformen verbreitet.
            Eng verzahnt mit unserem
            <a
              href="/online-marketing"
              class="text-brand-orange font-semibold hover:underline"
              >Online Marketing</a
            >,
            <a
              href="/seo-agentur"
              class="text-brand-orange font-semibold hover:underline">SEO</a
            > und
            <a
              href="/webdesign"
              class="text-brand-orange font-semibold hover:underline"
              >Webdesign</a
            > greifen alle Maßnahmen ineinander.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         PLATTFORM-SEKTIONEN (je eigene h2 für Ranking)
    ════════════════════════════════════════════════════ -->
    <section
      id="plattformen"
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="plattformen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <h2
            id="plattformen-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Unsere <span class="gradient-text-brand">Plattform-Expertise</span>
          </h2>
          <p class="text-xl text-gray-600">
            Für jede Plattform die richtige Strategie – von Facebook bis
            YouTube.
          </p>
        </div>

        <div class="max-w-6xl mx-auto space-y-12 md:space-y-16">
          <!-- FACEBOOK -->
          <article
            class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
          >
            <div
              class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-blue-100 to-indigo-100 aspect-[4/3] flex items-center justify-center border border-gray-200 order-1 lg:order-none"
            >
              <!-- TODO: Bild ersetzen
                   Pfad: /assets/social-media/facebook-marketing-regensburg.webp
                   Alt:  "Facebook Marketing Regensburg – Reichweite und Community-Aufbau durch iXone"
                   WebP, ~1000x750px, loading="lazy", decoding="async" -->
              <span class="text-gray-400 text-sm px-4 text-center">
                facebook-marketing-regensburg.webp
              </span>
            </div>
            <div>
              <div
                class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-blue-600 text-white text-sm font-semibold"
              >
                <span class="font-bold">f</span> Facebook
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">
                Facebook Marketing Regensburg
              </h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                Facebook bietet Unternehmen aus Regensburg exzellente
                Möglichkeiten, Reichweite aufzubauen und eine engagierte
                Community zu pflegen. Mit gezielten Postings, strategischem
                Community Management und performancestarken Facebook Ads
                sprechen wir genau Ihre lokale Zielgruppe an – ob zur
                Neukundengewinnung oder fürs Employer Branding.
              </p>
              <ul class="text-gray-600 text-sm space-y-2">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Reichweite & Community-Aufbau
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Zielgerichtete Facebook Ads
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Transparentes Reporting
                </li>
              </ul>
            </div>
          </article>

          <!-- INSTAGRAM -->
          <article
            class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
          >
            <div class="lg:order-2">
              <div
                class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-pink-100 to-purple-100 aspect-[4/3] flex items-center justify-center border border-gray-200"
              >
                <!-- TODO: Bild ersetzen
                     Pfad: /assets/social-media/instagram-marketing-regensburg.webp
                     Alt:  "Instagram Marketing Regensburg – visuelles Storytelling mit Reels und Stories"
                     WebP, ~1000x750px, loading="lazy", decoding="async" -->
                <span class="text-gray-400 text-sm px-4 text-center">
                  instagram-marketing-regensburg.webp
                </span>
              </div>
            </div>
            <div class="lg:order-1">
              <div
                class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-gradient-to-r from-pink-500 to-purple-600 text-white text-sm font-semibold"
              >
                <span class="font-bold">IG</span> Instagram
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">
                Instagram Marketing Regensburg
              </h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                Instagram ist die Bühne für visuelles Storytelling. Wir erwecken
                Ihre Marke mit ästhetisch ansprechendem Content zum Leben, bauen
                über Reels und Stories Reichweite auf und nutzen Instagram
                Shopping, damit Ihre Produkte direkt verkaufen. So entsteht eine
                starke emotionale Verbindung zu Ihrer Zielgruppe in Regensburg.
              </p>
              <ul class="text-gray-600 text-sm space-y-2">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Visuelles Storytelling & Feed-Design
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Reels & Stories
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Instagram Shopping
                </li>
              </ul>
            </div>
          </article>

          <!-- TIKTOK -->
          <article
            class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
          >
            <div
              class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-gray-200 to-gray-300 aspect-[4/3] flex items-center justify-center border border-gray-200 order-1 lg:order-none"
            >
              <!-- TODO: Bild ersetzen
                   Pfad: /assets/social-media/tiktok-marketing-regensburg.webp
                   Alt:  "TikTok Marketing Regensburg – virale Reichweite für junge Zielgruppen"
                   WebP, ~1000x750px, loading="lazy", decoding="async" -->
              <span class="text-gray-400 text-sm px-4 text-center">
                tiktok-marketing-regensburg.webp
              </span>
            </div>
            <div>
              <div
                class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-gray-900 text-white text-sm font-semibold"
              >
                <span class="font-bold">TT</span> TikTok
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">
                TikTok Marketing Regensburg
              </h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                TikTok bietet Unternehmen aus Regensburg eine einzigartige
                Chance auf virale Reichweite – besonders bei jüngeren
                Zielgruppen, die anderswo schwer erreichbar sind. Mit kreativem,
                trendorientiertem Content, strategischen Posting-Plänen und
                aktivem Community Management steigern wir Ihre Markenbekanntheit
                und Interaktion.
              </p>
              <ul class="text-gray-600 text-sm space-y-2">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Virale Reichweite & junge Zielgruppen
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Trend-basierter Content
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Community Management
                </li>
              </ul>
            </div>
          </article>

          <!-- YOUTUBE -->
          <article
            class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
          >
            <div class="lg:order-2">
              <div
                class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-red-100 to-rose-100 aspect-[4/3] flex items-center justify-center border border-gray-200"
              >
                <!-- TODO: Bild ersetzen
                     Pfad: /assets/social-media/youtube-marketing-regensburg.webp
                     Alt:  "YouTube Marketing Regensburg – Video-Content und Branding über die zweitgrößte Suchmaschine"
                     WebP, ~1000x750px, loading="lazy", decoding="async" -->
                <span class="text-gray-400 text-sm px-4 text-center">
                  youtube-marketing-regensburg.webp
                </span>
              </div>
            </div>
            <div class="lg:order-1">
              <div
                class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-red-600 text-white text-sm font-semibold"
              >
                <span class="font-bold">YT</span> YouTube
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">
                YouTube Marketing Regensburg
              </h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                Als zweitgrößte Suchmaschine der Welt ist YouTube ideal, um
                Video-Content zu verbreiten und Ihre Markenbekanntheit
                nachhaltig zu stärken. Wir erstellen hochwertige Videos,
                optimieren Titel, Beschreibungen und Tags für die Suche und
                positionieren Sie mit informativem und unterhaltsamem Content
                als Experte Ihrer Branche.
              </p>
              <ul class="text-gray-600 text-sm space-y-2">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Video-Content für Markenbekanntheit
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  YouTube-SEO (Titel, Tags, Beschreibung)
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand-orange rounded-full"></span>
                  Branding durch Tutorials & Einblicke
                </li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         WEITERE LEISTUNGEN
    ════════════════════════════════════════════════════ -->
    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="leistungen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <h2
            id="leistungen-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Weitere <span class="gradient-text-brand">Leistungen</span>
          </h2>
          <p class="text-xl text-gray-600">
            Von der Content-Erstellung bis zum Social Media Recruiting – alles
            aus einer Hand.
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto"
        >
          <!-- Content-Erstellung -->
          <article
            class="bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 p-8 border border-gray-100"
          >
            <div
              class="w-12 h-12 rounded-xl border border-brand-orange/30 flex items-center justify-center mb-6"
            >
              <svg
                class="w-6 h-6 text-brand-orange"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path

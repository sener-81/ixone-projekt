---
import Layout from "../layouts/Layout.astro";
import Headline from "../components/Headline.astro";
import Highlight from "../components/Highlight.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "Online-Marketing", url: "https://ixone.de/online-marketing" },
]);

// Service Schema für Online-Marketing
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Online-Marketing Agentur Regensburg",
  description:
    "Professionelle Online-Marketing Agentur aus Regensburg. Google Ads, Social Media Marketing, Conversion-Optimierung und Leadgenerierung für maximalen ROI und messbare Erfolge.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland", "Oberpfalz"],
  serviceType: "Online-Marketing",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Online-Marketing Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Google Ads & SEA",
          description:
            "Professionelle Google Ads Betreuung und Suchmaschinenmarketing",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Social Media Ads",
          description: "Facebook, Instagram und TikTok Werbeanzeigen",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Conversion-Optimierung",
          description: "Performance Marketing und ROI-Optimierung",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Leadgenerierung",
          description: "Strategische Lead-Akquise und Marketing Automation",
        },
      },
    ],
  },
  offers: {
    "@type": "Offer",
    price: "500",
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: "500",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: true,
    },
  },
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was umfasst professionelles Online-Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Professionelles Online-Marketing umfasst Google Ads Kampagnen, Social Media Advertising auf Facebook und Instagram, Conversion-Optimierung, Leadgenerierung, Performance Marketing, Display Advertising, Remarketing und umfassendes Analytics & Reporting für maximalen ROI.",
      },
    },
    {
      "@type": "Question",
      name: "Wie schnell sehe ich Ergebnisse im Online-Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Online-Marketing zeigt sofortige Ergebnisse. Google Ads Kampagnen sind nach 24-48 Stunden live und generieren ersten Traffic. Optimale Performance und niedrigste Klickpreise erreichen wir nach 2-4 Wochen kontinuierlicher Optimierung und A/B-Tests.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet professionelles Online-Marketing in Regensburg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Online-Marketing Services starten bei 500€ monatlich plus Ihr individuelles Werbebudget. Das Werbebudget bestimmen Sie selbst - wir empfehlen mindestens 1.000€ monatlich für effektive Kampagnen. Wir optimieren kontinuierlich für maximalen ROI und niedrigste Kosten pro Conversion.",
      },
    },
    {
      "@type": "Question",
      name: "Welche Online-Marketing Kanäle nutzen Sie?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Wir betreuen Online-Marketing Kampagnen auf Google Ads, Microsoft Ads (Bing), Facebook, Instagram, TikTok, LinkedIn, YouTube und Display-Netzwerken. Je nach Ihrer Zielgruppe und Budget wählen wir die optimalen Kanäle für maximale Performance.",
      },
    },
    {
      "@type": "Question",
      name: "Arbeiten Sie auch mit Unternehmen außerhalb von Regensburg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja, als Online-Marketing Agentur betreuen wir Kunden in ganz Bayern, Deutschland und darüber hinaus. Digitales Marketing kennt keine geografischen Grenzen - wir arbeiten erfolgreich remote und vor Ort in Regensburg.",
      },
    },
  ],
};
---

<Layout
  title="Online-Marketing Agentur Regensburg | Google Ads & Social Media Marketing | iXone"
  description="Professionelle Online-Marketing Agentur aus Regensburg ✅ Google Ads ✅ Social Media Marketing ✅ Conversion-Optimierung ✅ Seit 2007 ✅ Kostenlose Beratung"
  canonical="https://ixone.de/online-marketing"
  structuredData={[breadcrumbs, serviceSchema, faqSchema]}
>
 <main class="pt-16 pb-18 md:pt-20 md:pb-12 bg-white">
   


  <!-- Hero Section -->
<section class="relative min-h-[90vh] bg-gradient-to-br from-orange-900 via-red-800 to-pink-900 text-white overflow-hidden">
  <!-- Animated Background -->
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-0 left-0 w-72 h-72 md:w-96 md:h-96 bg-gradient-to-br from-orange-400 to-red-400 rounded-full filter blur-3xl animate-blob"></div>
    <div class="absolute bottom-0 right-0 w-72 h-72 md:w-96 md:h-96 bg-gradient-to-br from-red-400 to-pink-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-48 h-48 md:w-64 md:h-64 bg-gradient-to-br from-pink-400 to-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"></div>
  </div>

  <!-- Marketing Icons Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="h-full w-full flex items-center justify-center">
      <div class="grid grid-cols-6 md:grid-cols-8 gap-8 md:gap-12 transform rotate-12">
        <div class="w-4 h-4 md:w-6 md:h-6 bg-white rounded-lg animate-pulse"></div>
        <div class="w-4 h-4 md:w-6 md:h-6 bg-white rounded-full animate-pulse animation-delay-1000"></div>
        <div class="w-4 h-4 md:w-6 md:h-6 bg-white rounded-lg animate-pulse animation-delay-2000"></div>
        <div class="w-4 h-4 md:w-6 md:h-6 bg-white rounded-full animate-pulse"></div>
        <div class="w-4 h-4 md:w-6 md:h-6 bg-white rounded-lg animate-pulse animation-delay-1000"></div>
        <div class="w-4 h-4 md:w-6 md:h-6 bg-white rounded-full animate-pulse animation-delay-2000"></div>
        <div class="w-4 h-4 md:w-6 md:h-6 bg-white rounded-lg animate-pulse"></div>
        <div class="w-4 h-4 md:w-6 md:h-6 bg-white rounded-full animate-pulse animation-delay-1000"></div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 2xl:px-20 relative z-10 flex items-center min-h-[90vh]">
    <div class="w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-center">
        <!-- Content -->
        <div class="lg:col-span-8 text-center lg:text-left py-12 sm:py-16 md:py-20 lg:py-24">
          <header class="mb-8 sm:mb-10 md:mb-12 lg:mb-16">
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 sm:mb-7 md:mb-8 lg:mb-10 leading-tight">
              <span class="block text-white mb-2 sm:mb-3 md:mb-4">Online-Marketing</span>
              <span class="block bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x">
                Agentur Regensburg
              </span>
            </h1>
            <div class="text-lg sm:text-xl md:text-2xl lg:text-3xl text-gray-200 font-light mb-6 sm:mb-7 md:mb-8 lg:mb-10">
              Seit 2007 • Über 500 erfolgreiche Kampagnen • ROI-fokussiert
            </div>
          </header>

          <div class="bg-white/10 backdrop-blur-md rounded-2xl md:rounded-3xl p-6 sm:p-7 md:p-8 lg:p-10 xl:p-12 border border-white/20 mb-8 sm:mb-10 md:mb-12 lg:mb-16 max-w-4xl">
            <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl text-gray-100 leading-relaxed mb-4 sm:mb-5 md:mb-6 lg:mb-8">
              <strong class="text-white">Strategisches Online-Marketing aus Regensburg</strong>
              für messbare Erfolge und maximalen Return on Investment.
            </p>
            <p class="text-base sm:text-lg md:text-xl lg:text-2xl text-gray-200 leading-relaxed">
              Unsere <strong class="text-brand-orange">Google Ads Expertise</strong>
              kombiniert mit professionellem
              <strong class="text-brand-orange">Social Media Marketing</strong>
              und datenbasierter
              <strong class="text-brand-orange">Conversion-Optimierung</strong>
              sorgt für kontinuierliches Wachstum Ihres Unternehmens.
            </p>
          </div>

          <!-- CTA Buttons - Responsive -->
          <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 md:gap-6 lg:gap-8 mb-8 sm:mb-10 md:mb-12 lg:mb-16">
            <a
              href="/kontakt"
              class="group relative px-8 sm:px-9 md:px-10 lg:px-12 py-4 sm:py-5 md:py-6 bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white font-bold text-base sm:text-lg md:text-xl lg:text-2xl rounded-xl md:rounded-2xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 shadow-2xl hover:shadow-brand-orange/25 overflow-hidden text-center min-h-[56px] sm:min-h-[60px] md:min-h-[64px] lg:min-h-[72px] flex items-center justify-center"
              aria-label="Kostenlose Online-Marketing Beratung starten"
            >
              <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-700"></span>
              <span class="relative z-10">
                Kostenlose Marketing-Beratung
              </span>
            </a>

            <a
              href="#marketing-services"
              class="group px-8 sm:px-9 md:px-10 lg:px-12 py-4 sm:py-5 md:py-6 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl md:rounded-2xl font-semibold text-base sm:text-lg md:text-xl lg:text-2xl text-white hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-1 text-center min-h-[56px] sm:min-h-[60px] md:min-h-[64px] lg:min-h-[72px] flex items-center justify-center"
              aria-label="Online-Marketing Services entdecken"
            >
              <span class="flex items-center justify-center gap-2 sm:gap-3">
                <span>Services entdecken</span>
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 group-hover:translate-y-1 transition-transform duration-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 14l-7 7m0 0l-7-7m7 7V3"
                  ></path>
                </svg>
              </span>
            </a>
          </div>

          <!-- Trust Indicators - Responsive -->
          <div class="flex flex-wrap justify-center lg:justify-start gap-4 sm:gap-6 md:gap-8 text-white/80 text-sm sm:text-base md:text-lg">
            <span class="flex items-center gap-2 sm:gap-3">
              <svg
                class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 text-green-400 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              <span class="text-white font-medium">Google Ads Premium Partner</span>
            </span>
            <span class="flex items-center gap-2 sm:gap-3">
              <svg
                class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 text-green-400 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              <span class="text-white font-medium">Facebook Business Partner</span>
            </span>
            <span class="flex items-center gap-2 sm:gap-3">
              <svg
                class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 text-green-400 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              <span class="text-white font-medium">15+ Jahre Erfahrung</span>
            </span>
          </div>
        </div>

        <!-- Visual Element - Responsive mit Bottom-Spacing -->
        <div class="lg:col-span-4 relative mt-8 sm:mt-10 md:mt-12 lg:mt-0 mb-8 sm:mb-10 md:mb-12 lg:mb-0">
          <!-- Modern Dashboard Mockup -->
          <div class="relative mb-8 sm:mb-10 md:mb-12 lg:mb-16">
            <div class="bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-md rounded-2xl md:rounded-3xl border border-white/20 p-4 sm:p-5 md:p-6 lg:p-8 xl:p-10 shadow-2xl">
              <img
                src="/placeholder-online-marketing-dashboard.jpg"
                alt="Online-Marketing Performance Dashboard - ROI Tracking und Kampagnen-Optimierung iXone Regensburg"
                width="600"
                height="400"
                loading="eager"
                class="w-full h-auto rounded-xl md:rounded-2xl shadow-xl"
              />
              <!-- Glassmorphism Overlay -->
              <div class="absolute inset-4 sm:inset-5 md:inset-6 lg:inset-8 xl:inset-10 bg-gradient-to-t from-black/20 via-transparent to-transparent rounded-xl md:rounded-2xl pointer-events-none"></div>

              <!-- Floating Performance Cards - Responsive -->
              <div class="absolute -top-3 -right-3 sm:-top-4 sm:-right-4 md:-top-5 md:-right-5 lg:-top-6 lg:-right-6 xl:-top-8 xl:-right-8 bg-white/90 backdrop-blur-md rounded-xl md:rounded-2xl p-3 sm:p-4 md:p-5 lg:p-6 xl:p-8 shadow-xl border border-white/20">
                <div class="text-brand-orange font-bold text-xl sm:text-2xl md:text-3xl lg:text-4xl">+320%</div>
                <div class="text-gray-600 text-xs sm:text-sm md:text-base lg:text-lg">ROI Steigerung</div>
              </div>

              <div class="absolute -bottom-3 -left-3 sm:-bottom-4 sm:-left-4 md:-bottom-5 md:-left-5 lg:-bottom-6 lg:-left-6 xl:-bottom-8 xl:-left-8 bg-white/90 backdrop-blur-md rounded-xl md:rounded-2xl p-3 sm:p-4 md:p-5 lg:p-6 xl:p-8 shadow-xl border border-white/20">
                <div class="text-green-500 font-bold text-xl sm:text-2xl md:text-3xl lg:text-4xl">€0.45</div>
                <div class="text-gray-600 text-xs sm:text-sm md:text-base lg:text-lg">Ø Klickpreis</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>



    <!-- Online-Marketing Definition Section -->
    <section class="pt-16 pb-16 md:pt-24 md:pb-24 bg-gray-50">
      <div
        class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 xl:px-12 2xl:px-16"
      >
        <!-- Überschrift -->
        <div class="text-center mb-20">
          <Headline>
            Was ist <Highlight>Online-Marketing?</Highlight>
          </Headline>

          <p class="text-xl text-gray-600 leading-relaxed max-w-4xl mx-auto">
            Strategischer Überblick über digitale Marketing-Methoden und deren
            Vorteile
          </p>
        </div>

        <!-- 2-Spalten-Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <!-- Spalte 1: Definition -->
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              Definition & Bedeutung
            </h3>
            <div class="prose prose-lg text-gray-600 leading-relaxed">
              <p>
                <strong class="text-gray-900">Online-Marketing</strong> umfasst alle
                digitalen Maßnahmen zur Kundengewinnung, Markenbildung und Umsatzsteigerung
                über Internet-Kanäle. Als spezialisierte
                <strong>Online-Marketing Agentur aus Regensburg</strong> entwickeln
                wir datenbasierte Strategien für messbare Erfolge.
              </p>
              <p>
                Die wichtigsten Bereiche sind
                <strong>Suchmaschinenmarketing (SEA)</strong> mit Google Ads,
                <strong>Social Media Marketing</strong> auf Plattformen wie Facebook
                und Instagram sowie <strong>Conversion-Optimierung</strong> für maximale
                ROI.
              </p>
              <p>
                Im Gegensatz zu traditioneller Werbung bietet digitales
                Marketing
                <strong>präzise Zielgruppenansprache</strong>, <strong
                  >flexible Budget-Optimierung</strong
                > und <strong>transparente Performance-Messung</strong> in Echtzeit.
              </p>
            </div>
          </div>

          <!-- Spalte 2: Vorteile-Liste -->
          <div class="bg-white rounded-2xl shadow-xl p-8">
            <h4 class="text-xl font-bold text-gray-900 mb-6">
              Vorteile von Online-Marketing
            </h4>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-500 mt-1 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0
                   00-1.414-1.414L9 10.586 7.707 9.293a1 1 0
                   00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong class="text-gray-900">Messbare Ergebnisse</strong>
                  <p class="text-gray-600">Echtzeit-KPIs und ROI-Tracking.</p>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-500 mt-1 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0
                   00-1.414-1.414L9 10.586 7.707 9.293a1 1 0
                   00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong class="text-gray-900"
                    >Präzise Zielgruppenansprache</strong
                  >
                  <p class="text-gray-600">
                    Demografische & verhaltensbasierte Targeting.
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-500 mt-1 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0
                   00-1.414-1.414L9 10.586 7.707 9.293a1 1 0
                   00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong class="text-gray-900">Budget-Flexibilität</strong>
                  <p class="text-gray-600">
                    Tägliche Anpassung nach Performance.
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-500 mt-1 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0
                   00-1.414-1.414L9 10.586 7.707 9.293a1 1 0
                   00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong class="text-gray-900">Schnelle Skalierbarkeit</strong>
                  <p class="text-gray-600">
                    Kampagnen lassen sich binnen Stunden erweitern.
                  </p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="marketing-services" class="py-16 md:py-24 bg-white">
      <div
        class="container mx-auto px-3 sm:px-4 md:px-6 lg:px-8 xl:px-12 2xl:px-16"
      >
        <div class="text-center mb-16">
          <Headline>
            Unsere <Highlight>Online-Marketing</Highlight> Schwerpunkte
            <Headline>
              <p
                class="text-xl text-gray-600 max-w-4xl mx-auto leading-relaxed"
              >
                Strategische digitale Marketing-Lösungen für maximale
                Online-Performance und nachhaltiges Unternehmenswachstum
              </p>
            </Headline>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
              <!-- Google Ads & SEA -->
              <article
                class="group bg-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-3 p-8 border border-gray-100"
              >
                <div
                  class="w-20 h-20 bg-gradient-to-br from-brand-orange to-yellow-500 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-500"
                >
                  <svg
                    class="w-10 h-10 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">
                  Google Ads & SEA Marketing
                </h3>
                <p class="text-gray-600 leading-relaxed mb-6 text-center">
                  <strong class="text-gray-900"
                    >Professionelle Google Ads Betreuung</strong
                  >
                  für sofortige Sichtbarkeit in den Suchergebnissen. Unsere SEA-Experten

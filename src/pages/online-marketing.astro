---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "Online Marketing", url: "https://ixone.de/online-marketing" },
]);

// Service Schema für Online Marketing
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Online Marketing Agentur Regensburg",
  description:
    "Professionelle Online Marketing Agentur aus Regensburg. Google Ads, SEA, Content Marketing, Conversion-Optimierung und Performance Marketing für messbare Erfolge.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "Online Marketing",
  offers: {
    "@type": "Offer",
    price: "1000",
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: "1000",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: true,
    },
  },
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was umfasst Online Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Online Marketing umfasst alle digitalen Marketing-Maßnahmen: SEA/Google Ads, Social Media Marketing, Content Marketing, E-Mail Marketing, Conversion-Optimierung und Performance Marketing für maximalen ROI.",
      },
    },
    {
      "@type": "Question",
      name: "Wie schnell zeigen sich Erfolge im Online Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Paid Ads (Google Ads, Social Media Ads) liefern sofortige Ergebnisse. Content Marketing und organische Strategien zeigen nach 3-6 Monaten nachhaltige Erfolge. Wir kombinieren beide Ansätze für optimale Resultate.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet Online Marketing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Online Marketing Kampagnen starten bei 1.000€ monatlich plus Werbebudget. Umfassende Multi-Channel-Strategien kosten 2.000-5.000€ monatlich. Individuelle Pakete nach Ihren Zielen und Budget.",
      },
    },
  ],
};
---

<Layout
  title="Online Marketing Agentur Regensburg | Google Ads & Performance Marketing | iXone"
  description="Online Marketing Agentur aus Regensburg. Google Ads, SEA, Content Marketing und Conversion-Optimierung für messbare Erfolge und maximalen ROI."
  canonical="https://ixone.de/online-marketing"
  structuredData={[breadcrumbs, serviceSchema, faqSchema]}
>
  <main class="pt-14 sm:pt-16 md:pt-18 lg:pt-20 xl:pt-22 bg-white">
    <!-- Hero Section -->
    <section
      class="relative min-h-[80vh] bg-gradient-to-br from-emerald-900 via-teal-800 to-cyan-900 text-white overflow-hidden"
    >
      <!-- Animated Background -->
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-emerald-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-teal-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-cyan-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <!-- Marketing Pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="h-full w-full flex items-center justify-center">
          <div class="grid grid-cols-8 gap-4 transform rotate-12">
            <div class="w-6 h-6 bg-white rounded"></div>
            <div class="w-6 h-6 bg-white rounded-full"></div>
            <div class="w-4 h-8 bg-white rounded"></div>
            <div class="w-6 h-6 bg-white rounded-full"></div>
            <div class="w-8 h-4 bg-white rounded"></div>
            <div class="w-6 h-6 bg-white rounded"></div>
            <div class="w-4 h-8 bg-white rounded"></div>
            <div class="w-6 h-6 bg-white rounded-full"></div>
          </div>
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20 lg:py-24 relative z-10 flex items-center min-h-[80vh]"
      >
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Content -->
            <div class="lg:col-span-8 text-center lg:text-left">
              <header>
                <h1
                  class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight"
                >
                  <span class="block text-white">Online Marketing</span>
                  <span
                    class="block bg-gradient-to-r from-orange-400 via-yellow-400 to-orange-400 bg-clip-text text-transparent animate-gradient-x"
                  >
                    Agentur
                  </span>
                  <span
                    class="block text-white/90 text-2xl md:text-3xl font-normal"
                  >
                    Regensburg
                  </span>
                </h1>
              </header>

              <div
                class="bg-white/10 backdrop-blur-md rounded-2xl p-6 md:p-8 border border-white/20 mb-8"
              >
                <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
                  <strong class="text-white"
                    >Ganzheitliches Online Marketing aus Regensburg</strong
                  > –
                  <em class="text-orange-300">Google Ads</em>,
                  <em class="text-orange-300">Performance Marketing</em> und
                  <em class="text-orange-300">Conversion-Optimierung</em> für messbare
                  Erfolge und nachhaltiges Wachstum.
                </p>
              </div>

              <!-- CTA Buttons -->
              <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a
                  href="/kontakt"
                  class="group relative px-8 py-4 bg-gradient-to-r from-orange-500 to-yellow-500 hover:from-yellow-500 hover:to-orange-500 text-white font-bold text-lg rounded-2xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 shadow-2xl hover:shadow-orange-500/25 overflow-hidden text-center"
                  aria-label="Online Marketing Strategie entwickeln"
                >
                  <span
                    class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
                  ></span>
                  <span class="relative z-10">Kostenlose Erstberatung</span>
                </a>

                <a
                  href="#marketing-services"
                  class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-1 text-center"
                >
                  <span class="flex items-center justify-center gap-2">
                    Marketing Services entdecken
                    <svg
                      class="w-5 h-5 group-hover:translate-y-1 transition-transform duration-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                  </span>
                </a>
              </div>

              <!-- Trust Indicators -->
              <div
                class="flex flex-wrap justify-center lg:justify-start gap-6 text-white/70 text-sm"
              >
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium">Google Partner</span>
                </span>
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium">ROI-fokussiert</span>
                </span>
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium">Messbare Erfolge</span
                  >
                </span>
              </div>
            </div>

            <!-- Visual Element - Professional Marketing Image -->
            <div class="lg:col-span-4 relative">
              <div class="relative group">
                <!-- Image Container with Effects -->
                <div
                  class="relative rounded-3xl overflow-hidden shadow-2xl transform group-hover:scale-105 transition-transform duration-700"
                >
                  <!-- Decorative Frame -->
                  <div
                    class="absolute inset-0 bg-gradient-to-br from-emerald-500/20 to-teal-500/20 z-10"
                  >
                  </div>

                  <!-- Main Image -->
                  <img
                    src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=1000&fit=crop&crop=entropy"
                    alt="Online Marketing Dashboard - Performance Metriken und Analytics"
                    class="w-full h-auto object-cover animate-float"
                    loading="lazy"
                    width="800"
                    height="1000"
                  />

                  <!-- Overlay with Stats -->
                  <div
                    class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-6 z-20"
                  >
                    <div class="grid grid-cols-3 gap-4 text-white">
                      <div class="text-center">
                        <div class="text-2xl font-bold text-orange-400">
                          +250%
                        </div>
                        <div class="text-xs uppercase tracking-wider">
                          ROI Steigerung
                        </div>
                      </div>
                      <div class="text-center">
                        <div class="text-2xl font-bold text-yellow-400">
                          500+
                        </div>
                        <div class="text-xs uppercase tracking-wider">
                          Kampagnen
                        </div>
                      </div>
                      <div class="text-center">
                        <div class="text-2xl font-bold text-green-400">98%</div>
                        <div class="text-xs uppercase tracking-wider">
                          Zufriedenheit
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Decorative Elements -->
                <div
                  class="absolute -bottom-2 -left-2 w-20 h-20 bg-gradient-to-br from-emerald-400/30 to-teal-400/30 rounded-full blur-2xl"
                >
                </div>
                <div
                  class="absolute -top-2 -left-2 w-16 h-16 bg-gradient-to-br from-cyan-400/30 to-blue-400/30 rounded-full blur-2xl"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="marketing-services" class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Unsere <span
              class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent"
              >Online Marketing Services</span
            >
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Ganzheitliche Digital Marketing Strategien für Ihren Erfolg
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto"
        >
          <!-- Google Ads / SEA -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Google Ads / SEA
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Professionelle Google Ads Kampagnen</strong> für sofortige
              Sichtbarkeit. Search, Shopping, Display und YouTube Ads mit maximaler
              Performance.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                Search Ads
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                Shopping Ads
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                YouTube Ads
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">
              ab 1.000€/Monat
            </div>
          </article>

          <!-- Social Media Ads -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m9.032 4.026a9.001 9.001 0 01-7.432 0m9.032-4.026A9.001 9.001 0 0112 3c-4.474 0-8.268 3.12-9.032 7.326m0 0A9.001 9.001 0 0012 21c4.474 0 8.268-3.12 9.032-7.326"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Social Media Ads
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Zielgerichtete Social Media Kampagnen</strong> auf Facebook,
              Instagram, LinkedIn und TikTok. Maximale Reichweite und Engagement.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-cyan-500 rounded-full"></span>
                Facebook & Instagram Ads
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-cyan-500 rounded-full"></span>
                LinkedIn Ads
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-cyan-500 rounded-full"></span>
                TikTok Ads
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 800€/Monat</div>
          </article>

          <!-- Content Marketing -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Content Marketing
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Hochwertiger Content</strong> der begeistert und konvertiert.
              Blog-Artikel, Infografiken, Videos und E-Books für mehr Traffic.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-purple-500 rounded-full"></span>
                Content-Strategie
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-purple-500 rounded-full"></span>
                Blog & Artikel
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-purple-500 rounded-full"></span>
                Video-Content
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 600€/Monat</div>
          </article>

          <!-- E-Mail Marketing -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-yellow-500 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              E-Mail Marketing
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Automatisierte E-Mail Kampagnen</strong> für höhere Conversion.
              Newsletter, Automation und personalisierte Customer Journeys.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-yellow-500 rounded-full"></span>
                Newsletter
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-yellow-500 rounded-full"></span>
                Marketing Automation
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-yellow-500 rounded-full"></span>
                Segmentierung
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 500€/Monat</div>
          </article>

          <!-- Conversion Optimierung -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Conversion Optimierung
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Maximale Conversion-Rate</strong> durch A/B-Testing, Funnel-Optimierung
              und User Experience Verbesserungen.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                A/B-Testing
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                Funnel-Optimierung
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                Landing Pages
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 800€/Monat</div>
          </article>

          <!-- Analytics & Reporting -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-red-500 to-pink-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Analytics & Reporting
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Datengetriebene Insights</strong> und transparente Reports.

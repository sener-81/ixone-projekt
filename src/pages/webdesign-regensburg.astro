---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";
import TechStack from "../components/TechStack.astro";
import { Image } from "astro:assets";
import { galerieData } from "../data/galerieData";
import { areaServedFull } from "../data/structuredData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://ixone.de/webdesign-regensburg/#service",
  name: "Webdesign Regensburg",
  description:
    "Professionelles Webdesign aus Regensburg. Moderne, responsive Websites die konvertieren und bei Google ranken.",
  provider: { "@id": "https://ixone.de/#organization" },
  telephone: "+4994015338873",
  areaServed: areaServedFull,
  serviceType: [
    "Webdesign",
    "Webentwicklung",
    "UX/UI Design",
    "Responsive Webdesign",
  ],
  offers: {
    "@type": "Offer",
    availability: "https://schema.org/InStock",
    url: "https://ixone.de/webdesign-regensburg/",
    priceSpecification: {
      "@type": "PriceSpecification",
      minPrice: 2500,
      priceCurrency: "EUR",
      valueAddedTaxIncluded: false,
    },
  },
};

const faqs = [
  {
    q: "Was kostet professionelles Webdesign in Regensburg?",
    a: "Eine Unternehmenswebsite startet ab 2.500 €, ein Onepager ab 1.200 €. Der genaue Preis hängt von Funktionsumfang, Seitenanzahl und gewünschten Integrationen ab. Eine vollständige Übersicht mit Richtwerten für alle Leistungen finden Sie auf unserer Preisseite. Nach einem kostenlosen Erstgespräch erhalten Sie ein verbindliches Angebot ohne versteckte Kosten.",
  },
  {
    q: "Wie lange dauert ein Webdesign-Projekt bei ixOne?",
    a: "Standard-Websites: 4–6 Wochen. Komplexere Projekte mit Shop, Buchungssystem oder individuellen Funktionen: 8–12 Wochen. Nach dem Kickoff erhalten Sie einen detaillierten Projektplan mit klaren Meilensteinen.",
  },
  {
    q: "Ist das Webdesign responsive und mobile-optimiert?",
    a: "Ja, alle Websites sind responsive und mobile-first entwickelt. Sie funktionieren auf Desktop, Tablet und Smartphone mit optimaler Benutzerfreundlichkeit und schnellen Ladezeiten.",
  },
  {
    q: "Was macht eine professionelle Webdesign Agentur in Regensburg?",
    a: "Eine gute Webdesign Agentur übernimmt mehr als nur das Design. ixOne liefert Strategie, UX/UI Design, technische Entwicklung, SEO-Integration, DSGVO-Konformität und Hosting – koordiniert über einen persönlichen Ansprechpartner.",
  },
  {
    q: "Mit welchem CMS arbeitet ihr?",
    a: "Je nach Anforderung setzen wir auf WordPress für inhaltsgetriebene Projekte oder Astro für maximale Performance. Beide Systeme ermöglichen Ihnen eine einfache Content-Pflege ohne technische Vorkenntnisse.",
  },
  {
    q: "Sind SEO und Performance wirklich inklusive?",
    a: "Ja – ohne Wenn und Aber. Technisches SEO, Schema.org Markup, Core Web Vitals Optimierung, saubere URL-Strukturen und Pagespeed-Optimierung sind bei jedem Projekt dabei. Wir übergeben keine Website mit schlechten Scores.",
  },
  {
    q: "Warum Astro statt WordPress?",
    a: "Astro generiert statische HTML-Seiten – das Ergebnis sind PageSpeed-Scores über 90, deutlich schnellere Ladezeiten und bessere Google-Rankings. Für Content-lastige Projekte mit häufigen Updates bleibt WordPress eine sehr gute Wahl. Wir empfehlen das Richtige für Ihren konkreten Fall.",
  },
  {
    q: "Übernehmt ihr auch Wartung und Hosting?",
    a: "Ja. Unsere Wartungspakete umfassen regelmäßige Updates, Backups, Performance-Monitoring und technischen Support. Hosting empfehlen oder stellen wir auf Wunsch bereit – mit deutschen Servern und DSGVO-Konformität.",
  },
  {
    q: "Wie messe ich ob meine Website erfolgreich ist?",
    a: "Die relevantesten KPIs für Unternehmenswebsites sind: organischer Traffic aus Google, Conversion-Rate (Anfragen/Käufe), Core Web Vitals Score, Absprungrate und Keyword-Rankings für Ihre Zielregion. ixOne richtet Tracking ein und liefert regelmäßige Reports.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/galerie/*.webp",
  { eager: true },
);

const galerieItems = galerieData
  .map((item, index) => {
    const path = `/src/assets/galerie/${item.file}`;
    const module = imageFiles[path];
    if (!module) return null;
    return {
      image: module.default,
      alt: item.alt,
      caption: item.caption,
      index,
    };
  })
  .filter(Boolean) as {
  image: ImageMetadata;
  alt: string;
  caption: string;
  index: number;
}[];

const heroBadges = [
  {
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    label: "DSGVO-konform",
  },
  { icon: "M13 10V3L4 14h7v7l9-11h-7z", label: "PageSpeed 90+" },
  {
    icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
    label: "Mobile-first",
  },
  {
    icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
    label: "SEO inklusive",
  },
];

const heroStats = [
  { value: "ab 2.500 €", label: "Unternehmenswebsite" },
  { value: "4–8 Wochen", label: "Bis zum Launch" },
  { value: "90+ Score", label: "PageSpeed Ziel" },
  { value: "seit 2007", label: "Erfahrung" },
];

const leistungen = [
  {
    icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
    title: "Responsive Webdesign",
    desc: "<strong>Mobile-first entwickelt</strong> – perfekte Darstellung auf jedem Gerät. Google bewertet Mobilfreundlichkeit als direkten Rankingfaktor.",
  },
  {
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    title: "PageSpeed & Core Web Vitals",
    desc: "<strong>Score 90+ als Ziel</strong> durch modernen Astro-Tech-Stack und optimierte Assets. Schnelle Ladezeiten bedeuten bessere Rankings und höhere Conversion.",
  },
  {
    icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
    title: "Technisches SEO",
    desc: "<strong>SEO von Grund auf eingebaut</strong>: Schema.org Markup, Meta-Tags, saubere URL-Struktur und interne Verlinkung – kein nachträgliches Flickwerk.",
  },
  {
    icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
    title: "UX/UI & Conversion Design",
    desc: "<strong>Design das verkauft</strong> – strategische CTAs, klare User Journeys und conversion-optimierte Layouts für maximale Anfragen und Abschlüsse.",
  },
  {
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z",
    title: "CMS & Content-Pflege",
    desc: "<strong>WordPress oder Headless CMS</strong> – Sie aktualisieren Inhalte selbst, ohne Programmierkenntnisse. Einfach, schnell, unabhängig.",
  },
  {
    icon: "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z",
    title: "Wartung & Weiterentwicklung",
    desc: "<strong>Langfristiger Partner</strong> statt einmaliger Dienstleister – Updates, Backups, Performance-Monitoring und Weiterentwicklung nach Ihrem Bedarf.",
  },
];

const prozessSchritte = [
  {
    step: "1",
    title: "Strategie & Konzeption",
    desc: "Wir analysieren Ihre Ziele, Zielgruppe und Wettbewerber. Das Ergebnis: eine klare Content-Strategie, Seitenstruktur und SEO-Roadmap – bevor eine Zeile Code geschrieben wird.",
  },
  {
    step: "2",
    title: "UX/UI Design",
    desc: "Wireframes, interaktive Prototypen und finales Design – abgestimmt auf Ihre Corporate Identity. Jedes Element ist auf Usability und Conversion optimiert, nicht nur auf Optik.",
  },
  {
    step: "3",
    title: "Entwicklung & SEO-Integration",
    desc: "Saubere Entwicklung mit modernem Tech-Stack, CMS-Integration und eingebautem technischen SEO – Schema.org, Core Web Vitals, Lazy Loading und mehr. Standard, kein Extra.",
  },
  {
    step: "4",
    title: "Launch & Qualitätssicherung",
    desc: "Umfassende Tests auf allen Geräten: PageSpeed, DSGVO-Konformität, Funktionalität und mobile Darstellung. Erst wenn alles stimmt, geht Ihre Website live.",
  },
];
---

<Layout
  title="Webdesign Regensburg | Websites die ranken | ixOne"
  description="Professionelles Webdesign aus Regensburg: responsive, SEO-optimierte Websites ab 2.500 €. Mobile-first und schnell. Jetzt beraten lassen."
  canonical="https://ixone.de/webdesign-regensburg/"
  structuredData={[serviceSchema, faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative min-h-[75vh] bg-gradient-to-br from-cyan-900 via-blue-800 to-indigo-900 text-white overflow-hidden flex items-center"
      aria-label="Webdesign Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-cyan-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div
          class="h-full w-full"
          style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10 w-full"
      >
        <div class="max-w-5xl mx-auto text-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
          >
            <span
              class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
              aria-hidden="true"></span>
            Digitalagentur aus Regensburg · seit 2007
          </span>

          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            <span class="block text-white">Professionelles</span>
            <span class="gradient-text-brand">Webdesign</span>
            <span
              class="block text-white/85 text-2xl md:text-3xl font-normal mt-2"
            >
              für Unternehmen in Regensburg & Bayern
            </span>
          </h1>

          <p
            class="text-lg md:text-xl text-gray-200 leading-relaxed mb-8 max-w-3xl mx-auto"
          >
            Websites die <strong class="text-white">bei Google ranken</strong>,
            Besucher überzeugen und{" "}
            <em class="text-brand-orange">messbar mehr Kunden gewinnen</em> – mit
            modernem Tech-Stack, PageSpeed 90+ und SEO von Anfang an.
          </p>

          <div class="flex flex-wrap justify-center gap-3 mb-8">
            {
              heroBadges.map((badge) => (
                <span class="flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-sm font-medium text-white/90">
                  <svg
                    class="w-4 h-4 text-green-400 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={badge.icon}
                    />
                  </svg>
                  {badge.label}
                </span>
              ))
            }
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
            <a
              href={CALENDLY}
              target="_blank"
              rel="noopener"
              data-calendly-popup-url={CALENDLY}
              class="cta-button-primary text-center"
              aria-label="Kostenloses Webdesign Erstgespräch vereinbaren"
            >
              <span>Kostenloses Erstgespräch</span>
            </a>
            <a
              href="#webdesign-galerie"
              class="cta-button-secondary text-center"
            >
              <span class="flex items-center justify-center gap-2">
                Projekte ansehen
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
              </span>
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto">
            {
              heroStats.map((stat) => (
                <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-4 text-center">
                  <div class="text-lg md:text-xl font-bold text-white leading-tight">
                    {stat.value}
                  </div>
                  <div class="text-xs text-white/60 font-medium mt-1">
                    {stat.label}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      id="webdesign-leistungen"
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="leistungen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <h2
            id="leistungen-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Unsere <span class="gradient-text-brand-inline">Webdesign</span> Leistungen
          </h2>
          <p class="text-xl text-gray-600">
            Begleitung von der ersten Idee bis zum erfolgreichen Launch
          </p>
        </div>
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto"
        >
          {
            leistungen.map((feature) => (
              <article class="group text-center p-8 bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
                <div class="w-16 h-16 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
                  <svg
                    class="w-8 h-8 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={feature.icon}
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  {feature.title}
                </h3>
                <p
                  class="text-gray-600 leading-relaxed"
                  set:html={feature.desc}
                />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="webdesign-intro-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div
            class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"
          >
            <div>
              <h2
                id="webdesign-intro-heading"
                class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
              >
                Was macht gutes <span class="gradient-text-brand-inline"
                  >Webdesign in Regensburg</span
                > aus?
              </h2>
              <div class="space-y-5 text-gray-600 text-lg leading-relaxed">
                <p>
                  Modernes Webdesign ist weit mehr als ein ansprechendes Layout.
                  Als <strong class="text-gray-900"
                    >Webdesign Agentur in Regensburg</strong
                  > entwickeln wir digitale Auftritte, die drei Dinge gleichzeitig
                  leisten: bei Google ranken, Vertrauen aufbauen und Besucher in Kunden
                  verwandeln.
                </p>
                <p>
                  Jede Website, die ixOne entwickelt, zielt auf einen{" "}
                  <strong class="text-gray-900">PageSpeed Score von 90+</strong
                  >, ist vollständig <strong class="text-gray-900"
                    >mobile-first</strong
                  > gebaut und enthält technisches SEO von Anfang an. Das ist kein
                  Bonus – das ist unser Standard.
                </p>
                <p>
                  Als <strong class="text-gray-900"
                    >Digitalagentur direkt in Regensburg</strong
                  > kennen wir den lokalen Markt, die regionalen Suchbegriffe und
                  die Anforderungen bayerischer Unternehmen – vom Handwerksbetrieb
                  bis zum mittelständischen Dienstleister.
                </p>
              </div>
              <ul class="mt-8 space-y-3" role="list">
                {
                  [
                    "Individuelles Design – keine Templates, keine Kompromisse",
                    "Astro-Technologie für PageSpeed 90+ und Top-Rankings",
                    "Persönlicher Ansprechpartner – kein Ticket-System",
                    "Transparente Festpreise ohne versteckte Kosten",
                  ].map((item) => (
                    <li class="flex items-start gap-3">
                      <span
                        class="flex-shrink-0 w-6 h-6 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center mt-0.5"
                        aria-hidden="true"
                      >
                        <svg
                          class="w-3.5 h-3.5 text-white"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                            clip-rule="evenodd"
                          />
                        </svg>
                      </span>
                      <span class="text-gray-700 font-medium">{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="grid grid-cols-2 gap-4 md:gap-6">
              <div
                class="bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl p-6 md:p-8 text-white text-center shadow-lg"
              >
                <div class="text-3xl md:text-4xl font-bold leading-none mb-1">
                  4–8<span class="text-base font-bold opacity-80 ml-1">Wo.</span
                  >
                </div>
                <div class="text-sm md:text-base opacity-90 font-medium mt-2">
                  Bis zum Launch
                </div>
              </div>
              <div
                class="bg-gradient-to-br from-orange-500 to-yellow-500 rounded-2xl p-6 md:p-8 text-white text-center shadow-lg"
              >
                <div class="text-3xl md:text-4xl font-bold leading-none mb-1">
                  90+<span class="text-base font-bold opacity-80 ml-1">Pts</span
                  >
                </div>
                <div class="text-sm md:text-base opacity-90 font-medium mt-2">
                  PageSpeed Score
                </div>
              </div>
              <div
                class="bg-gradient-to-br from-green-500 to-teal-600 rounded-2xl p-6 md:p-8 text-white text-center shadow-lg"
              >
                <div class="text-2xl md:text-3xl font-bold leading-none mb-1">
                  ab 2.500<span class="text-base font-bold opacity-80 ml-1"
                    >€</span
                  >
                </div>
                <div class="text-sm md:text-base opacity-90 font-medium mt-2">
                  Unternehmenswebsite
                </div>
              </div>
              <div
                class="bg-gradient-to-br from-purple-500 to-indigo-600 rounded-2xl p-6 md:p-8 text-white text-center shadow-lg"
              >
                <div class="text-3xl md:text-4xl font-bold leading-none mb-1">
                  100%
                </div>
                <div class="text-sm md:text-base opacity-90 font-medium mt-2">
                  DSGVO-konform
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="webdesign-wissen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="webdesign-wissen-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Webdesign Regensburg – <span class="gradient-text-brand-inline"
                >Was Sie wissen sollten</span
              >
            </h2>
            <p class="text-xl text-gray-600">
              Von aktuellen Trends bis zur richtigen Agenturwahl – fundiertes
              Wissen für Ihren digitalen Erfolg
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <article
              class="bg-gradient-to-br from-gray-50 to-white rounded-2xl p-8 border border-gray-100 shadow-md hover:shadow-lg transition-shadow duration-300"
            >

<script>
  function animateCounter(
    id: string,
    target: number,
    duration: number,
    decimals = 0,
  ) {
    const el = document.getElementById(id);
    if (!el) return;
    const start = performance.now();
    const update = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      const value = ease * target;
      el.textContent =
        decimals > 0 ? value.toFixed(decimals) : Math.floor(value).toString();
      if (progress < 1) requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
  }

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const heroSection = document.querySelector(
    '[aria-label="SEO Agentur Regensburg Hero"]',
  );
  if (heroSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const d = prefersReducedMotion ? 0 : 1;
            animateCounter("traffic-counter", 147, 2000 * d);
            animateCounter("keywords-counter", 89, 2200 * d);
            animateCounter("conversion-counter", 3.2, 1800 * d, 1);
            animateCounter("speed-counter", 94, 2400 * d);
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    observer.observe(heroSection);
  }

  const auditsEl = document.getElementById("active-audits");
  if (auditsEl && !prefersReducedMotion) {
    setInterval(() => {
      const next = Math.floor(Math.random() * 3) + 2;
      if (next.toString() !== auditsEl.textContent) {
        auditsEl.style.opacity = "0";
        setTimeout(() => {
          auditsEl.textContent = next.toString();
          auditsEl.style.opacity = "1";
        }, 300);
      }
    }, 8000);
    auditsEl.style.transition = "opacity 0.3s ease";
  }

  document.querySelectorAll(".faq-item").forEach((details) => {
    const body = details.querySelector(".faq-body") as HTMLElement | null;
    if (!body) return;
    body.style.overflow = "hidden";
    body.style.transition = "max-height 0.35s ease, opacity 0.25s ease";
    if ((details as HTMLDetailsElement).open) {
      body.style.maxHeight = "none";
      body.style.opacity = "1";
    } else {
      body.style.maxHeight = "0px";
      body.style.opacity = "0";
    }
    details.addEventListener("toggle", () => {
      if ((details as HTMLDetailsElement).open) {
        body.style.maxHeight = `${body.scrollHeight}px`;
        body.style.opacity = "1";
        const onEnd = (e: TransitionEvent) => {
          if (e.propertyName === "max-height") {
            body.style.maxHeight = "none";
            body.removeEventListener("transitionend", onEnd);
          }
        };
        body.addEventListener("transitionend", onEnd);
      } else {
        body.style.maxHeight = `${body.scrollHeight}px`;
        requestAnimationFrame(() => {
          body.style.maxHeight = "0px";
          body.style.opacity = "0";
        });
      }
    });
  });
</script>

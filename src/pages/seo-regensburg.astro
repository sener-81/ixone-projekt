const faqs = [
  {
    q: "Was macht eine SEO Agentur in Regensburg?",
    a: "Eine professionelle SEO Agentur in Regensburg übernimmt die ganzheitliche Suchmaschinenoptimierung: technisches SEO, OnPage-Optimierung, Content-Erstellung, Linkaufbau und Local SEO. iXone entwickelt individuelle Strategien für mehr Sichtbarkeit bei Google und messbar mehr qualifizierte Anfragen.",
  },
  {
    q: "Wie lange dauert SEO bis erste Ergebnisse sichtbar sind?",
    a: "Erste Verbesserungen bei Rankings und Traffic sind nach 3–6 Monaten messbar. Nachhaltige, signifikante Ergebnisse zeigen sich nach 6–12 Monaten. SEO ist eine langfristige Investition – im Gegensatz zu Google Ads bleibt der Effekt auch ohne laufendes Budget bestehen.",
  },
  {
    q: "Was kostet professionelle SEO-Betreuung in Regensburg?",
    a: "Die Kosten hängen von Umfang, Branche und Wettbewerb ab. Eine monatliche SEO-Betreuung startet bei iXone ab 499 €. Nach einer kostenlosen Erstberatung erhalten Sie ein transparentes Angebot ohne versteckte Kosten und ohne Mindestlaufzeiten.",
  },
  {
    q: "Was ist der Unterschied zwischen SEO und Google Ads?",
    a: "Google Ads liefert sofortige Sichtbarkeit durch bezahlte Anzeigen – aber nur solange das Budget läuft. SEO baut nachhaltige organische Rankings auf, die dauerhaft Traffic generieren. Langfristig ist SEO die kosteneffizientere Strategie, kurzfristig ergänzen sich beide Kanäle optimal.",
  },
  {
    q: "Was ist Local SEO und warum ist es für Regensburger Unternehmen wichtig?",
    a: "Local SEO optimiert Ihre Sichtbarkeit bei lokalen Suchanfragen wie 'Steuerberater Regensburg' oder 'Handwerker in meiner Nähe'. Dazu gehören Google Business Profile Optimierung, lokale Keywords, Bewertungsmanagement und lokale Backlinks. Für Unternehmen mit regionalem Kundenstamm ist Local SEO oft der effektivste SEO-Hebel.",
  },
  {
    q: "Was sind Core Web Vitals und warum sind sie für SEO relevant?",
    a: "Core Web Vitals sind Googles Messgrößen für Nutzererfahrung: Ladegeschwindigkeit (LCP), visuelle Stabilität (CLS) und Interaktivität (INP). Seit 2021 sind sie offizieller Google-Rankingfaktor. iXone nutzt moderne Technologien wie Astro für Scores über 90 im grünen Bereich.",
  },
  {
    q: "Wie messe ich den Erfolg von SEO-Maßnahmen?",
    a: "Wichtige SEO-KPIs: organischer Traffic, Keyword-Rankings, Sichtbarkeitsindex, Conversion-Rate und Kosten pro Lead. iXone richtet professionelles Tracking ein und liefert monatliche Reports mit klaren Zahlen – transparent und nachvollziehbar.",
  },
  {
    q: "Kann iXone auch einen Website-Relaunch SEO-sicher begleiten?",
    a: "Ja. Ein Relaunch ohne SEO-Begleitung kann zu massiven Traffic-Verlusten führen. iXone sorgt für korrekte URL-Weiterleitungen, Erhalt bestehender Rankings und technisch saubere Migration – damit Ihr Relaunch Ihre SEO-Performance verbessert statt beschädigt.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const services = [

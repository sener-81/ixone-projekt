const prozessSchritte = [
  {
    step: "1",
    title: "SEO Audit & Analyse",
    desc: "Umfassende Bestandsaufnahme: technische Fehler, Keyword-Gaps, Backlink-Profil und Konkurrenz-Analyse. Das Ergebnis ist eine klare Prioritätenliste mit den größten Hebeln für Ihre Rankings.",
  },
  {
    step: "2",

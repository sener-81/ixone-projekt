---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import CTA from "../components/CTA.astro";
import { Image } from "astro:assets";
import aboutImage from "../assets/ixone-online-marketing-regensburg.webp";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const GRUENDUNGSJAHR = 2007;
const jahreErfahrung = new Date().getFullYear() - GRUENDUNGSJAHR;

const faqs = [
  {
    q: "Was macht eine Digitalagentur in Regensburg konkret für meine Website?",
    a: "Wir übernehmen alles – von der Konzeption über Webentwicklung und SEO bis zur laufenden Pflege. Als Full-Service-Agentur bieten wir zusätzlich Google Ads, Social Media und Conversion-Optimierung, um aus Besuchern zahlende Kunden zu machen.",
  },
  {
    q: "Wie kann Online-Marketing meinen Umsatz steigern?",
    a: "Durch die Kombination aus SEO, Google Ads und Social Ads erhöhen wir die Sichtbarkeit Ihrer Marke gezielt. Wir optimieren Landingpages für maximale Conversion und liefern transparente Berichte – damit Sie genau sehen, was Ihr Budget bringt.",
  },
  {
    q: "Wie lange dauert die Entwicklung einer neuen Website?",
    a: "Je nach Umfang dauert es 4 bis 10 Wochen. Nach einer kostenlosen Erstberatung erhalten Sie ein konkretes Angebot mit realistischem Zeitplan – ohne versteckte Kosten.",
  },
  {
    q: "Bietet ixOne auch Local SEO für Regensburg an?",
    a: "Ja, Local SEO ist eine unserer Kernkompetenzen. Wir optimieren Ihre Website für Suchanfragen aus Regensburg und dem Landkreis – inklusive Google Business Profile, lokale Backlinks und standortbezogene Keywords.",
  },
  {
    q: "Was kostet eine professionelle Website bei ixOne?",
    a: "Die Kosten hängen vom Funktionsumfang ab. Einfache Unternehmenswebsites starten ab ca. 2.500 €. Wir bieten transparente Preise ohne Mindestlaufzeiten – sprechen Sie uns einfach an.",
  },
  {
    q: "Welche Technologien nutzt ixOne – Astro oder WordPress?",
    a: "Wir wählen die Technologie passend zum Projekt. Astro eignet sich für besonders schnelle, schlanke Websites mit starkem Performance-Fokus. WordPress bleibt für inhaltsgetriebene Projekte mit häufiger Redaktion eine sinnvolle Option. Entscheidend ist, was zu Ihren Zielen passt.",
  },
  {
    q: "Nutzt ixOne KI-Tools zur Optimierung von Kampagnen und Websites?",
    a: `Ja – wir setzen KI-gestützte Tools für SEO-Analyse, Content-Optimierung und Kampagnensteuerung ein. KI ersetzt bei uns nicht die persönliche Beratung, sondern ergänzt sie. Sie profitieren von modernster Technologie kombiniert mit der Erfahrung aus über 500 Projekten seit ${GRUENDUNGSJAHR}.`,
  },
  {
    q: "Wie läuft die Zusammenarbeit mit ixOne konkret ab?",
    a: "Bei ixOne haben Sie immer einen direkten Ansprechpartner – keinen Callcenter-Mitarbeiter, keine wechselnden Projektmanager. Wir starten mit einer kostenlosen Erstberatung, entwickeln gemeinsam ein Konzept und halten Sie transparent auf dem Laufenden. Klare Kommunikation und messbare Ergebnisse statt Agentur-Blabla.",
  },
  {
    q: "Wie unterscheidet sich ixOne von anderen Digitalagenturen in Regensburg?",
    a: `Drei Dinge machen den Unterschied: Erstens die passende Technologie für Ihr Ziel – von schnellen Astro-Websites bis zu gut pflegbaren CMS-Lösungen. Zweitens ${jahreErfahrung} Jahre Erfahrung seit ${GRUENDUNGSJAHR}. Drittens persönlicher Service – als inhabergeführte Agentur sind wir direkt erreichbar und kennen unsere Kunden beim Namen.`,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const vorteile = [
  {
    title: "Schnelle Websites",
    desc: "Astro-Technologie für PageSpeed 90+ und bessere Google-Rankings",
  },
  {
    title: "Local SEO Regensburg",
    desc: "Mehr Sichtbarkeit für Ihre Kunden direkt vor Ort",
  },
  {
    title: "Google Ads & Social Ads",
    desc: "Kampagnen die konvertieren – nicht nur klicken",
  },
  {
    title: "Persönlicher Ansprechpartner",
    desc: "Kein Callcenter, direkte Kommunikation auf Augenhöhe",
  },
];
---

<Layout
  title="ixOne – Digitalagentur Regensburg | Webdesign & SEO"
  description={`Ihre Digitalagentur aus Regensburg – Webdesign, SEO & Online-Marketing. Seit ${GRUENDUNGSJAHR} über 500 Projekte. Kostenlose Erstberatung sichern.`}
  canonical="https://ixone.de/"
  structuredData={[faqSchema]}
>
  <div class="bg-white">
    <Hero />
  </div>

  <section
    class="py-20 md:py-28 lg:py-32 bg-white"
    aria-labelledby="about-heading"
  >
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
        >
          <div class="relative overflow-hidden rounded-3xl group">
            <Image
              src={aboutImage}
              alt="ixOne Digitalagentur Regensburg – Arbeit an Webdesign und SEO Projekten"
              width={600}
              height={600}
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-3xl shadow-2xl transition-transform duration-500 group-hover:scale-105"
            />

            <div
              class="absolute bottom-6 left-6 bg-white/95 backdrop-blur-sm rounded-2xl px-5 py-4 shadow-xl"
            >
              <div class="flex items-center gap-4">
                <div class="text-center">
                  <p class="text-2xl font-bold text-gray-900">500+</p>
                  <p class="text-xs text-gray-500 font-medium">Projekte</p>
                </div>
                <div class="w-px h-10 bg-gray-200"></div>
                <div class="text-center">
                  <p class="text-2xl font-bold text-gray-900">
                    {GRUENDUNGSJAHR}
                  </p>
                  <p class="text-xs text-gray-500 font-medium">seit</p>
                </div>
                <div class="w-px h-10 bg-gray-200"></div>
                <div class="text-center">
                  <p class="text-2xl font-bold text-brand-orange">2</p>
                  <p class="text-xs text-gray-500 font-medium">Standorte</p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <span
              class="inline-flex items-center px-4 py-2 rounded-full bg-gradient-to-r from-brand-orange to-yellow-500 text-white text-sm font-semibold mb-6"
            >
              <span class="w-2 h-2 bg-white/60 rounded-full mr-2"></span>
              Ihre Digitalagentur aus Regensburg
            </span>

            <h2
              id="about-heading"
              class="text-3xl md:text-4xl font-bold mb-6 text-gray-900 leading-tight"
            >
              Seit {GRUENDUNGSJAHR} für Ihren<br />
              <span class="text-brand-orange">digitalen Erfolg</span>
            </h2>

            <p class="text-lg text-gray-700 mb-4 leading-relaxed">
              Über 500 Projekte für Unternehmen aus Regensburg, dem Landkreis
              und dem gesamten deutschsprachigen Raum – und es werden mehr.
              Unsere Kunden vertrauen ixOne, weil wir nicht nur Websites bauen,
              sondern digitale Vertriebskanäle entwickeln, die messbar mehr
              Kunden bringen.
            </p>
            <p class="text-gray-600 mb-8 leading-relaxed">
              Inhabergeführt, lokal verwurzelt, technisch auf dem neuesten
              Stand: Wir bieten{" "}
              <a
                href="/webdesign-regensburg/"
                class="font-medium text-brand-orange hover:underline"
                >Webdesign</a
              >,{" "}
              <a
                href="/seo-regensburg/"
                class="font-medium text-brand-orange hover:underline">SEO</a
              >,{" "}
              <a
                href="/online-marketing-regensburg/"
                class="font-medium text-brand-orange hover:underline"
                >Online-Marketing</a
              > und{" "}
              <a
                href="/social-media-marketing-regensburg/"
                class="font-medium text-brand-orange hover:underline"
                >Social Media</a
              >{" "} und{" "}
              <a
                href="/websitepflege-regensburg/"
                class="font-medium text-brand-orange hover:underline"
                >Websitepflege</a
              >{" "} – abgestimmt aufeinander, persönlich betreut, mit transparenten
              Ergebnissen.
            </p>
            <p class="text-gray-600 mb-8 leading-relaxed">
              Wie das in der Praxis aussieht, zeigen unsere{" "}
              <a
                href="/referenzen/"
                class="font-medium text-brand-orange hover:underline"
                >Referenzen</a
              >. Wer dahintersteckt, lesen Sie{" "}
              <a
                href="/ueber-uns/"
                class="font-medium text-brand-orange hover:underline"
                >über uns</a
              > – und eine erste Orientierung zu den Kosten finden Sie bei den{
                " "
              }
              <a
                href="/preise/"
                class="font-medium text-brand-orange hover:underline">Preisen</a
              >.
            </p>

            <ul class="space-y-3 mb-8">
              {
                vorteile.map((item) => (
                  <li class="flex items-start gap-3 text-gray-900">
                    <svg
                      class="w-5 h-5 flex-shrink-0 mt-1 text-brand-orange"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    <span>
                      <strong class="font-semibold">{item.title}</strong>
                      <span class="text-gray-600"> – {item.desc}</span>
                    </span>
                  </li>
                ))
              }
            </ul>

            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={CALENDLY}
                target="_blank"
                rel="noopener"
                data-calendly-popup-url={CALENDLY}
                class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white font-semibold rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl"
                aria-label="Kostenlosen Beratungstermin online oder vor Ort vereinbaren"
              >
                Termin vereinbaren
              </a>
              <a
                href="/kontakt/"
                class="group inline-flex items-center justify-center px-8 py-4 text-gray-700 font-semibold rounded-full border-2 border-gray-200 hover:border-transparent hover:[background:linear-gradient(white,white)_padding-box,linear-gradient(to_right,var(--color-brand-orange),#eab308)_border-box] transition-all duration-300"
                aria-label="Zur Kontaktseite von ixOne Digitalagentur Regensburg"
              >
                <span
                  class="group-hover:bg-gradient-to-r group-hover:from-brand-orange group-hover:to-yellow-500 group-hover:bg-clip-text group-hover:text-transparent transition-colors duration-300"
                >
                  Kontakt aufnehmen
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Services />

  <WhyChooseUs />

  <GoogleReviews />

  <section
    class="py-20 md:py-28 lg:py-32 bg-gray-50"
    aria-labelledby="faq-heading"
  >
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16 md:mb-20">
          <span
            class="inline-flex items-center px-4 py-2 rounded-full bg-gradient-to-r from-brand-orange to-yellow-500 text-white text-sm font-semibold mb-6"
          >
            <span class="w-2 h-2 bg-white rounded-full mr-2"></span>
            Häufige Fragen
          </span>
          <h2
            id="faq-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Ihre Fragen –<br />
            <span class="text-brand-orange">unsere Antworten</span>
          </h2>
          <p class="text-xl text-gray-600">
            Alles was Sie über die Zusammenarbeit mit Ihrer Digitalagentur aus
            Regensburg wissen müssen.
          </p>
        </div>

        <div class="space-y-3">
          {
            faqs.map((faq) => (
              <details class="faq-item bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden group">
                <summary class="flex items-center justify-between p-5 md:p-6 cursor-pointer list-none gap-4">
                  <h3 class="text-lg font-semibold text-gray-900 text-left">
                    {faq.q}
                  </h3>
                  <svg
                    class="w-5 h-5 flex-shrink-0 text-brand-orange transition-transform duration-300 group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="faq-body px-5 md:px-6 pb-5 md:pb-6 border-t border-gray-100 pt-4">
                  <p class="text-gray-600 leading-relaxed">{faq.a}</p>
                </div>
              </details>
            ))
          }
        </div>

        <div class="text-center mt-12">
          <p class="text-gray-600">
            Weitere Fragen? Wir sind persönlich für Sie da.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Layout>

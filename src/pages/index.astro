---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import {
  breadcrumbSchema,
  organizationSchema,
  websiteSchema,
} from "../data/structuredData";
import { Image } from "astro:assets";
import heroImage from "../assets/ixone-online-marketing-regensburg.webp";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was macht eine Digitalagentur in Regensburg konkret für meine Website?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Eine Digitalagentur aus Regensburg übernimmt die ganzheitliche Betreuung Ihrer Website – von der Konzeption über Webentwicklung und SEO bis zur laufenden Pflege. iXone bietet als Full-Service-Agentur zusätzlich Online-Marketing, Google Ads und Social Media Kampagnen, um qualifizierten Traffic und Leads zu generieren.",
      },
    },
    {
      "@type": "Question",
      name: "Wie kann eine Online-Marketing-Agentur meinen Umsatz steigern?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Durch eine Kombination aus SEO, Google Ads, Social Media Werbung und Conversion-Optimierung erhöht iXone die Sichtbarkeit Ihrer Marke und steigert messbar den Umsatz. Transparentes Reporting und über 15 Jahre Erfahrung helfen dabei, Ihr Budget effizient einzusetzen.",
      },
    },
    {
      "@type": "Question",
      name: "Wie lange dauert die Entwicklung einer neuen Website?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Je nach Umfang dauert die Entwicklung einer professionellen Website bei iXone in der Regel 4 bis 10 Wochen. Nach einer kostenlosen Erstberatung erhalten Sie ein konkretes Angebot mit realistischem Zeitplan – ohne versteckte Kosten.",
      },
    },
    {
      "@type": "Question",
      name: "Bietet iXone auch Local SEO für Unternehmen in Regensburg an?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja, Local SEO ist eine unserer Kernkompetenzen. Wir optimieren Ihre Website gezielt für Suchanfragen aus Regensburg und Bayern – inklusive Google Business Profile Optimierung, lokale Backlinks und standortbezogene Keywords.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet eine professionelle Website bei einer Digitalagentur in Regensburg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die Kosten hängen vom Funktionsumfang ab. Einfache Unternehmenswebsites starten ab ca. 2.500 €, umfangreiche Projekte mit SEO und Marketing-Integration sind individuell kalkuliert. iXone bietet transparente Preise ohne versteckte Kosten und keine Mindestlaufzeiten.",
      },
    },
    {
      "@type": "Question",
      name: "Welche Technologien nutzt iXone für Websites – und warum ist das besser?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Statt veralteter WordPress-Lösungen setzt iXone auf moderne Technologien wie Astro – das Ergebnis sind Websites mit PageSpeed-Werten über 95, schnelleren Ladezeiten und besseren Google-Rankings. Während viele Agenturen in Regensburg noch Standard-Themes verkaufen, entwickeln wir individuelle, performante Lösungen die sich im Google-Ranking direkt bemerkbar machen.",
      },
    },
    {
      "@type": "Question",
      name: "Nutzt iXone KI-Tools zur Optimierung von Kampagnen und Websites?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja – wir setzen gezielt KI-gestützte Tools für SEO-Analyse, Content-Optimierung und Kampagnensteuerung ein. KI ersetzt bei uns nicht die persönliche Beratung, sondern ergänzt sie. Sie profitieren von modernster Technologie kombiniert mit über 15 Jahren menschlicher Erfahrung – das ist der Unterschied zu rein automatisierten Lösungen.",
      },
    },
    {
      "@type": "Question",
      name: "Wie läuft die Zusammenarbeit mit iXone konkret ab?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Bei iXone haben Sie immer einen direkten Ansprechpartner – keinen Callcenter-Mitarbeiter, keine wechselnden Projektmanager. Wir starten mit einer kostenlosen Erstberatung, entwickeln gemeinsam ein Konzept und halten Sie transparent auf dem Laufenden. Klare Kommunikation und messbare Ergebnisse statt Agentur-Blabla.",
      },
    },
    {
      "@type": "Question",
      name: "Wie unterscheidet sich iXone von anderen Digitalagenturen in Regensburg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Drei Dinge machen den Unterschied: Erstens Technologie – wir bauen mit modernen Frameworks wie Astro statt veralteten WordPress-Templates. Zweitens Erfahrung – seit 2007 und über 500 Projekte, das haben die meisten Mitbewerber nicht. Drittens persönlicher Service – als inhabergeführte Agentur sind wir direkt erreichbar und kennen unsere Kunden beim Namen.",
      },
    },
  ],
};

const faqs = [
  {
    q: "Was macht eine Digitalagentur in Regensburg konkret für meine Website?",
    a: "Wir übernehmen alles – von der Konzeption über Webentwicklung und SEO bis zur laufenden Pflege. Als Full-Service-Agentur bieten wir zusätzlich Google Ads, Social Media und Conversion-Optimierung, um aus Besuchern zahlende Kunden zu machen.",
  },
  {
    q: "Wie kann Online-Marketing meinen Umsatz steigern?",
    a: "Durch die Kombination aus SEO, Google Ads und Social Ads erhöhen wir die Sichtbarkeit Ihrer Marke gezielt. Wir optimieren Landingpages für maximale Conversion und liefern transparente Berichte – damit Sie genau sehen, was Ihr Budget bringt.",
  },
  {
    q: "Wie lange dauert die Entwicklung einer neuen Website?",
    a: "Je nach Umfang dauert es 4 bis 10 Wochen. Nach einer kostenlosen Erstberatung erhalten Sie ein konkretes Angebot mit realistischem Zeitplan – ohne versteckte Kosten.",
  },
  {
    q: "Bietet iXone auch Local SEO für Regensburg an?",
    a: "Ja, Local SEO ist eine unserer Kernkompetenzen. Wir optimieren Ihre Website für Suchanfragen aus Regensburg und Bayern – inklusive Google Business Profile, lokale Backlinks und standortbezogene Keywords.",
  },
  {
    q: "Was kostet eine professionelle Website bei iXone?",
    a: "Die Kosten hängen vom Funktionsumfang ab. Einfache Unternehmenswebsites starten ab ca. 2.500 €. Wir bieten transparente Preise ohne Mindestlaufzeiten – sprechen Sie uns einfach an.",
  },
  {
    q: "Welche Technologien nutzt iXone – und warum ist das besser als WordPress?",
    a: "Statt veralteter WordPress-Lösungen setzen wir auf moderne Technologien wie Astro – das Ergebnis sind Websites mit PageSpeed über 95, schnelleren Ladezeiten und besseren Google-Rankings. Während viele Agenturen noch Standard-Themes verkaufen, entwickeln wir individuelle, performante Lösungen die sich im Ranking direkt bemerkbar machen.",
  },
  {
    q: "Nutzt iXone KI-Tools zur Optimierung von Kampagnen und Websites?",
    a: "Ja – wir setzen KI-gestützte Tools für SEO-Analyse, Content-Optimierung und Kampagnensteuerung ein. KI ersetzt bei uns nicht die persönliche Beratung, sondern ergänzt sie. Sie profitieren von modernster Technologie kombiniert mit über 15 Jahren menschlicher Erfahrung.",
  },
  {
    q: "Wie läuft die Zusammenarbeit mit iXone konkret ab?",
    a: "Bei iXone haben Sie immer einen direkten Ansprechpartner – keinen Callcenter-Mitarbeiter, keine wechselnden Projektmanager. Wir starten mit einer kostenlosen Erstberatung, entwickeln gemeinsam ein Konzept und halten Sie transparent auf dem Laufenden. Klare Kommunikation und messbare Ergebnisse statt Agentur-Blabla.",
  },
  {
    q: "Wie unterscheidet sich iXone von anderen Digitalagenturen in Regensburg?",
    a: "Drei Dinge machen den Unterschied: Erstens Technologie – wir bauen mit Astro statt veralteten WordPress-Templates. Zweitens Erfahrung – seit 2007 und über 500 Projekte, das haben die meisten Mitbewerber nicht. Drittens persönlicher Service – als inhabergeführte Agentur sind wir direkt erreichbar und kennen unsere Kunden beim Namen.",
  },
];
---

<Layout
  title="iXone – Digitalagentur Regensburg | Webdesign, SEO & Online-Marketing"
  description="Ihre Digitalagentur aus Regensburg – Webdesign, SEO & Online-Marketing. Seit 2007 über 500 Projekte. Kostenlose Erstberatung sichern."
  canonical="https://ixone.de/"
  structuredData={[breadcrumbs, organizationSchema, websiteSchema, faqSchema]}
>
  <!-- ===================== HERO ===================== -->
  <div class="pt-14 sm:pt-16 md:pt-18 lg:pt-20 xl:pt-22 bg-white">
    <Hero />
  </div>

  <!-- ===================== ABOUT / INTRO ===================== -->
  <section class="py-20 md:py-28 bg-white" aria-labelledby="about-heading">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
        >
          <!-- Bild Links -->
          <div class="relative overflow-hidden rounded-3xl group">
            <Image
              src={heroImage}
              alt="iXone Digitalagentur Regensburg – Team bei der Arbeit an Webdesign und SEO Projekten"
              width={600}
              height={600}
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-3xl shadow-2xl transition-transform duration-500 group-hover:scale-105"
            />

            <!-- Stats-Badge -->
            <div
              class="absolute bottom-6 left-6 bg-white/95 backdrop-blur-sm rounded-2xl px-5 py-4 shadow-xl"
            >
              <div class="flex items-center gap-4">
                <div class="text-center">
                  <p class="text-2xl font-black text-gray-900">500+</p>
                  <p class="text-xs text-gray-500 font-medium">Projekte</p>
                </div>
                <div class="w-px h-10 bg-gray-200"></div>
                <div class="text-center">
                  <p class="text-2xl font-black text-gray-900">15+</p>
                  <p class="text-xs text-gray-500 font-medium">Jahre</p>
                </div>
                <div class="w-px h-10 bg-gray-200"></div>
                <div class="text-center">
                  <p
                    class="text-2xl font-black"
                    style="color: var(--brand-orange);"
                  >
                    5★
                  </p>
                  <p class="text-xs text-gray-500 font-medium">Google</p>
                </div>
              </div>
            </div>

            <div
              class="absolute -bottom-6 -right-6 w-32 h-32 bg-brand-orange/10 rounded-full blur-3xl -z-10 pointer-events-none"
            >
            </div>
            <div
              class="absolute -top-6 -left-6 w-24 h-24 bg-yellow-400/10 rounded-full blur-2xl -z-10 pointer-events-none"
            >
            </div>
          </div>

          <!-- Text Rechts -->
          <div>
            <div
              class="inline-flex items-center px-4 py-2 rounded-full text-white text-sm font-semibold mb-6"
              style="background-color: var(--brand-orange);"
            >
              <span class="w-2 h-2 bg-white/60 rounded-full mr-2"></span>
              IHRE DIGITALAGENTUR AUS REGENSBURG
            </div>

            <h2
              id="about-heading"
              class="text-3xl md:text-4xl lg:text-5xl font-black mb-6 text-gray-900 leading-tight"
            >
              Seit 2007 für Ihren<br />
              <span style="color: var(--brand-orange);">digitalen Erfolg</span>
            </h2>

            <p class="text-lg text-gray-700 mb-4 leading-relaxed">
              Über 500 Unternehmen aus Regensburg, Bayern und ganz Deutschland
              vertrauen iXone – weil wir nicht nur Websites bauen, sondern
              digitale Vertriebskanäle entwickeln, die messbar mehr Kunden
              bringen.
            </p>
            <p class="text-base text-gray-600 mb-8 leading-relaxed">
              Inhabergeführt, lokal verwurzelt, technisch auf dem neuesten
              Stand: Wir bieten
              <a
                href="/webdesign"
                class="font-medium hover:underline"
                style="color: var(--brand-orange);">Webdesign</a
              >,
              <a
                href="/seo-agentur"
                class="font-medium hover:underline"
                style="color: var(--brand-orange);">SEO</a
              >,
              <a
                href="/online-marketing"
                class="font-medium hover:underline"
                style="color: var(--brand-orange);">Online-Marketing</a
              > und
              <a
                href="/social-media-marketing"
                class="font-medium hover:underline"
                style="color: var(--brand-orange);">Social Media</a
              > – alles aus einer Hand – für viele <a
                href="/branchen"
                class="font-medium hover:underline"
                style="color: var(--brand-orange);">Branchen</a
              >, persönlich betreut, mit transparenten Ergebnissen.
            </p>

            <ul class="space-y-3 mb-8">
              {
                [
                  {
                    title: "Schnelle Websites",
                    desc: "Astro-Technologie für PageSpeed 95+ und bessere Google-Rankings",
                  },
                  {
                    title: "Local SEO Regensburg",
                    desc: "Mehr Sichtbarkeit für Ihre Kunden direkt vor Ort",
                  },
                  {
                    title: "Google Ads & Social Ads",
                    desc: "Kampagnen die konvertieren – nicht nur klicken",
                  },
                  {
                    title: "Persönlicher Ansprechpartner",
                    desc: "Kein Callcenter, direkte Kommunikation auf Augenhöhe",
                  },
                ].map((item) => (
                  <li class="flex items-start gap-3 text-gray-900">
                    <svg
                      class="w-5 h-5 flex-shrink-0 mt-1"
                      style="color: var(--brand-orange);"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    <span>
                      <strong class="font-semibold">{item.title}</strong>
                      <span class="text-gray-600"> – {item.desc}</span>
                    </span>
                  </li>
                ))
              }
            </ul>

            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="/kontakt"
                class="inline-flex items-center justify-center px-8 py-4 text-white font-semibold text-base rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl"
                style="background-color: var(--brand-orange);"
                aria-label="Kostenlose Erstberatung bei iXone Digitalagentur Regensburg anfragen"
              >
                Kostenlose Erstberatung
              </a>
              <a
                href="/branchen"
                class="inline-flex items-center justify-center px-8 py-4 text-gray-700 font-semibold text-base rounded-full border-2 border-gray-200 hover:border-brand-orange hover:text-brand-orange transition-all duration-300"
                aria-label="Alle Branchen die iXone betreut entdecken"
              >
                Branchen ansehen
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <Services />

  <!-- ===================== WHY CHOOSE US ===================== -->
  <WhyChooseUs />

  <!-- ===================== TESTIMONIALS ===================== -->
  <Testimonials />

  <!-- ===================== FAQ ===================== -->
  <section class="py-20 md:py-28 bg-gray-50" aria-labelledby="faq-heading">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <div
            class="inline-flex items-center px-4 py-2 rounded-full bg-brand-orange/10 border border-brand-orange/20 text-brand-orange text-sm font-semibold mb-6"
          >
            <span class="w-2 h-2 bg-brand-orange rounded-full mr-2"></span>
            Häufige Fragen
          </div>
          <h2
            id="faq-heading"
            class="text-3xl md:text-4xl font-black text-gray-900 mb-4"
          >
            Ihre Fragen –<br />
            <span style="color: var(--brand-orange);">unsere Antworten</span>
          </h2>
          <p class="text-lg text-gray-600">
            Alles was Sie über die Zusammenarbeit mit Ihrer Digitalagentur aus
            Regensburg wissen müssen.
          </p>
        </div>

        <!-- FAQ Akkordeon -->
        <div class="space-y-3" itemscope itemtype="https://schema.org/FAQPage">
          {
            faqs.map((faq) => (
              <div
                class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden"
                itemscope
                itemprop="mainEntity"
                itemtype="https://schema.org/Question"
              >
                <details class="group">
                  <summary class="flex items-center justify-between p-5 md:p-6 cursor-pointer list-none gap-4">
                    <h3
                      class="text-base md:text-lg font-semibold text-gray-900"
                      itemprop="name"
                    >
                      {faq.q}
                    </h3>
                    <svg
                      class="w-5 h-5 flex-shrink-0 transition-transform duration-300 group-open:rotate-180"
                      style="color: var(--brand-orange);"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </summary>
                  <div
                    class="px-5 md:px-6 pb-5 md:pb-6 border-t border-gray-100 pt-4"
                    itemscope
                    itemprop="acceptedAnswer"
                    itemtype="https://schema.org/Answer"
                  >
                    <p class="text-gray-600 leading-relaxed" itemprop="text">
                      {faq.a}
                    </p>
                  </div>
                </details>
              </div>
            ))
          }
        </div>

        <!-- FAQ CTA -->
        <div class="text-center mt-10">
          <p class="text-gray-600 mb-4">
            Weitere Fragen? Wir sind persönlich für Sie da.
          </p>
          <a
            href="/kontakt"
            class="inline-flex items-center gap-2 px-8 py-4 text-white font-semibold rounded-full transition-all duration-300 hover:shadow-xl hover:-translate-y-1 transform"
            style="background-color: var(--brand-orange);"
            aria-label="Kontakt zu iXone Digitalagentur Regensburg aufnehmen"
          >
            Jetzt Frage stellen
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <CTA />
</Layout>

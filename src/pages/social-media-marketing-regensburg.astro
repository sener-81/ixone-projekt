---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";
import { Image } from "astro:assets";
import platformImage from "../assets/webdesigner-aus-regensburg.webp";
import { areaServedFull } from "../data/structuredData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://ixone.de/social-media-marketing-regensburg/#service",
  name: "Social Media Marketing Agentur Regensburg",
  description:
    "Social Media Marketing aus Regensburg: Facebook, Instagram, TikTok und YouTube Marketing, Content-Erstellung, Social Media Ads, Recruiting und Influencer Marketing für mehr Reichweite, Engagement und Kunden.",
  provider: { "@id": "https://ixone.de/#organization" },
  telephone: "+4994015338873",
  areaServed: areaServedFull,
  serviceType: "Social Media Marketing",
  url: "https://ixone.de/social-media-marketing-regensburg/",
};

const faqs = [
  {
    q: "Was umfasst Social Media Marketing?",
    a: "Social Media Marketing umfasst alle Maßnahmen, um Ihre Marke und Leistungen über soziale Medien zu bewerben und Ihre Zielgruppe zu erreichen: Social-Media-Strategie, Content-Erstellung (Bilder, Videos, Texte), Community Management, Social Media Ads, Influencer Marketing und Recruiting über Kanäle wie LinkedIn. Ziel ist mehr Sichtbarkeit, Interaktion und Leads für Ihr Unternehmen aus Regensburg.",
  },
  {
    q: "Welche Social-Media-Plattformen lohnen sich für mein Unternehmen?",
    a: "Das hängt von Zielgruppe und Zielen ab. Facebook und Instagram bieten breite Reichweite und Community-Aufbau, TikTok erreicht jüngere Zielgruppen über virale Trends, YouTube punktet mit Video-Content und Sichtbarkeit in der Suche, LinkedIn und Xing eignen sich für B2B und Employer Branding. Wir analysieren Ihre Zielgruppe und wählen die effektivsten Kanäle.",
  },
  {
    q: "Was kostet Social Media Marketing?",
    a: "Die Kosten sind individuell und hängen von Plattformen, Umfang und Zielen ab. Wir erstellen ein maßgeschneidertes Angebot, das genau zu Ihren Anforderungen passt. In einer kostenlosen Erstberatung besprechen wir Ihre Ziele und nennen Ihnen einen transparenten Preis auf Anfrage – ohne versteckte Kosten.",
  },
  {
    q: "Wie schnell sieht man Erfolge im Social Media Marketing?",
    a: "Das variiert je nach Ausgangslage, Budget und Intensität. Organische Reichweite und Community-Aufbau brauchen meist mehrere Monate kontinuierlicher Content-Erstellung. Über gezielte Social Media Ads sind dagegen schon innerhalb weniger Wochen erste messbare Ergebnisse möglich. Langfristig zahlt sich eine strategische, nachhaltige Betreuung immer aus.",
  },
  {
    q: "Was ist der Unterschied zwischen organischem Content und Social Media Ads?",
    a: "Organischer Content (reguläre Posts, Reels, Stories) baut langfristig Reichweite, Vertrauen und Community auf, wirkt aber langsamer. Social Media Ads sind bezahlte Anzeigen mit präzisem Targeting, die schnell Sichtbarkeit und Leads bringen. Die beste Wirkung entsteht aus der Kombination beider Ansätze.",
  },
  {
    q: "Lohnt sich Social Media Marketing für kleine Unternehmen?",
    a: "Ja. Social Media Marketing ist gerade für kleine und mittelständische Unternehmen aus Regensburg ein kosteneffizienter Weg, lokale Sichtbarkeit aufzubauen, neue Kunden zu erreichen und sich gegen größere Wettbewerber zu behaupten. Schon mit überschaubarem Budget lassen sich über lokales Targeting messbare Ergebnisse erzielen.",
  },
  {
    q: "Wie wird der Erfolg im Social Media Marketing gemessen?",
    a: "Über Kennzahlen wie Reichweite, Engagement, Klicks, Lead-Anfragen und letztlich Conversions und Umsatz. Für lokale Unternehmen sind zusätzlich regionale KPIs sinnvoll – etwa wie viele Anfragen aus Regensburg und Umgebung stammen. Sie erhalten von uns regelmäßige, transparente Reports.",
  },
  {
    q: "Warum eine lokale Social Media Agentur aus Regensburg?",
    a: "Eine lokale Agentur wie ixOne bietet Ihnen einen persönlichen Ansprechpartner und ein tiefes Verständnis für den regionalen Markt. Wir kennen die Besonderheiten von Regensburg und Umgebung, stimmen Ihre Strategie präzise auf Ihre Zielgruppe ab und reagieren durch die räumliche Nähe schnell und flexibel.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const counters = [
  { target: "4", suffix: "", label: "Haupt-Plattformen" },
  { target: "500", suffix: "+", label: "Projekte umgesetzt" },
  { target: "19", suffix: "", label: "Jahre am Markt" },
  { target: "100", suffix: "%", label: "lokaler Fokus" },
];

const plattformen = [
  {
    kuerzel: "f",
    name: "Facebook",
    badgeClass: "bg-blue-600",
    title: "Facebook Marketing Regensburg",
    image: platformImage,
    alt: "Facebook Marketing Regensburg – Reichweite und Community-Aufbau durch ixOne",
    text: "Facebook bietet Unternehmen aus Regensburg exzellente Möglichkeiten, Reichweite aufzubauen und eine engagierte Community zu pflegen. Mit gezielten Postings, strategischem Community Management und performancestarken Facebook Ads sprechen wir genau Ihre lokale Zielgruppe an – ob zur Neukundengewinnung oder fürs Employer Branding.",
    items: [
      "Reichweite & Community-Aufbau",
      "Zielgerichtete Facebook Ads",
      "Transparentes Reporting",
    ],
  },
  {
    kuerzel: "IG",
    name: "Instagram",
    badgeClass: "bg-gradient-to-r from-pink-500 to-purple-600",
    title: "Instagram Marketing Regensburg",
    image: platformImage,
    alt: "Instagram Marketing Regensburg – visuelles Storytelling mit Reels und Stories",
    text: "Instagram ist die Bühne für visuelles Storytelling. Wir erwecken Ihre Marke mit ästhetisch ansprechendem Content zum Leben, bauen über Reels und Stories Reichweite auf und nutzen Instagram Shopping, damit Ihre Produkte direkt verkaufen. So entsteht eine starke emotionale Verbindung zu Ihrer Zielgruppe in Regensburg.",
    items: [
      "Visuelles Storytelling & Feed-Design",
      "Reels & Stories",
      "Instagram Shopping",
    ],
  },
  {
    kuerzel: "TT",
    name: "TikTok",
    badgeClass: "bg-gray-900",
    title: "TikTok Marketing Regensburg",
    image: platformImage,
    alt: "TikTok Marketing Regensburg – virale Reichweite für junge Zielgruppen",
    text: "TikTok bietet Unternehmen aus Regensburg eine einzigartige Chance auf virale Reichweite – besonders bei jüngeren Zielgruppen, die anderswo schwer erreichbar sind. Mit kreativem, trendorientiertem Content, strategischen Posting-Plänen und aktivem Community Management steigern wir Ihre Markenbekanntheit und Interaktion.",
    items: [
      "Virale Reichweite & junge Zielgruppen",
      "Trend-basierter Content",
      "Community Management",
    ],
  },
  {
    kuerzel: "YT",
    name: "YouTube",
    badgeClass: "bg-red-600",
    title: "YouTube Marketing Regensburg",
    image: platformImage,
    alt: "YouTube Marketing Regensburg – Video-Content und Branding über die zweitgrößte Suchmaschine",
    text: "Als zweitgrößte Suchmaschine der Welt ist YouTube ideal, um Video-Content zu verbreiten und Ihre Markenbekanntheit nachhaltig zu stärken. Wir erstellen hochwertige Videos, optimieren Titel, Beschreibungen und Tags für die Suche und positionieren Sie mit informativem und unterhaltsamem Content als Experte Ihrer Branche.",
    items: [
      "Video-Content für Markenbekanntheit",
      "YouTube-SEO (Titel, Tags, Beschreibung)",
      "Branding durch Tutorials & Einblicke",
    ],
  },
];

const leistungen = [
  {
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
    title: "Content-Erstellung",
    desc: "Hochwertiger Content für alle Plattformen – Bilder, Videos, Reels und Texte, exakt auf Plattform und Zielgruppe zugeschnitten.",
  },
  {
    icon: "M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l3.586-3.586z",
    title: "Community Management",
    desc: "Wir beantworten Kommentare und Nachrichten, fördern den Dialog und bauen eine loyale Community rund um Ihre Marke auf.",
  },
  {
    icon: "M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z",
    title: "Social Media Ads",
    desc: "Zielgerichtete Werbekampagnen auf Facebook, Instagram & Co. – wir konzipieren, steuern und optimieren für maximale Leads.",
  },
  {
    icon: "M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z",
    title: "Social Media Recruiting",
    desc: "Moderne Personalgewinnung: Wir erreichen passive Kandidaten über Employer Branding und gewinnen qualifizierte Bewerber für Sie.",
  },
];

const arbeitsschritte = [
  {
    step: "1",
    title: "Strategie & Redaktionsplan",
    desc: "Wir analysieren Zielgruppe, Ziele und Wettbewerb in Regensburg und entwickeln einen Redaktionsplan mit Content-Formaten, Posting-Zeiten und Plattformen.",
  },
  {
    step: "2",
    title: "Content-Produktion",
    desc: "Kreativität trifft Strategie: Bilder, Videos für YouTube und Reels für Instagram und TikTok – hochwertig und plattformgerecht produziert.",
  },
  {
    step: "3",
    title: "Reporting & Optimierung",
    desc: "Wir messen den Erfolg laufend anhand relevanter Kennzahlen, liefern transparente Reports und optimieren die Strategie kontinuierlich.",
  },
];

const kanaele = [
  { kuerzel: "f", name: "Facebook", bg: "bg-blue-600" },
  {
    kuerzel: "IG",
    name: "Instagram",
    bg: "bg-gradient-to-br from-purple-500 to-pink-500",
  },
  { kuerzel: "TT", name: "TikTok", bg: "bg-gray-900" },
  { kuerzel: "YT", name: "YouTube", bg: "bg-red-600" },
  { kuerzel: "Li", name: "LinkedIn", bg: "bg-blue-700" },
  { kuerzel: "X", name: "Twitter/X", bg: "bg-gray-900" },
];
---

<Layout
  title="Social Media Marketing Regensburg | ixOne Digitalagentur"
  description="Social Media Marketing aus Regensburg: Content und Ads für Instagram, TikTok, Facebook und YouTube – mehr Reichweite, Engagement und neue Kunden."
  canonical="https://ixone.de/social-media-marketing-regensburg/"
  structuredData={[serviceSchema, faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative overflow-hidden bg-gradient-to-br from-pink-900 via-purple-800 to-indigo-900 text-white"
      aria-label="Social Media Marketing Agentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute -top-24 -left-24 w-96 h-96 bg-pink-400 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -right-24 w-96 h-96 bg-purple-400 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div
          class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"
        >
          <div class="text-center lg:text-left">
            <span
              class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
            >
              <span class="w-2 h-2 rounded-full bg-pink-400 animate-pulse"
              ></span>
              Digitalagentur aus Regensburg · seit 2007
            </span>

            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
            >
              <span class="block">Social Media Marketing</span>
              <span class="block gradient-text-brand">Agentur Regensburg</span>
            </h1>

            <p
              class="text-lg md:text-xl text-gray-200 leading-relaxed mb-10 max-w-xl mx-auto lg:mx-0"
            >
              Strategisches Social Media Marketing aus Regensburg –
              <strong class="text-white">Facebook</strong>,
              <strong class="text-white">Instagram</strong>,
              <strong class="text-white">TikTok</strong> und
              <strong class="text-white">YouTube</strong> für mehr Reichweite, Engagement
              und qualifizierte Leads.
            </p>

            <div
              class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
            >
              <a
                href={CALENDLY}
                target="_blank"
                rel="noopener"
                data-calendly-popup-url={CALENDLY}
                class="cta-button-primary text-center"
                aria-label="Kostenlose Erstberatung Social Media Marketing"
              >
                <span>Kostenlose Erstberatung</span>
              </a>
              <a
                href="#plattformen"
                class="px-8 py-4 rounded-2xl font-semibold text-white border border-white/30 bg-white/5 backdrop-blur-md hover:bg-white/15 transition-all duration-300 text-center"
              >
                Plattformen entdecken
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:gap-6">
            {
              counters.map((c) => (
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 lg:p-8 border border-white/20 text-center">
                  <div
                    class="counter text-4xl md:text-5xl font-bold gradient-text-brand"
                    data-target={c.target}
                    data-suffix={c.suffix}
                  >
                    0{c.suffix}
                  </div>
                  <p class="mt-3 text-sm text-gray-300">{c.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="intro-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <h2
            id="intro-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-8"
          >
            Social Media Marketing als Schlüssel zur
            <span class="gradient-text-brand">Sichtbarkeit</span> in Regensburg
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Eine starke Präsenz in den sozialen Medien ist für Unternehmen aus
            Regensburg unverzichtbar, um neue Kunden zu gewinnen und die
            Markenbekanntheit zu steigern. Social-Media-Kanäle sind heute
            leistungsstarke Marketing-Plattformen, über die Sie eine breite
            Reichweite erzielen und direkt mit potenziellen Kunden in den Dialog
            treten.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Als lokale Social Media Agentur aus Regensburg analysieren wir Ihre
            Zielgruppe präzise und entwickeln eine Strategie, die Ihre Marke
            stärkt und Ihre Botschaft über die richtigen Plattformen verbreitet.
            Eng verzahnt mit unserem
            <a
              href="/online-marketing-regensburg/"
              class="text-brand-orange font-semibold hover:underline"
              >Online Marketing</a
            >,
            <a
              href="/seo-regensburg/"
              class="text-brand-orange font-semibold hover:underline">SEO</a
            > und
            <a
              href="/webdesign-regensburg/"
              class="text-brand-orange font-semibold hover:underline"
              >Webdesign</a
            > greifen alle Maßnahmen ineinander.
          </p>
        </div>
      </div>
    </section>

    <section
      id="plattformen"
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="plattformen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <h2
            id="plattformen-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Unsere <span class="gradient-text-brand">Plattform-Expertise</span>
          </h2>
          <p class="text-xl text-gray-600">
            Für jede Plattform die richtige Strategie – von Facebook bis
            YouTube.
          </p>
        </div>

        <div class="max-w-6xl mx-auto space-y-12 md:space-y-16">
          {
            plattformen.map((p, i) => (
              <article class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
                <div class={i % 2 === 1 ? "lg:order-2" : ""}>
                  <div class="relative rounded-2xl overflow-hidden aspect-[4/3] border border-gray-200">
                    <Image
                      src={p.image}
                      alt={p.alt}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                      width="1000"
                      height="750"
                    />
                  </div>
                </div>
                <div class={i % 2 === 1 ? "lg:order-1" : ""}>
                  <div
                    class={`inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full text-white text-sm font-semibold ${p.badgeClass}`}
                  >
                    <span class="font-bold">{p.kuerzel}</span> {p.name}
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 mb-4">
                    {p.title}
                  </h3>
                  <p class="text-gray-600 leading-relaxed mb-4">{p.text}</p>
                  <ul class="text-gray-600 text-sm space-y-2">
                    {p.items.map((item) => (
                      <li class="flex items-center gap-2">
                        <span
                          class="w-1.5 h-1.5 bg-brand-orange rounded-full flex-shrink-0"
                          aria-hidden="true"
                        />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="leistungen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <h2
            id="leistungen-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Weitere <span class="gradient-text-brand">Leistungen</span>
          </h2>
          <p class="text-xl text-gray-600">
            Von der Content-Erstellung bis zum Social Media Recruiting – alles
            aus einer Hand.
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto"
        >
          {
            leistungen.map((l) => (
              <article class="bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 p-8 border border-gray-100">
                <div class="w-12 h-12 rounded-xl border border-brand-orange/30 flex items-center justify-center mb-6">
                  <svg
                    class="w-6 h-6 text-brand-orange"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={l.icon}
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">{l.title}</h3>
                <p class="text-gray-600 leading-relaxed text-sm">{l.desc}</p>
              </article>
            ))
          }
        </div>

        <div
          class="max-w-4xl mx-auto mt-12 bg-gradient-to-br from-pink-50 to-purple-50 rounded-2xl p-8 md:p-10 border border-pink-100"
        >
          <h3 class="text-xl font-bold text-gray-900 mb-3">
            Influencer Marketing
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Authentische Markenpartnerschaften mit passenden Creatorn
            erschließen neue Zielgruppen und stärken Ihre Glaubwürdigkeit. Wir
            identifizieren relevante Micro- und Macro-Influencer, entwickeln
            maßgeschneiderte Kampagnen und managen die Zusammenarbeit – von der
            Auswahl bis zum Performance-Tracking.
          </p>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="termin-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="relative max-w-5xl mx-auto rounded-3xl overflow-hidden bg-gradient-to-br from-pink-900 via-purple-800 to-indigo-900 text-white"
        >
          <div class="absolute inset-0 opacity-20" aria-hidden="true">
            <div
              class="absolute -top-20 -right-20 w-72 h-72 bg-pink-400 rounded-full blur-3xl"
            >
            </div>
            <div
              class="absolute -bottom-20 -left-20 w-72 h-72 bg-purple-400 rounded-full blur-3xl"
            >
            </div>
          </div>

          <div class="relative z-10 p-8 md:p-12 lg:p-16 text-center">
            <span
              class="inline-flex items-center gap-2 mb-6 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
            >
              <span class="w-2 h-2 rounded-full bg-pink-400 animate-pulse"
              ></span>
              Kostenlos &amp; unverbindlich
            </span>

            <h2 id="termin-heading" class="text-3xl md:text-4xl font-bold mb-4">
              Online Termin jetzt buchen
            </h2>
            <p
              class="text-lg text-gray-200 leading-relaxed mb-10 max-w-2xl mx-auto"
            >
              Lassen Sie uns über Ihre Social-Media-Ziele sprechen – persönlich
              bei uns vor Ort in Regensburg oder Neutraubling, oder bequem per
              Videokonferenz. Sie wählen den Termin, wir bringen die Ideen mit.
            </p>

            <div class="flex justify-center">
              <a
                href={CALENDLY}
                target="_blank"
                rel="noopener"
                data-calendly-popup-url={CALENDLY}
                class="group inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl bg-white text-gray-900 font-bold text-lg hover:bg-gray-100 transition-all duration-300 transform hover:-translate-y-1 shadow-lg"
                aria-label="Jetzt Termin vereinbaren – vor Ort oder per Videokonferenz"
              >
                <svg
                  class="w-6 h-6 text-brand-orange flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>

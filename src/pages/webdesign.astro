---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "Webdesign", url: "https://ixone.de/webdesign" },
]);

// Service Schema für bessere SERP Features
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Webdesign Regensburg",
  description:
    "Professionelles Webdesign aus Regensburg. Moderne, responsive Websites die konvertieren und bei Google ranken.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "Webdesign",
  offers: {
    "@type": "Offer",
    price: "2500",
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: "2500",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: true,
    },
  },
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was kostet professionelles Webdesign in Regensburg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Professionelles Webdesign in Regensburg startet bei 2.500€ für eine Unternehmenswebsite. E-Commerce-Lösungen beginnen bei 5.000€. Wir erstellen transparente, individuelle Angebote ohne versteckte Kosten.",
      },
    },
    {
      "@type": "Question",
      name: "Wie lange dauert die Webdesign-Entwicklung?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Eine professionelle Website benötigt 2-4 Wochen Entwicklungszeit. Komplexere Projekte mit E-Commerce oder speziellen Funktionen dauern 6-12 Wochen. Sie erhalten einen detaillierten Zeitplan nach dem Erstgespräch.",
      },
    },
    {
      "@type": "Question",
      name: "Ist das Webdesign responsive und mobile-optimiert?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja, alle unsere Websites sind responsive und mobile-first entwickelt. Sie funktionieren perfekt auf Desktop, Tablet und Smartphone mit optimaler Benutzerfreundlichkeit auf allen Geräten.",
      },
    },
  ],
};
---

<Layout
  title="Webdesign Regensburg | Moderne Websites | iXone Digitalagentur"
  description="Professionelles Webdesign aus Regensburg. Moderne, responsive Websites die konvertieren. Mobile-optimiert, SEO-freundlich und performance-optimiert."
  canonical="https://ixone.de/webdesign"
  structuredData={[breadcrumbs, serviceSchema, faqSchema]}
>
  <main class="pt-14 sm:pt-16 md:pt-18 lg:pt-20 xl:pt-22 bg-white">
    <!-- Hero Section -->
    <section
      class="relative min-h-[80vh] bg-gradient-to-br from-cyan-900 via-blue-800 to-indigo-900 text-white overflow-hidden"
    >
      <!-- Animated Background -->
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-cyan-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <!-- Code/Design Pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="h-full w-full flex items-center justify-center">
          <div class="grid grid-cols-6 gap-8 transform rotate-12">
            <div class="w-8 h-8 bg-white rounded-sm"></div>
            <div class="w-8 h-8 bg-white rounded-lg"></div>
            <div class="w-8 h-8 bg-white rounded-sm"></div>
            <div class="w-8 h-8 bg-white rounded-lg"></div>
            <div class="w-8 h-8 bg-white rounded-sm"></div>
            <div class="w-8 h-8 bg-white rounded-lg"></div>
          </div>
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20 lg:py-24 relative z-10 flex items-center min-h-[80vh]"
      >
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Content -->
            <div class="lg:col-span-8 text-center lg:text-left">
              <header>
                <h1
                  class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight"
                >
                  <span class="block text-white">Professionelles</span>         
                  <span
                    class="block gradient-text-brand">
                    Webdesign
                  </span>
                  <span
                    class="block text-white/90 text-2xl md:text-3xl font-normal"
                  >
                    Agentur Regensburg
                  </span>
                </h1>
              </header>

              <div
                class="bg-white/10 backdrop-blur-md rounded-2xl p-6 md:p-8 border border-white/20 mb-8"
              >
                <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
                  <strong class="text-white"
                    >Moderne Webdesign Lösungen aus Regensburg</strong
                  > –
                  <em class="text-brand-orange">Responsive Design, UX/UI</em>
                  und
                  <em class="text-brand-orange">Performance-Optimierung</em> für
                  Websites, die begeistern und konvertieren.
                </p>
              </div>

              <!-- CTA Buttons -->
              <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a
                  href="/kontakt"
                  class="group relative px-8 py-4 bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white font-bold text-lg rounded-2xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 shadow-2xl hover:shadow-brand-orange/25 overflow-hidden text-center"
                  aria-label="Webdesign Projekt starten"
                >
                  <span
                    class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
                  ></span>
                  <span class="relative z-10">Webdesign Projekt starten</span>
                </a>

                <a
                  href="#webdesign-services"
                  class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-1 text-center"
                >
                  <span class="flex items-center justify-center gap-2">
                    Services entdecken
                    <svg
                      class="w-5 h-5 group-hover:translate-y-1 transition-transform duration-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                  </span>
                </a>
              </div>

              <!-- Trust Indicators -->
              <div
                class="flex flex-wrap justify-center lg:justify-start gap-6 text-white/70 text-sm"
              >
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium">100% Responsive</span>
                </span>
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium">SEO-optimiert</span>
                </span>
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium"
                    >PageSpeed optimiert</span
                  >
                </span>
              </div>
            </div>

            <!-- Visual Element -->
            <div class="lg:col-span-4 relative">
              <img
                src="/assets/ixone-webdesign-regensburg.webp"
                alt="iXone Webdesign Regensburg - Moderne und responsive Webentwicklung"
                class="w-full max-w-md mx-auto h-auto rounded-3xl shadow-2xl transform hover:scale-105 transition-transform duration-500 animate-float"
                loading="eager"
                width="400"
                height="400"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section
      id="webdesign-features"
      class="py-12 md:py-16 lg:py-24 xl:py-32 bg-white"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-12 md:mb-16 lg:mb-20">
          <h2
            class="text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-bold text-gray-900 mb-4 md:mb-6"
          >
            Unsere <span
              class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
              >Webdesign</span
            > Leistungen
          </h2>
          <p
            class="text-lg md:text-xl lg:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed"
          >
            Professionelle Webdesign-Services aus Regensburg
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 lg:gap-10 max-w-7xl mx-auto"
        >
          <!-- Feature 1: Responsive Design -->
          <article
            class="group text-center p-6 md:p-8 lg:p-10 bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100"
          >
            <div
              class="w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 md:w-8 md:h-8 lg:w-10 lg:h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
            >
              Responsive Design
            </h3>
            <p
              class="text-gray-600 leading-relaxed text-sm md:text-base lg:text-lg"
            >
              <strong>Mobile-first</strong> für alle Geräte. Perfekte Darstellung
              auf Desktop, Tablet und Smartphone.
            </p>
          </article>

          <!-- Feature 2: Performance -->
          <article
            class="group text-center p-6 md:p-8 lg:p-10 bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100"
          >
            <div
              class="w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 md:w-8 md:h-8 lg:w-10 lg:h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
            >
              Schnelle Performance
            </h3>
            <p
              class="text-gray-600 leading-relaxed text-sm md:text-base lg:text-lg"
            >
              <strong>Unter 3 Sekunden</strong> Ladezeit für bessere User Experience
              und höhere Google-Rankings.
            </p>
          </article>

          <!-- Feature 3: SEO -->
          <article
            class="group text-center p-6 md:p-8 lg:p-10 bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100"
          >
            <div
              class="w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 md:w-8 md:h-8 lg:w-10 lg:h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
            >
              SEO-optimiert
            </h3>
            <p
              class="text-gray-600 leading-relaxed text-sm md:text-base lg:text-lg"
            >
              <strong>Suchmaschinenfreundlich</strong> programmiert. Structured Data
              und technisches SEO für bessere Rankings.
            </p>
          </article>

          <!-- Feature 4: UX/UI Design -->
          <article
            class="group text-center p-6 md:p-8 lg:p-10 bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100"
          >
            <div
              class="w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 md:w-8 md:h-8 lg:w-10 lg:h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
                ></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
            >
              Conversion-optimiert
            </h3>
            <p
              class="text-gray-600 leading-relaxed text-sm md:text-base lg:text-lg"
            >
              <strong>Benutzerfreundlich</strong> und conversion-fokussiert. Strategische
              Call-to-Actions für maximale Erfolge.
            </p>
          </article>

          <!-- Feature 5: CMS Integration -->
          <article
            class="group text-center p-6 md:p-8 lg:p-10 bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100"
          >
            <div
              class="w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 md:w-8 md:h-8 lg:w-10 lg:h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
            >
              CMS-Integration
            </h3>
            <p
              class="text-gray-600 leading-relaxed text-sm md:text-base lg:text-lg"
            >
              <strong>Einfache Verwaltung</strong> mit WordPress oder headless CMS.
              Sie können Inhalte selbst pflegen.
            </p>
          </article>

          <!-- Feature 6: Wartung & Support -->
          <article
            class="group text-center p-6 md:p-8 lg:p-10 bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100"
          >
            <div
              class="w-14 h-14 md:w-16 md:h-16 lg:w-20 lg:h-20 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 md:w-8 md:h-8 lg:w-10 lg:h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 mb-3 md:mb-4"
            >
              Wartung & Support
            </h3>
            <p
              class="text-gray-600 leading-relaxed text-sm md:text-base lg:text-lg"
            >
              <strong>Langfristige Betreuung</strong> aus Regensburg. Updates, Backups
              und technischer Support.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="py-12 md:py-16 lg:py-24 xl:py-32 bg-gray-50">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-12 md:mb-16 lg:mb-20">
          <h2
            class="text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-bold text-gray-900 mb-4 md:mb-6"
          >
            Unser <span
              class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
              >Webdesign</span
            > Prozess
          </h2>
          <p
            class="text-lg md:text-xl lg:text-2xl text-gray-600 leading-relaxed"
          >
            Strukturiert und transparent
          </p>
        </div>

        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-12">
            <div class="flex items-start space-x-3 md:space-x-4 lg:space-x-6">
              <div
                class="flex-shrink-0 w-10 h-10 md:w-12 md:h-12 lg:w-16 lg:h-16 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center text-white font-bold text-base md:text-lg lg:text-xl"
              >
                1
              </div>
              <div>
                <h3
                  class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 mb-2 md:mb-3"
                >
                  Konzeption
                </h3>
                <p
                  class="text-gray-600 text-sm md:text-base lg:text-lg leading-relaxed"
                >
                  Analyse Ihrer Ziele und Zielgruppe für die optimale
                  Webdesign-Strategie
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-3 md:space-x-4 lg:space-x-6">
              <div
                class="flex-shrink-0 w-10 h-10 md:w-12 md:h-12 lg:w-16 lg:h-16 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center text-white font-bold text-base md:text-lg lg:text-xl"
              >
                2
              </div>
              <div>
                <h3
                  class="text-lg md:text-xl lg:text-2xl font-bold text-gray-900 mb-2 md:mb-3"
                >
                  Design
                </h3>
                <p
                  class="text-gray-600 text-sm md:text-base lg:text-lg leading-relaxed"
                >
                  Wireframes, Mockups und Prototypen für Ihr individuelles
                  Webdesign
                </p>
              </div>
            </div>


---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const standorte = [
  {
    typ: "Hauptstandort",
    name: "Neutraubling",
    strasse: "Oder-Neisse-Str. 1",
    plz: "93073",
    ort: "Neutraubling",
    intro:
      "Hier arbeitet das Team, hier entstehen Websites und Kampagnen – und hier finden die meisten Kundentermine statt. Parkplätze gibt es direkt am Gebäude.",
    zeiten: [
      { tag: "Montag – Freitag", zeit: "08:30 – 18:30 Uhr" },
      { tag: "Samstag", zeit: "09:30 – 14:30 Uhr" },
      { tag: "Sonntag", zeit: "Geschlossen" },
    ],
    anfahrt: [
      {
        titel: "Mit dem Auto",
        text: "Über die B8 oder die A3, Abfahrt Neutraubling. Parkplätze stehen direkt am Gebäude zur Verfügung.",
        icon: "M8 17h8m-9 4h10a2 2 0 002-2v-6.5a2 2 0 00-.2-.87l-2-4A2 2 0 0015 6H9a2 2 0 00-1.8 1.13l-2 4A2 2 0 005 12v7a2 2 0 002 2z",
      },
      {
        titel: "Auch samstags",
        text: "Unter der Woche schlecht abkömmlich? Am Samstagvormittag sind wir ebenfalls für Sie da.",
        icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
      },
    ],
    routenplaner:
      "https://www.google.com/maps/dir/?api=1&destination=Oder-Neisse-Str.+1%2C+93073+Neutraubling",
  },
  {
    typ: "Zweigstelle",
    name: "Regensburg",
    strasse: "Humboldtstr. 48",
    plz: "93053",
    ort: "Regensburg",
    intro:
      "Unsere Adresse im Regensburger Stadtgebiet – für alle, die sich den Weg ins Gewerbegebiet sparen möchten. Termine stimmen wir hier grundsätzlich vorab ab.",
    zeiten: [{ tag: "Öffnungszeiten", zeit: "Nach Vereinbarung" }],
    anfahrt: [
      {
        titel: "Mit dem Auto",
        text: "Stadtnahe Lage heißt auch: begrenzte Parkmöglichkeiten. Planen Sie etwas Zeit ein.",
        icon: "M8 17h8m-9 4h10a2 2 0 002-2v-6.5a2 2 0 00-.2-.87l-2-4A2 2 0 0015 6H9a2 2 0 00-1.8 1.13l-2 4A2 2 0 005 12v7a2 2 0 002 2z",
      },
      {
        titel: "Mit Bus und Bahn",
        text: "Innerhalb des Stadtgebiets gut mit dem ÖPNV erreichbar – ohne Parkplatzsuche.",
        icon: "M8 16.5V17a1 1 0 001 1h6a1 1 0 001-1v-.5M4 11h16M6 20l-1 2m14-2l1 2M7 4h10a2 2 0 012 2v9a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z",
      },
    ],
    routenplaner:
      "https://www.google.com/maps/dir/?api=1&destination=Humboldtstr.+48%2C+93053+Regensburg",
  },
];

const einzugsgebiet = [
  "Regensburg",
  "Neutraubling",
  "Obertraubling",
  "Lappersdorf",
  "Pentling",
  "Barbing",
  "Sinzing",
  "Zeitlarn",
  "Wenzenbach",
  "Nittendorf",
  "Bad Abbach",
];

const faqs = [
  {
    q: "An welchem Standort finden Kundentermine statt?",
    a: "In der Regel in unserem Büro in Neutraubling – dort ist das Team, dort gibt es Parkplätze direkt vor der Tür. Wenn Ihnen die Zweigstelle in Regensburg besser passt, stimmen wir das vorab ab. Viele Gespräche führen wir inzwischen auch per Video, das spart beiden Seiten die Anfahrt.",
  },
  {
    q: "Kommen Sie auch zu mir ins Unternehmen?",
    a: "Ja. Innerhalb von Stadt und Landkreis Regensburg kommen wir gerne zu Ihnen. Gerade beim ersten Kennenlernen ist das oft sinnvoll, weil wir Ihr Unternehmen dann direkt vor Ort sehen und besser einschätzen können, worauf es ankommt.",
  },
  {
    q: "Betreuen Sie auch Kunden außerhalb der Region?",
    a: "Ja. Ein Teil unserer Kunden sitzt außerhalb Bayerns oder im deutschsprachigen Ausland. Die Zusammenarbeit läuft dann über Videocalls, Telefon und E-Mail. Unser Schwerpunkt und unsere Ortskenntnis liegen aber klar in Regensburg und Umgebung.",
  },
  {
    q: "Kann ich einfach vorbeikommen?",
    a: "Termine finden bei uns nur nach Vereinbarung statt. So stellen wir sicher, dass jemand Zeit für Sie hat und Sie nicht vor verschlossener Tür stehen. Ein Anruf oder ein Klick auf den Terminkalender genügt.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title="Standorte & Anfahrt | ixOne Digitalagentur Regensburg"
  description="ixOne finden Sie in Neutraubling und Regensburg. Adressen, Öffnungszeiten und Anfahrt mit Routenplaner für beide Standorte."
  canonical="https://ixone.de/standorte/"
  breadcrumbLabel="Standorte"
  structuredData={[faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-gray-900 text-white overflow-hidden"
      aria-labelledby="standorte-hero-heading"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute -top-24 -left-24 w-96 h-96 bg-brand-orange rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -right-24 w-96 h-96 bg-amber-500 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 relative z-10"
      >
        <div class="max-w-3xl mx-auto text-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
          >
            <span
              class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
              aria-hidden="true"></span>
            Zwei Adressen im Raum Regensburg
          </span>

          <h1
            id="standorte-hero-heading"
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            <span class="block text-white">Wo Sie uns</span>
            <span class="gradient-text-brand">finden</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-200 leading-relaxed">
            Kein anonymes Postfach, keine Briefkastenadresse: ixOne hat ein Büro
            in Neutraubling und eine Zweigstelle in Regensburg. Sie wissen also,
            wo wir sitzen – und können jederzeit vorbeikommen.
          </p>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="adressen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-16 max-w-3xl mx-auto">
          <h2
            id="adressen-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Unsere <span class="gradient-text-brand-inline">Standorte</span>
          </h2>
          <p class="text-xl text-gray-600">
            Adressen, Öffnungszeiten und der schnellste Weg zu uns
          </p>
        </div>

        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">
          {
            standorte.map((ort) => (
              <article class="flex flex-col bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden">
                <div class="p-8 md:p-10 border-b border-gray-100">
                  <span class="inline-block px-3 py-1 mb-5 rounded-full bg-brand-orange/10 text-brand-orange text-sm font-semibold">
                    {ort.typ}
                  </span>

                  <h3 class="text-2xl font-bold text-gray-900 mb-4">
                    ixOne {ort.name}
                  </h3>

                  <address class="not-italic text-lg text-gray-900 font-semibold leading-relaxed mb-5">
                    {ort.strasse}
                    <br />
                    {ort.plz} {ort.ort}
                  </address>

                  <p class="text-gray-600 leading-relaxed">{ort.intro}</p>
                </div>

                <div class="p-8 md:p-10 border-b border-gray-100 bg-gray-50/50">
                  <h4 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-gray-500 mb-5">
                    <svg
                      class="w-4 h-4 text-brand-orange"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    Öffnungszeiten
                  </h4>

                  <dl class="space-y-2.5">
                    {ort.zeiten.map((z) => (
                      <div class="flex justify-between items-baseline gap-4">
                        <dt class="text-gray-600">{z.tag}</dt>
                        <dd class="font-semibold text-gray-900 whitespace-nowrap">
                          {z.zeit}
                        </dd>
                      </div>
                    ))}
                  </dl>

                  <p class="mt-5 pt-4 border-t border-gray-200 text-sm font-semibold text-brand-orange">
                    Termine nur nach Vereinbarung
                  </p>
                </div>

                <div class="p-8 md:p-10 flex-grow">
                  <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-5">
                    Anfahrt
                  </h4>

                  <div class="space-y-5 mb-8">
                    {ort.anfahrt.map((weg) => (
                      <div class="flex items-start gap-4">
                        <span
                          class="flex-shrink-0 w-10 h-10 rounded-xl border border-brand-orange/30 flex items-center justify-center"
                          aria-hidden="true"
                        >
                          <svg
                            class="w-5 h-5 text-brand-orange"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d={weg.icon}
                            />
                          </svg>
                        </span>
                        <div>
                          <p class="font-bold text-gray-900 mb-1">
                            {weg.titel}
                          </p>
                          <p class="text-sm text-gray-600 leading-relaxed">
                            {weg.text}
                          </p>
                        </div>
                      </div>
                    ))}
                  </div>

                  <a
                    href={ort.routenplaner}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center justify-center gap-2 w-full px-6 py-4 bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white font-semibold rounded-xl transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg"
                    aria-label={`Route nach ${ort.strasse}, ${ort.plz} ${ort.ort} planen`}
                  >
                    <svg
                      class="w-5 h-5 flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                      />
                    </svg>
                    Route planen
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="gebiet-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-14 max-w-3xl mx-auto">
            <h2
              id="gebiet-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Zuhause in Regensburg,{" "}
              <span class="gradient-text-brand-inline">erreichbar überall</span>
            </h2>
            <p class="text-xl text-gray-600">
              Wie weit unser Einzugsgebiet reicht – und wo der Schwerpunkt liegt
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
            <div
              class="lg:col-span-3 bg-white rounded-2xl p-8 md:p-10 border-2 border-brand-orange/40 shadow-sm"
            >
              <div
                class="w-12 h-12 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-xl flex items-center justify-center mb-5"
                aria-hidden="true"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
              </div>

              <h3 class="text-xl font-bold text-gray-900 mb-4">
                Persönlich vor Ort im Landkreis
              </h3>
              <p class="text-gray-600 leading-relaxed mb-8">
                In Stadt und Landkreis Regensburg sind wir schnell bei Ihnen –
                oder Sie bei uns. Kurze Wege bedeuten kurze Abstimmungen: ein
                Termin im Büro, ein Besuch in Ihrem Unternehmen, ein schneller
                Anruf zwischendurch.
              </p>

              <p
                class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-4"
              >
                Unter anderem für Unternehmen in
              </p>
              <ul class="flex flex-wrap gap-2" role="list">
                {
                  einzugsgebiet.map((stadt) => (
                    <li class="px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-full text-sm text-gray-700">
                      {stadt}
                    </li>
                  ))
                }
              </ul>
            </div>

            <div
              class="lg:col-span-2 bg-white rounded-2xl p-8 md:p-10 border border-gray-200 shadow-sm"
            >
              <div
                class="w-12 h-12 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center mb-5"
                aria-hidden="true"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18a15 15 0 010-18z"
                  ></path>
                </svg>
              </div>

              <h3 class="text-xl font-bold text-gray-900 mb-4">
                Bundesweit und im deutschsprachigen Raum
              </h3>
              <div class="space-y-4 text-gray-600 leading-relaxed">
                <p>
                  Ein Teil unserer Kunden sitzt außerhalb Bayerns – in
                  Deutschland, Österreich und der Schweiz. Websites, SEO und
                  Kampagnen brauchen keine räumliche Nähe, sondern klare
                  Absprachen.
                </p>
                <p>
                  Die Zusammenarbeit läuft über Videocalls, Telefon und E-Mail.
                  Sie haben denselben festen Ansprechpartner wie Kunden vor Ort
                  – nur eben ohne gemeinsamen Kaffee.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="faq-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <h2
              id="faq-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Häufige Fragen zu Standort und Anfahrt
            </h2>
          </div>

          <div class="space-y-3">
            {
              faqs.map((faq) => (
                <details class="faq-item bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden group">
                  <summary class="flex items-center justify-between p-5 md:p-6 cursor-pointer list-none gap-4 hover:bg-gray-50 transition-colors duration-200">
                    <h3 class="text-lg font-semibold text-gray-900 text-left">
                      {faq.q}
                    </h3>
                    <span
                      class="flex-shrink-0 w-8 h-8 bg-gray-100 group-open:bg-brand-orange rounded-full flex items-center justify-center transition-colors duration-200"
                      aria-hidden="true"
                    >
                      <svg
                        class="w-4 h-4 text-gray-500 group-open:text-white group-open:rotate-180 transition-all duration-200"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19 9l-7 7-7-7"
                        />
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-body px-5 md:px-6 pb-5 md:pb-6 border-t border-gray-100 pt-4">
                    <p class="text-gray-600 leading-relaxed">{faq.a}</p>
                  </div>
                </details>
              ))
            }
          </div>

          <p class="text-center text-gray-600 mt-10">
            Alle Kontaktdaten, eine Karte und weitere Wege zu uns finden Sie auf
            der{" "}
            <a
              href="/kontakt/"
              class="font-semibold text-brand-orange hover:underline"
              >Kontaktseite</a
            >.
          </p>
        </div>
      </div>
    </section>

    <ServiceCrosslinks
      headline={"Was wir für Sie tun können"}
      intro={"Ob vor Ort oder aus der Ferne – das sind unsere Leistungen."}
    />

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="cta-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-3xl mx-auto text-center">
          <h2
            id="cta-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
          >
            Wann passt es Ihnen?
          </h2>
          <p class="text-xl text-gray-600 leading-relaxed mb-10">
            Suchen Sie sich einen freien Termin aus – im Büro in Neutraubling,
            bei Ihnen vor Ort oder per Video. Das Erstgespräch ist kostenlos und
            unverbindlich.
          </p>

          <a
            href={CALENDLY}
            target="_blank"
            rel="noopener"
            data-calendly-popup-url={CALENDLY}
            class="inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white font-bold text-lg transition-all duration-300 transform hover:-translate-y-1 shadow-lg"
            aria-label="Kostenloses Erstgespräch vereinbaren"
          >
            <svg
              class="w-6 h-6 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            Termin vereinbaren
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.querySelectorAll(".faq-item").forEach((details) => {
    const body = details.querySelector(".faq-body") as HTMLElement | null;
    if (!body) return;
    body.style.overflow = "hidden";
    body.style.transition = "max-height 0.35s ease, opacity 0.25s ease";
    if ((details as HTMLDetailsElement).open) {
      body.style.maxHeight = "none";
      body.style.opacity = "1";
    } else {
      body.style.maxHeight = "0px";
      body.style.opacity = "0";
    }
    details.addEventListener("toggle", () => {
      if ((details as HTMLDetailsElement).open) {
        body.style.maxHeight = `${body.scrollHeight}px`;
        body.style.opacity = "1";
        const onEnd = (e: TransitionEvent) => {
          if (e.propertyName === "max-height") {
            body.style.maxHeight = "none";
            body.removeEventListener("transitionend", onEnd);
          }
        };
        body.addEventListener("transitionend", onEnd);
      } else {
        body.style.maxHeight = `${body.scrollHeight}px`;
        requestAnimationFrame(() => {
          body.style.maxHeight = "0px";
          body.style.opacity = "0";
        });
      }
    });
  });
</script>

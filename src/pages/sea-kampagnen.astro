---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "SEA Kampagnen", url: "https://ixone.de/sea-kampagnen" },
]);

// Service Schema für SEA Kampagnen
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "SEA Kampagnen & Google Ads Agentur Regensburg",
  description:
    "Professionelle SEA Kampagnen und Google Ads Betreuung aus Regensburg. Maximaler ROI durch strategische Suchmaschinenwerbung und Performance Marketing.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "SEA Kampagnen",
  offers: {
    "@type": "Offer",
    price: "500",
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: "500",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: true,
    },
  },
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was kosten professionelle SEA Kampagnen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SEA Kampagnen-Betreuung startet bei 500€ monatlich plus Werbebudget. Das Werbebudget bestimmen Sie selbst. Wir optimieren Ihre Google Ads für maximalen ROI und niedrigste Klickpreise.",
      },
    },
    {
      "@type": "Question",
      name: "Wie schnell sehe ich Ergebnisse bei SEA Kampagnen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SEA Kampagnen zeigen sofortige Ergebnisse. Bereits nach 24-48 Stunden sind Ihre Anzeigen live und generieren Traffic. Optimale Performance erreichen wir nach 2-4 Wochen kontinuierlicher Optimierung.",
      },
    },
    {
      "@type": "Question",
      name: "Welche Plattformen nutzen Sie für SEA Kampagnen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Wir betreuen SEA Kampagnen auf Google Ads, Microsoft Ads (Bing), YouTube Ads, Shopping Ads und Display-Netzwerken. Je nach Zielgruppe und Budget wählen wir die optimalen Plattformen.",
      },
    },
  ],
};
---

<Layout
  title="SEA Kampagnen & Google Ads Agentur Regensburg | iXone"
  description="Professionelle SEA Kampagnen und Google Ads Betreuung aus Regensburg. Maximaler ROI durch strategische Suchmaschinenwerbung. Sofortige Sichtbarkeit und messbare Erfolge."
  canonical="https://ixone.de/sea-kampagnen"
  structuredData={[breadcrumbs, serviceSchema, faqSchema]}
>
  <main class="pt-16 md:pt-20 bg-white">
    <!-- Hero Section -->
    <section
      class="relative min-h-[80vh] bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
    >
      <!-- Animated Background -->
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <!-- Grid Pattern -->
      <div class="absolute inset-0 opacity-10">
        <div
          class="h-full w-full"
          style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 50px 50px;"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex items-center min-h-[80vh]"
      >
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Content -->
            <div class="lg:col-span-8 text-center lg:text-left">
              <header>
                <h1
                  class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight"
                >
                  <span class="block text-white">SEA Kampagnen &</span>
                  <span
                    class="block bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
                  >
                    Google Ads Agentur
                  </span>
                  <span
                    class="block text-white/90 text-2xl md:text-3xl font-normal"
                  >
                    Regensburg
                  </span>
                </h1>
              </header>

              <div
                class="bg-white/10 backdrop-blur-md rounded-2xl p-6 md:p-8 border border-white/20 mb-8"
              >
                <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
                  <strong class="text-white"
                    >Professionelle SEA Kampagnen aus Regensburg</strong
                  > –
                  <em class="text-brand-orange">Sofortige Sichtbarkeit</em>,
                  <em class="text-brand-orange">maximaler ROI</em> und
                  <em class="text-brand-orange">messbare Erfolge</em> durch strategische
                  Google Ads Optimierung.
                </p>
              </div>

              <!-- CTA Buttons -->
              <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a
                  href="/kontakt"
                  class="group relative px-8 py-4 bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white font-bold text-lg rounded-2xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 shadow-2xl hover:shadow-brand-orange/25 overflow-hidden text-center"
                  aria-label="SEA Kampagnen-Beratung anfragen"
                >
                  <span
                    class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
                  ></span>
                  <span class="relative z-10">SEA Kampagnen starten</span>
                </a>

                <a
                  href="#sea-services"
                  class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-1 text-center"
                >
                  <span class="flex items-center justify-center gap-2">
                    Services entdecken
                    <svg
                      class="w-5 h-5 group-hover:translate-y-1 transition-transform duration-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                  </span>
                </a>
              </div>

              <!-- Trust Indicators -->
              <div
                class="flex flex-wrap justify-center lg:justify-start gap-6 text-white/70 text-sm"
              >
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium"
                    >Google Ads Partner</span
                  >
                </span>
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium"
                    >Sofortige Ergebnisse</span
                  >
                </span>
                <span class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-green-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-white/90 font-medium"
                    >Transparente Kosten</span
                  >
                </span>
              </div>
            </div>

            <!-- Visual Element -->
            <div class="lg:col-span-4 relative">
              <!-- 3D Cards -->
              <div class="relative">
                <!-- Google Ads Card -->
                <div
                  class="w-72 h-40 bg-gradient-to-br from-blue-500/20 to-cyan-500/20 backdrop-blur-md rounded-3xl border border-white/20 p-6 transform rotate-2 hover:rotate-1 transition-transform duration-500 animate-float relative z-10"
                >
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-12 h-12 bg-gradient-to-br from-blue-400 to-cyan-400 rounded-xl flex items-center justify-center"
                    >
                      <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                      </svg>
                    </div>
                    <h3 class="text-white font-bold">Google Ads</h3>
                  </div>
                  <p class="text-gray-200 text-sm">
                    Sofortige Sichtbarkeit bei Google
                  </p>
                </div>

                <!-- Performance Card -->
                <div
                  class="absolute top-8 right-8 w-72 h-40 bg-gradient-to-br from-brand-orange/20 to-yellow-500/20 backdrop-blur-md rounded-3xl border border-white/20 p-6 transform -rotate-3 hover:rotate-0 transition-transform duration-500 animate-float-delayed"
                >
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-12 h-12 bg-gradient-to-br from-brand-orange to-yellow-400 rounded-xl flex items-center justify-center"
                    >
                      <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                      </svg>
                    </div>
                    <h3 class="text-white font-bold">Performance</h3>
                  </div>
                  <p class="text-gray-200 text-sm">
                    Maximaler ROI durch Optimierung
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="sea-services" class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Unsere <span
              class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent"
              >SEA Services</span
            >
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Professionelle Suchmaschinenwerbung für maximale Sichtbarkeit und
            ROI
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto"
        >
          <!-- Google Ads -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Google Ads Kampagnen
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Professionelle Google Ads Betreuung</strong> für maximale Sichtbarkeit.
              Keyword-Optimierung, Anzeigentexte und Bid-Management für niedrigste
              Klickpreise.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                Search Kampagnen
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                Display Kampagnen
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                Shopping Kampagnen
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 500€/Monat</div>
          </article>

          <!-- Microsoft Ads -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v2M7 7h10"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Microsoft Ads (Bing)
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Bing Ads Optimierung</strong> für zusätzliche Reichweite. Oft
              günstigere Klickpreise und weniger Konkurrenz als Google Ads.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                Bing Search Ads
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                Audience Network
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                Import von Google Ads
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 300€/Monat</div>
          </article>

          <!-- YouTube Ads -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-red-500 to-pink-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">YouTube Ads</h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Video-Werbung auf YouTube</strong> für maximale Reichweite.
              TrueView, Bumper Ads und Discovery Ads für Ihre Zielgruppe.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>
                TrueView In-Stream
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>
                Discovery Ads
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>
                Bumper Ads
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 800€/Monat</div>
          </article>

          <!-- Shopping Ads -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Google Shopping Ads
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>E-Commerce Werbung</strong> mit Produktbildern und Preisen.
              Google Merchant Center Setup und Shopping-Kampagnen-Optimierung.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Merchant Center Setup
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Product Feed Optimierung
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Smart Shopping
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 600€/Monat</div>
          </article>

          <!-- Remarketing -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Remarketing Kampagnen
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Gezielte Ansprache</strong> von Website-Besuchern. Höhere Conversion-Raten
              durch personalisierte Werbeanzeigen.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-purple-500 rounded-full"></span>
                Display Remarketing
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-purple-500 rounded-full"></span>
                Search Remarketing
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-purple-500 rounded-full"></span>
                Dynamic Remarketing
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 400€/Monat</div>
          </article>

          <!-- Performance Tracking -->
          <article
            class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center border border-gray-100"
          >
            <div
              class="w-16 h-16 bg-gradient-to-r from-yellow-500 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Performance Tracking
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6">
              <strong>Transparente Erfolgsmessung</strong> mit detaillierten Reports.
              Google Analytics, Conversion-Tracking und ROI-Analyse.
            </p>
            <ul class="text-gray-600 text-sm space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-yellow-500 rounded-full"></span>
                Conversion Tracking
              </li>

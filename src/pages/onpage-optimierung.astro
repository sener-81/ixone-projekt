---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "OnPage Optimierung", url: "https://ixone.de/onpage-optimierung" },
]);

// Service Schema für OnPage Optimierung
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "OnPage Optimierung & SEO Agentur Regensburg",
  description:
    "Professionelle OnPage Optimierung aus Regensburg. Technical SEO, Content-Optimierung und Website-Performance für bessere Google Rankings und mehr organischen Traffic.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "OnPage Optimierung",
  offers: {
    "@type": "Offer",
    price: "800",
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: "800",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: true,
    },
  },
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was ist OnPage Optimierung?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "OnPage Optimierung umfasst alle SEO-Maßnahmen direkt auf Ihrer Website: Technical SEO, Content-Optimierung, Meta-Tags, interne Verlinkung, Ladezeiten-Optimierung und Structured Data für bessere Google Rankings.",
      },
    },
    {
      "@type": "Question",
      name: "Wie lange dauert OnPage Optimierung?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Eine umfassende OnPage Optimierung dauert 4-8 Wochen je nach Website-Größe. Erste Verbesserungen sind oft nach 2-4 Wochen sichtbar. Kontinuierliche Optimierung ist für langfristige Erfolge wichtig.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet professionelle OnPage Optimierung?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "OnPage Optimierung startet bei 800€ für kleinere Websites. Umfassende Optimierungen für größere Websites kosten 1.500-3.000€. Wir erstellen transparente Angebote basierend auf Ihrem individuellen Bedarf.",
      },
    },
  ],
};

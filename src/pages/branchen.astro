---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "Branchen", url: "https://ixone.de/branchen" },
]);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Digitalagentur für alle Branchen - iXone Regensburg",
  description:
    "Webdesign, SEO und Online-Marketing für kleine und mittlere Unternehmen aus allen Branchen. Maßgeschneiderte digitale Lösungen aus Regensburg.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "Digitale Dienstleistungen",
};
---

<Layout
  title="Branchen | Webdesign & Online-Marketing für alle Branchen | iXone Regensburg"
  description="Digitalagentur für alle Branchen - Webdesign, SEO und Online-Marketing für Handwerk, Medizin, Gastronomie, E-Commerce und mehr. Maßgeschneiderte Lösungen aus Regensburg."
  canonical="https://ixone.de/branchen"
  structuredData={[breadcrumbs, serviceSchema]}
>
  <main class="pt-14 sm:pt-16 md:pt-18 lg:pt-20 xl:pt-22 bg-white">
    <!-- Hero Section -->
    <section
      class="relative min-h-[60vh] bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
    >
      <!-- Animated Background -->
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 lg:py-28 relative z-10 flex items-center min-h-[60vh]"
      >
        <div class="max-w-4xl mx-auto text-center">
          <header>
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight"
            >
              <span class="block text-white">Digitale Lösungen</span>
              <span
                class="block bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
              >
                für alle Branchen
              </span>
              <span
                class="block text-white/90 text-2xl md:text-3xl font-normal mt-2"
              >
                aus Regensburg
              </span>
            </h1>
          </header>

          <div
            class="bg-white/10 backdrop-blur-md rounded-2xl p-6 md:p-8 border border-white/20 mb-8"
          >
            <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
              Als erfahrene <strong class="text-white">Digitalagentur</strong> unterstützen
              wir kleine und mittlere Unternehmen, Dienstleister, Selbstständige
              und Freiberufler mit maßgeschneiderten Lösungen im Bereich <em
                class="text-brand-orange">Webdesign, SEO, Online-Marketing</em
              > und <em class="text-brand-orange">Social Media Marketing</em>.
            </p>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
            <a
              href="/kontakt"
              class="group relative px-8 py-4 bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white font-bold text-lg rounded-2xl transition-all duration-300 transform hover:-translate-y-1 hover:scale-105 shadow-2xl hover:shadow-brand-orange/25 overflow-hidden text-center"
              aria-label="Kostenlose Beratung anfragen"
            >
              <span
                class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
              ></span>
              <span class="relative z-10">Kostenlose Beratung</span>
            </a>

            <a
              href="#branchen-overview"
              class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-1 text-center"

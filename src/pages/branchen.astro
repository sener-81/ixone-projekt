            class="flex flex-wrap justify-center gap-6 text-white/70 text-sm"
          >
            <span class="flex items-center gap-2">
              <svg
                class="w-5 h-5 text-green-400"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"

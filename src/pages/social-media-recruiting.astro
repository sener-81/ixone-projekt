---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  {
    name: "Social Media Recruiting",
    url: "https://ixone.de/social-media-recruiting",
  },
]);

// Service Schema für Social Media Recruiting
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Social Media Recruiting Agentur Regensburg",
  description:
    "Professionelles Social Media Recruiting aus Regensburg. Finden Sie die besten Talente über Facebook, Instagram, LinkedIn und TikTok. Moderne Personalgewinnung für Unternehmen.",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  serviceType: "Social Media Recruiting",
  offers: {
    "@type": "Offer",
    price: "800",
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: "800",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: true,
    },
  },
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was ist Social Media Recruiting?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Social Media Recruiting ist die moderne Personalgewinnung über soziale Netzwerke wie LinkedIn, Facebook, Instagram und TikTok. Wir erreichen passive Kandidaten und sprechen Talente direkt an, die nicht aktiv nach Jobs suchen.",
      },
    },
    {
      "@type": "Question",
      name: "Welche Plattformen nutzen Sie für Recruiting?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Wir nutzen LinkedIn für Fach- und Führungskräfte, Facebook für lokale Positionen, Instagram für kreative Berufe, TikTok für junge Zielgruppen und Xing für den deutschsprachigen Raum.",
      },
    },
    {
      "@type": "Question",
      name: "Wie lange dauert Social Media Recruiting?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Erste Bewerbungen erhalten Sie meist nach 1-2 Wochen. Je nach Position und Anforderungen dauert die Besetzung 4-12 Wochen. Wir arbeiten kontinuierlich an der Optimierung der Kampagnen.",
      },
    },
  ],
};
---

<Layout
  title="Social Media Recruiting Agentur Regensburg | Personalgewinnung | iXone"
  description="Professionelles Social Media Recruiting aus Regensburg. Finden Sie die besten Talente über Facebook, Instagram, LinkedIn und TikTok. Moderne Personalgewinnung für Unternehmen."
  canonical="https://ixone.de/social-media-recruiting"
  structuredData={[breadcrumbs, serviceSchema, faqSchema]}
>
  <div class="pt-16 md:pt-20 bg-white">
    <!-- Hero Section -->
    <section
      class="relative min-h-[80vh] bg-gradient-to-br from-pink-900 via-purple-800 to-indigo-900 text-white overflow-hidden"
    >
      <!-- Animated Background -->
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-pink-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"

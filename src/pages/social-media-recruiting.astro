                E-Recruiting
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-green-600 rounded-full"></span>
                TalentManager
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-green-600 rounded-full"></span>
                Premium Anzeigen
              </li>
            </ul>
            <div class="text-brand-orange font-bold text-lg">ab 700€/Monat</div>

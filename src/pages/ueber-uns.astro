---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";
import { areaServedFull } from "../data/structuredData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const PROVENEXPERT =
  "https://www.provenexpert.com/ixone-onlinemarketing-seo-werbeagentur/";

const GRUENDUNGSJAHR = 2007;
const jahreErfahrung = new Date().getFullYear() - GRUENDUNGSJAHR;

const TEAMGROESSE = "drei";

const meilensteine = [
  {
    zeit: GRUENDUNGSJAHR.toString(),
    titel: "Gründung in Regensburg",
    text: "ixOne startet als inhabergeführte Agentur für Webdesign – aufgebaut auf mehreren Jahren Praxiserfahrung mit eigenen Web- und Community-Projekten.",
  },
  {
    zeit: "2010 – 2016",
    titel: "Ausbau zum Full-Service",
    text: "Zum Webdesign kommen Server- und E-Mail-Hosting, Werbemittel und Gravuren. Der Kundenstamm in Regensburg und dem Landkreis wächst stetig.",
  },
  {
    zeit: "ab 2017",
    titel: "Schwerpunkt Online-Marketing",
    text: "Der Fokus verlagert sich dorthin, wo für Kunden messbar Umsatz entsteht: Suchmaschinenoptimierung, Google Ads und Social Media Marketing.",
  },
  {
    zeit: "seit 2022",
    titel: "KI-Lösungen im Einsatz",
    text: "KI-gestützte Analyse, Chatbots und Assistenzsysteme ergänzen unser Angebot – als Werkzeug für bessere Ergebnisse, nicht als Selbstzweck.",
  },
];

const qualifikationen = [
  {
    titel: "Online-Marketing-Manager (IHK)",
    text: "Zertifizierte Ausbildung in Strategie, Kanalauswahl und Erfolgsmessung durch die Industrie- und Handelskammer.",
  },
  {
    titel: "Bachelor Professional in Marketing",
    text: "Betriebswirtschaftlicher Hintergrund für Marketingstrategie, Markenführung und Budgetplanung.",
  },
  {
    titel: "Head of Marketing",
    text: "Mehrjährige Marketingverantwortung auf Unternehmensseite – wir kennen die Anforderungen unserer Kunden aus eigener Erfahrung.",
  },
];

const werte = [
  {
    titel: "Direkt erreichbar",
    text: "Kein Callcenter, keine Ticketnummer. Sie erreichen uns per Telefon, WhatsApp, E-Mail oder Videocall – und Sie sprechen immer mit derselben Person.",
  },
  {
    titel: "Ehrlich statt gefällig",
    text: "Wenn ein Kanal für Ihr Ziel nichts bringt, sagen wir das. Wir verkaufen lieber weniger und behalten Kunden über Jahre.",
  },
  {
    titel: "Lokal verwurzelt",
    text: "Zwei Standorte in Regensburg und Neutraubling. Persönliche Termine vor Ort sind bei uns die Regel, nicht die Ausnahme.",
  },
  {
    titel: "Transparent im Vorgehen",
    text: "Sie wissen, was gemacht wird, was es kostet und was es gebracht hat. Reporting ohne Zahlenfriedhof.",
  },
];

const standorte = [
  {
    name: "Neutraubling",
    zusatz: "Hauptstandort",
    strasse: "Oder-Neisse-Str. 1",
    ort: "93073 Neutraubling",
    hinweis:
      "Ladenbüro mit direktem Kundenzugang und Parkmöglichkeit vor der Tür.",
  },
  {
    name: "Regensburg",
    zusatz: "Zweigstelle",
    strasse: "Humboldtstr. 48",
    ort: "93053 Regensburg",
    hinweis: "Büro in Regensburg für Termine direkt in der Stadt.",
  },
];

const faqs = [
  {
    q: "Wie groß ist das Team von ixOne?",
    a: `Ein fester Kern von ${TEAMGROESSE} Personen betreut Sie durchgehend. Ergänzt wird er durch ein über Jahre gewachsenes Netzwerk aus Entwicklern, Grafikdesignern und Marketing-Spezialisten. So bleibt Ihr Ansprechpartner derselbe, während für jedes Projekt genau die Fachleute dazukommen, die es braucht.`,
  },
  {
    q: "Seit wann gibt es ixOne?",
    a: `Das Unternehmen wurde ${GRUENDUNGSJAHR} in Regensburg gegründet und ist seitdem durchgehend inhabergeführt. Die Wurzeln reichen weiter zurück: Bereits ab 2001 entstanden erste Websites und Online-Communitys. In ${jahreErfahrung} Jahren sind über 500 Projekte umgesetzt worden – von der Unternehmenswebsite bis zur laufenden Marketingbetreuung.`,
  },
  {
    q: "Kann ich Sie persönlich vor Ort treffen?",
    a: "Ja, und das ist uns wichtig. Wir haben zwei Standorte: das Ladenbüro in Neutraubling mit Parkmöglichkeit direkt vor der Tür und ein Büro in Regensburg. Viele Kunden besuchen wir auch direkt in ihrem Betrieb – gerade bei Handwerkern ist das oft der beste Weg, um Projekte richtig zu verstehen.",
  },
  {
    q: "Arbeiten Sie nur mit großen Unternehmen?",
    a: "Im Gegenteil. Unsere typischen Kunden sind kleine und mittelständische Betriebe aus Regensburg und dem Landkreis – Handwerker, Dienstleister, Praxen, Einzelhändler. Größere Projekte setzen wir über unser Netzwerk um, ohne dass sich für Sie der Ansprechpartner ändert.",
  },
];

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": "https://ixone.de/ueber-uns/#aboutpage",
  name: "Über ixOne Digitalagentur Regensburg",
  description: `Inhabergeführte Digitalagentur aus Regensburg, gegründet ${GRUENDUNGSJAHR}. Über 500 Projekte in Webdesign, SEO, Online-Marketing und Social Media.`,
  url: "https://ixone.de/ueber-uns/",
  mainEntity: { "@id": "https://ixone.de/#organization" },
  about: { "@id": "https://ixone.de/#organization" },
  areaServed: areaServedFull,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title="Über uns | Digitalagentur Regensburg seit 2007 | ixOne"
  description="Inhabergeführte Digitalagentur aus Regensburg seit 2007. Über 500 Projekte, persönliche Betreuung, zwei Standorte in Regensburg und Neutraubling."
  canonical="https://ixone.de/ueber-uns/"
  structuredData={[aboutSchema, faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
      aria-label="Über ixOne Digitalagentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/4 w-72 h-72 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div
          class="h-full w-full"
          style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div class="max-w-7xl mx-auto">
          <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center"
          >
            <div class="lg:col-span-7 text-center lg:text-left">
              <span
                class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
              >
                <span
                  class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
                  aria-hidden="true"></span>
                Inhabergeführt seit {GRUENDUNGSJAHR}
              </span>

              <h1
                class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
              >
                <span class="block text-white">Die Menschen hinter</span>
                <span class="gradient-text-brand">ixOne</span>
                <span
                  class="block text-white/80 text-2xl md:text-3xl font-normal mt-2"
                >
                  Ihre Digitalagentur aus Regensburg
                </span>
              </h1>

              <p
                class="text-lg md:text-xl text-gray-200 leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0"
              >
                Seit <strong class="text-white">{jahreErfahrung} Jahren</strong
                >{" "}
                begleiten wir Betriebe aus Regensburg und dem Landkreis ins Digitale.
                Über 500 Projekte, zwei Standorte – und noch immer derselbe Ansprechpartner
                von der ersten Anfrage bis zur laufenden Betreuung.
              </p>

              <div
                class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8"
              >
                <a
                  href={CALENDLY}
                  target="_blank"
                  rel="noopener"
                  data-calendly-popup-url={CALENDLY}
                  class="cta-button-primary"
                  aria-label="Kostenlosen Kennenlerntermin vereinbaren"
                >
                  <span>Kennenlernen</span>
                </a>
                <a
                  href="/kontakt/"
                  class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 text-center"
                >
                  <span class="flex items-center justify-center gap-2">
                    Kontakt & Anfahrt
                    <svg
                      class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </span>
                </a>
              </div>

              <a
                href={PROVENEXPERT}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-3 px-5 py-3 rounded-full bg-white/10 border border-white/20 backdrop-blur-md text-sm text-white/90 hover:bg-white/20 transition-colors duration-300"
              >
                <span class="flex text-yellow-400" aria-hidden="true">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path
                      d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.363 1.118l1.286 3.958c.3.922-.755 1.688-1.539 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.367 2.446c-.783.57-1.838-.196-1.538-1.118l1.286-3.958a1 1 0 00-.363-1.118L2.063 9.385c-.783-.57-.38-1.81.588-1.81h4.161a1 1 0 00.951-.69l1.286-3.958z"
                    ></path>
                  </svg>
                </span>
                166 Bewertungen auf ProvenExpert
              </a>
            </div>

            <div class="lg:col-span-5">
              <div
                class="relative aspect-[4/5] rounded-3xl overflow-hidden border border-white/20 bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-md flex items-center justify-center"
                data-bild="sener-bayram-inhaber-ixone-regensburg.webp"
                data-alt="Sener Bayram, Inhaber der ixOne Digitalagentur Regensburg"
              >
                <svg
                  class="w-24 h-24 text-white/20"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                  ></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="geschichte-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div
            class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
          >
            <div>
              <h2
                id="geschichte-heading"
                class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
              >
                Gewachsen aus <span class="gradient-text-brand-inline"
                  >eigenen Projekten</span
                >
              </h2>
              <div class="space-y-5 text-gray-600 text-lg leading-relaxed">
                <p>
                  ixOne ist nicht am Reißbrett entstanden, sondern aus der
                  Praxis. Der Gründung {GRUENDUNGSJAHR} gingen mehrere Jahre mit eigenen
                  Web- und Community-Projekten voraus – Foren mit mehreren tausend
                  Mitgliedern, die gepflegt und moderiert werden wollten.
                </p>
                <p>
                  Diese Erfahrung prägt bis heute, wie wir arbeiten: Wir denken
                  nicht in Kampagnen, sondern in Zielgruppen. Was Menschen im
                  Netz anzieht und was sie wieder vertreibt, haben wir nicht aus
                  Fachbüchern, sondern im laufenden Betrieb gelernt.
                </p>
                <p>
                  Aus der Agentur für Websites wurde über die Jahre ein
                  Full-Service-Anbieter, aus dem Full-Service-Anbieter ein
                  fokussiertes Team. Heute konzentrieren wir uns auf das, was
                  für unsere Kunden den Unterschied macht: Websites, die
                  gefunden werden, und Marketing, das messbar Anfragen erzeugt.
                </p>
              </div>
            </div>

            <div
              class="relative aspect-[4/3] rounded-3xl overflow-hidden bg-gradient-to-br from-gray-100 to-gray-50 border border-gray-200 flex items-center justify-center"
              data-bild="ixone-arbeitsplatz-webdesign-regensburg.webp"
              data-alt="Arbeitsplatz der ixOne Digitalagentur in Regensburg mit Webdesign-Projekt"
            >
              <svg
                class="w-24 h-24 text-gray-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="meilensteine-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="meilensteine-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Unser Weg
            </h2>
            <p class="text-xl text-gray-600">
              Vier Stationen von der Gründung bis heute
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
              meilensteine.map((punkt) => (
                <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-md">
                  <span class="text-sm font-semibold text-brand-orange block mb-3">
                    {punkt.zeit}
                  </span>
                  <h3 class="text-xl font-bold text-gray-900 mb-3">
                    {punkt.titel}
                  </h3>
                  <p class="text-gray-600 leading-relaxed">{punkt.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="team-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-4xl mx-auto text-center">
          <h2
            id="team-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
          >
            Kleines Team, großes Netzwerk
          </h2>
          <div class="space-y-5 text-gray-600 text-lg leading-relaxed">
            <p>
              Ein fester Kern von {TEAMGROESSE} Personen betreut Sie durchgehend –
              ergänzt durch ein über Jahre gewachsenes Netzwerk aus Entwicklern, Grafikdesignern
              und Marketing-Spezialisten.
            </p>
            <p>
              So bleibt Ihr Ansprechpartner derselbe, während für jedes Projekt
              genau die Fachleute dazukommen, die es braucht. Sie bekommen die
              Verbindlichkeit eines kleinen Betriebs und die Bandbreite einer
              größeren Agentur.
            </p>
            <p>
              Zur Erfahrung im Haus gehört auch die Perspektive von der anderen
              Seite des Tisches: mehrjährige Marketingverantwortung in
              Unternehmen, zuletzt als Head of Marketing. Wir kennen die Zwänge,
              unter denen Marketingbudgets verteidigt werden müssen – und
              richten unsere Arbeit entsprechend an nachvollziehbaren
              Ergebnissen aus.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="qualifikation-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="qualifikation-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Fachlicher Hintergrund
            </h2>
            <p class="text-xl text-gray-600">
              Praxis und Ausbildung – nicht das eine ohne das andere
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
              qualifikationen.map((q) => (
                <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-md">
                  <h3 class="text-xl font-bold text-gray-900 mb-3">
                    {q.titel}
                  </h3>
                  <p class="text-gray-600 leading-relaxed">{q.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="werte-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="werte-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Wofür wir stehen
            </h2>
            <p class="text-xl text-gray-600">
              Vier Punkte, an denen Sie uns messen können
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
              werte.map((wert) => (
                <div class="bg-gradient-to-br from-gray-50 to-white rounded-2xl p-8 border border-gray-100 shadow-md">
                  <h3 class="text-xl font-bold text-gray-900 mb-3">
                    {wert.titel}
                  </h3>
                  <p class="text-gray-600 leading-relaxed">{wert.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="standorte-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="standorte-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Zwei Standorte, kurze Wege
            </h2>
            <p class="text-xl text-gray-600">
              Besuchen Sie uns – oder wir kommen zu Ihnen in den Betrieb
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
            {
              standorte.map((standort) => (
                <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-md">
                  <div class="flex items-baseline gap-3 mb-4">
                    <h3 class="text-xl font-bold text-gray-900">
                      {standort.name}
                    </h3>
                    <span class="text-xs font-semibold text-brand-orange px-2 py-1 rounded-full bg-brand-orange/10 border border-brand-orange/20">
                      {standort.zusatz}
                    </span>
                  </div>
                  <address class="not-italic text-gray-700 mb-4 leading-relaxed">
                    {standort.strasse}
                    <br />
                    {standort.ort}
                  </address>
                  <p class="text-gray-600 leading-relaxed">
                    {standort.hinweis}
                  </p>
                </div>
              ))
            }
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div
              class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-gray-100 to-white border border-gray-200 flex items-center justify-center"
              data-bild="ixone-buero-neutraubling-aussen.webp"
              data-alt="Außenansicht des ixOne Büros in Neutraubling bei Regensburg"
            >
              <svg
                class="w-16 h-16 text-gray-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </div>

            <div
              class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-gray-100 to-white border border-gray-200 flex items-center justify-center"
              data-bild="ixone-buero-neutraubling-innen.webp"
              data-alt="Büro der ixOne Digitalagentur in Neutraubling von innen"
            >
              <svg
                class="w-16 h-16 text-gray-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1"

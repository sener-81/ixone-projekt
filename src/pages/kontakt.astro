---
// src/pages/kontakt.astro
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../data/structuredData";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ixone.de/" },
  { name: "Kontakt", url: "https://ixone.de/kontakt" },
]);

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Kontakt - iXone Digitalagentur Regensburg",
  description:
    "Kontaktieren Sie die iXone Digitalagentur aus Regensburg für professionelle Webdesign, SEO und Online-Marketing Services.",
  url: "https://ixone.de/kontakt",
  mainEntity: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    telephone: "+49-9401-533-88-73",
    email: "info@ixone.de",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Wie lange dauert die Entwicklung einer neuen Website?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die Entwicklungszeit hängt vom Umfang Ihres Projekts ab. Eine einfache Unternehmenswebsite benötigt in der Regel 2-4 Wochen, während komplexere Projekte mit E-Commerce oder speziellen Funktionen 6-12 Wochen dauern können. Nach dem Erstgespräch erhalten Sie einen detaillierten Zeitplan.",
      },
    },
    {
      "@type": "Question",
      name: "Was kostet eine professionelle Website?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die Kosten variieren je nach Anforderungen. Eine professionelle Unternehmenswebsite startet bei ca. 2.500€. E-Commerce-Lösungen beginnen bei 5.000€. Wir erstellen Ihnen gerne ein individuelles, transparentes Angebot ohne versteckte Kosten.",
      },
    },
    {
      "@type": "Question",
      name: "Wie schnell sehe ich erste SEO-Erfolge?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SEO ist ein langfristiger Prozess. Erste Verbesserungen sind oft nach 2-3 Monaten sichtbar, signifikante Ranking-Verbesserungen zeigen sich typischerweise nach 6-12 Monaten. Wir setzen auf nachhaltige White-Hat-SEO-Strategien für langfristige Erfolge.",
      },
    },
    {
      "@type": "Question",
      name: "Bieten Sie auch Website-Wartung an?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja, wir bieten umfassende Wartungspakete an. Diese umfassen regelmäßige Updates, Sicherheits-Checks, Backups, Performance-Optimierung und technischen Support. So bleibt Ihre Website immer aktuell und sicher.",
      },
    },
    {
      "@type": "Question",
      name: "Arbeiten Sie auch mit Kunden außerhalb von Regensburg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Absolut! Obwohl wir in Regensburg ansässig sind, betreuen wir Kunden in ganz Deutschland und darüber hinaus. Dank moderner Kommunikationsmittel können wir auch remote effektiv zusammenarbeiten. Persönliche Termine sind nach Absprache möglich.",
      },
    },
    {
      "@type": "Question",
      name: "Kann ich meine Website selbst bearbeiten?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja, wir entwickeln Ihre Website mit benutzerfreundlichen Content-Management-Systemen (CMS) wie WordPress. Sie erhalten eine ausführliche Einschulung und können Inhalte selbst pflegen. Bei Fragen stehen wir Ihnen jederzeit zur Verfügung.",
      },
    },
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Digitalagentur Services Regensburg",
  description:
    "Professionelle Digitalagentur-Services aus Regensburg: Webdesign, SEO, Online-Marketing und Social Media Marketing",
  provider: {
    "@type": "LocalBusiness",
    name: "iXone Digitalagentur",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Regensburg",
      addressRegion: "Bayern",
      addressCountry: "DE",
    },
    telephone: "+49-9401-533-88-73",
  },
  areaServed: ["Regensburg", "Bayern", "Deutschland"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Digitalagentur Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Webdesign Regensburg",
          description:
            "Professionelle Website-Entwicklung und responsive Design aus Regensburg",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "SEO Agentur Regensburg",
          description:
            "Suchmaschinenoptimierung für bessere Google Rankings aus Regensburg",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Online-Marketing Regensburg",
          description:
            "Strategisches digitales Marketing für messbare Erfolge aus Regensburg",
        },
      },
    ],
  },
};

// Hero-Konfiguration - Kompakter Kontakt-Header
const heroConfig = {
  variant: "contact" as const,
  backgroundGradient:
    "bg-gradient-to-br from-gray-900 via-gray-800 to-slate-900",
  patternType: "contact" as const,
  useMinHeight: false, // Kontakt-Seite verwendet padding statt min-height
  paddingY: "py-12 md:py-16", // Kompakter - weniger Padding
  ctaButtons: [
    {
      text: "Sofort anrufen: 09401 533 88 73",
      href: "tel:+4994015338873",
      type: "primary" as const,
      ariaLabel: "Digitalagentur Regensburg sofort anrufen",
    },
    {
      text: "E-Mail senden: info@ixone.de",
      href: "mailto:info@ixone.de",
      type: "secondary" as const,
      ariaLabel: "E-Mail an Digitalagentur Regensburg senden",
    },
  ],
  trustIndicators: [
    { text: "Kostenlose Erstberatung", icon: true },
    { text: "Unverbindliches Angebot", icon: true },
    { text: "Persönlicher Ansprechpartner", icon: true },
  ],
};
---

<Layout
  title="Kontakt | iXone Digitalagentur Regensburg - Kostenlose Beratung"
  description="Kontaktieren Sie die iXone Digitalagentur aus Regensburg. Kostenlose Beratung für Webdesign, SEO und Online-Marketing. Persönlicher Ansprechpartner vor Ort."
  structuredData={[breadcrumbs, contactSchema, faqSchema, serviceSchema]}
>
  <main class="pt-16 md:pt-20 bg-white">
    <!-- Einfacher, normaler Hero Section -->
    <section
      class="py-16 md:py-20 bg-gradient-to-br from-gray-900 via-gray-800 to-slate-900 text-white relative overflow-hidden"
    >
      <!-- Background Elements -->
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-brand-orange rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-500 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
      </div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-3xl md:text-5xl font-bold mb-6">
            Kontakt zur <span
              class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent"
              >Digitalagentur Regensburg</span
            >
          </h1>

          <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
            <strong>Bereit für digitalen Erfolg?</strong> Kontaktieren Sie Ihre
            <em>Digitalagentur aus Regensburg</em> für eine kostenlose, unverbindliche
            Beratung. Persönlicher Service und maßgeschneiderte Lösungen für Ihr
            Unternehmen.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
            <a
              href="tel:+4994015338873"
              class="bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white px-8 py-4 rounded-xl font-semibold text-lg transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 hover:scale-105 flex items-center justify-center gap-2"
              aria-label="Digitalagentur Regensburg sofort anrufen"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              Sofort anrufen: 09401 533 88 73
            </a>

            <a
              href="mailto:info@ixone.de"
              class="border-2 border-white text-white hover:bg-white hover:text-gray-900 px-8 py-4 rounded-xl font-semibold text-lg transition-all duration-300 flex items-center justify-center gap-2"
              aria-label="E-Mail an Digitalagentur Regensburg senden"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              E-Mail senden: info@ixone.de
            </a>
          </div>

          <!-- Trust Indicators -->
          <div
            class="flex flex-wrap justify-center gap-6 text-white/70 text-sm"
          >
            <span class="flex items-center gap-2">
              <svg
                class="w-4 h-4 text-green-400"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-white font-medium">Kostenlose Erstberatung</span
              >
            </span>
            <span class="flex items-center gap-2">
              <svg
                class="w-4 h-4 text-green-400"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-white font-medium">Unverbindliches Angebot</span
              >
            </span>
            <span class="flex items-center gap-2">
              <svg
                class="w-4 h-4 text-green-400"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-white font-medium"
                >Persönlicher Ansprechpartner</span
              >
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            <!-- Contact Form -->
            <div>
              <header class="mb-8">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                  <span
                    class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
                    >Digitalagentur-Projekt</span
                  > anfragen
                </h2>
                <p class="text-lg text-gray-600">
                  Erzählen Sie uns von Ihrem Webdesign-, SEO- oder
                  Online-Marketing-Projekt. Wir melden uns innerhalb von 24
                  Stunden bei Ihnen zurück.
                </p>
              </header>

              <form
                class="space-y-6"
                action="/kontakt-verarbeitung"
                method="POST"
                novalidate
              >
                <!-- Name Fields -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label
                      for="vorname"
                      class="block text-sm font-semibold text-gray-700 mb-2"
                    >
                      Vorname <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="vorname"
                      name="vorname"
                      required
                      aria-required="true"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-orange focus:border-transparent transition-all duration-200 hover:border-gray-400"
                      placeholder="Ihr Vorname"
                    />
                  </div>
                  <div>
                    <label
                      for="nachname"
                      class="block text-sm font-semibold text-gray-700 mb-2"
                    >
                      Nachname <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="nachname"
                      name="nachname"
                      required
                      aria-required="true"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-orange focus:border-transparent transition-all duration-200 hover:border-gray-400"
                      placeholder="Ihr Nachname"
                    />
                  </div>
                </div>

                <!-- Email -->
                <div>
                  <label
                    for="email"
                    class="block text-sm font-semibold text-gray-700 mb-2"
                  >
                    E-Mail Adresse <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    aria-required="true"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-orange focus:border-transparent transition-all duration-200 hover:border-gray-400"
                    placeholder="ihre.email@beispiel.de"
                  />
                </div>

                <!-- Company -->
                <div>
                  <label
                    for="unternehmen"
                    class="block text-sm font-semibold text-gray-700 mb-2"
                  >
                    Unternehmen
                  </label>
                  <input
                    type="text"
                    id="unternehmen"
                    name="unternehmen"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-orange focus:border-transparent transition-all duration-200 hover:border-gray-400"
                    placeholder="Ihr Unternehmen (optional)"
                  />
                </div>

                <!-- Website URL -->
                <div>
                  <label
                    for="website"
                    class="block text-sm font-semibold text-gray-700 mb-2"
                  >
                    Aktuelle Website
                  </label>
                  <input
                    type="url"
                    id="website"
                    name="website"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-orange focus:border-transparent transition-all duration-200 hover:border-gray-400"
                    placeholder="https://ihre-website.de (optional)"
                  />
                </div>

                <!-- Interest Selection -->
                <div>
                  <label
                    for="interesse"
                    class="block text-sm font-semibold text-gray-700 mb-2"
                  >
                    Interessiert an <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="interesse"
                    name="interesse"
                    required
                    aria-required="true"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-orange focus:border-transparent transition-all duration-200 hover:border-gray-400"
                  >
                    <option value="">Bitte wählen Sie...</option>
                    <option value="webdesign">Webdesign & Entwicklung</option>
                    <option value="seo">SEO & Suchmaschinenoptimierung</option>
                    <option value="online-marketing"
                      >Online-Marketing & SEA</option
                    >
                    <option value="social-media">Social Media Marketing</option>
                    <option value="relaunch">Website Relaunch</option>
                    <option value="beratung">Digitale Beratung</option>
                    <option value="wartung">Website Wartung & Support</option>
                    <option value="sonstiges">Sonstiges</option>
                  </select>
                </div>

                <!-- Budget Range -->
                <div>
                  <label
                    for="budget"
                    class="block text-sm font-semibold text-gray-700 mb-2"
                  >
                    Geplantes Budget
                  </label>
                  <select
                    id="budget"
                    name="budget"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-orange focus:border-transparent transition-all duration-200 hover:border-gray-400"
                  >
                    <option value="">Budget-Rahmen (optional)</option>
                    <option value="unter-2500">Unter 2.500 €</option>
                    <option value="2500-5000">2.500 € - 5.000 €</option>
                    <option value="5000-10000">5.000 € - 10.000 €</option>
                    <option value="10000-25000">10.000 € - 25.000 €</option>
                    <option value="ueber-25000">Über 25.000 €</option>
                    <option value="monatlich">Monatliches Budget</option>
                  </select>
                </div>

                <!-- Message -->
                <div>
                  <label
                    for="nachricht"
                    class="block text-sm font-semibold text-gray-700 mb-2"
                  >
                    Ihre Nachricht <span class="text-red-500">*</span>
                  </label>
                  <textarea
                    id="nachricht"
                    name="nachricht"
                    rows="6"
                    required
                    aria-required="true"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-orange focus:border-transparent transition-all duration-200 hover:border-gray-400 resize-vertical"
                    placeholder="Beschreiben Sie Ihr Webdesign-, SEO- oder Online-Marketing-Projekt..."
                  ></textarea>
                </div>

                <!-- DSGVO Checkbox -->
                <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
                  <div class="flex items-start space-x-3">
                    <input
                      type="checkbox"
                      id="dsgvo"
                      name="dsgvo"
                      required
                      aria-required="true"
                      class="mt-1 w-4 h-4 text-brand-orange border-gray-300 rounded focus:ring-brand-orange focus:ring-2"
                    />
                    <label
                      for="dsgvo"
                      class="text-sm text-gray-700 leading-relaxed"
                    >
                      <span class="font-semibold"
                        >Datenschutz-Einverständnis <span class="text-red-500"
                          >*</span
                        ></span
                      ><br />
                      Ich habe die <a
                        href="/datenschutz"
                        class="text-brand-orange hover:text-brand-orange-dark underline"
                        target="_blank"
                        rel="noopener">Datenschutzerklärung</a
                      > gelesen und stimme der Verarbeitung meiner personenbezogenen
                      Daten zur Bearbeitung meiner Anfrage zu. Die Daten werden ausschließlich
                      für die Kontaktaufnahme verwendet und nicht an Dritte weitergegeben.
                      Sie können Ihre Einwilligung jederzeit widerrufen.
                    </label>
                  </div>
                </div>

                <!-- Submit Button -->
                <button
                  type="submit"
                  class="w-full bg-gradient-to-r from-brand-orange to-yellow-500 hover:from-yellow-500 hover:to-brand-orange text-white px-8 py-4 rounded-lg font-bold text-lg transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-brand-orange focus:ring-offset-2"
                  aria-label="Kontaktformular für Digitalagentur-Services absenden"
                >
                  <span class="flex items-center justify-center gap-2">
                    Kostenlose Digitalagentur-Beratung anfordern
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                    </svg>
                  </span>
                </button>

                <p class="text-xs text-gray-500 text-center">
                  <span class="text-red-500">*</span> Pflichtfelder | Antwort innerhalb
                  von 24 Stunden | Kostenlos & unverbindlich
                </p>
              </form>
            </div>

            <!-- Contact Info & Map -->
            <div class="space-y-8">
              <!-- Contact Information -->
              <div>
                <h3 class="text-2xl font-bold text-gray-900 mb-6">
                  Direkter <span
                    class="bg-gradient-to-r from-brand-orange via-yellow-400 to-brand-orange bg-clip-text text-transparent animate-gradient-x"
                    >Kontakt</span
                  >
                </h3>

                <div class="space-y-6">
                  <!-- Phone -->
                  <div
                    class="flex items-start space-x-4 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors duration-200"
                  >
                    <div
                      class="w-12 h-12 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center flex-shrink-0"
                    >
                      <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                        ></path>
                      </svg>
                    </div>
                    <div>
                      <h4 class="text-lg font-semibold text-gray-900 mb-1">
                        Telefon
                      </h4>
                      <p class="text-gray-600 mb-2">
                        <a
                          href="tel:+4994015338873"
                          class="hover:text-brand-orange font-semibold text-lg"
                        >
                          +49 (0) 9401 – 533 88 73
                        </a>
                      </p>
                      <p class="text-sm text-gray-500">
                        Mo-Fr: 9:00 - 18:00 Uhr
                      </p>
                    </div>
                  </div>

                  <!-- Email -->
                  <div
                    class="flex items-start space-x-4 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors duration-200"
                  >
                    <div
                      class="w-12 h-12 bg-gradient-to-r from-brand-orange to-yellow-500 rounded-full flex items-center justify-center flex-shrink-0"
                    >
                      <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path>
                      </svg>

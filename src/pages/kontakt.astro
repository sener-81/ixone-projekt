---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://ixone.de/kontakt/#contactpage",
  name: "Kontakt – ixOne Digitalagentur Regensburg",
  description:
    "Kontaktieren Sie ixOne, Ihre Digitalagentur aus Regensburg und Neutraubling. Termin online oder vor Ort vereinbaren oder per E-Mail schreiben – im Umkreis Regensburg kommen wir auch zu Ihnen.",
  url: "https://ixone.de/kontakt/",
  isPartOf: { "@id": "https://ixone.de/#website" },
  about: { "@id": "https://ixone.de/#organization" },
  mainEntity: [
    { "@id": "https://ixone.de/#localbusiness" },
    { "@id": "https://ixone.de/#localbusiness-regensburg" },
  ],
};

const TELEFON_ANZEIGE = "+49 9401 5338873";
const TELEFON_LINK = "+4994015338873";
const EMAIL = "info@ixone.de";
const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const ablauf = [
  {
    schritt: "01",
    titel: "Sie melden sich",
    text: "Per Terminkalender, E-Mail oder Telefon – ganz wie es Ihnen passt. Schildern Sie kurz, worum es geht.",
  },
  {
    schritt: "02",
    titel: "Wir sprechen",
    text: "Etwa 30 Minuten über Ihr Ziel, Ihre Zielgruppe und Ihren Rahmen. Per Video, bei uns im Büro oder bei Ihnen vor Ort.",
  },
  {
    schritt: "03",
    titel: "Sie erhalten ein Angebot",
    text: "Schriftlich, mit klarem Leistungsumfang und Zeitplan. Bis dahin entstehen Ihnen keine Kosten.",
  },
];

const faqs = [
  {
    q: "Was kostet ein Erstgespräch?",
    a: "Nichts. Das Erstgespräch ist kostenlos und unverbindlich. Wir schauen gemeinsam, ob und wie wir Ihnen helfen können – und sagen offen, wenn wir nicht der richtige Partner sind.",
  },
  {
    q: "Wie schnell bekomme ich eine Antwort?",
    a: "Auf E-Mails antworten wir in der Regel innerhalb eines Werktags. Wenn Sie einen Termin über den Kalender buchen, erhalten Sie die Bestätigung sofort.",
  },
  {
    q: "Muss ich zu Ihnen kommen?",
    a: "Nein. Viele Gespräche führen wir per Videocall. Innerhalb von Stadt und Landkreis Regensburg kommen wir auch gerne zu Ihnen ins Unternehmen. Und wenn Sie uns besuchen möchten, sind Sie in Neutraubling herzlich willkommen.",
  },
  {
    q: "Was sollte ich zum ersten Gespräch mitbringen?",
    a: "Nichts Bestimmtes. Hilfreich ist, wenn Sie grob wissen, was Sie erreichen möchten und welchen Rahmen Sie sich vorstellen. Alles Weitere klären wir gemeinsam im Gespräch.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title="Kontakt | ixOne Digitalagentur Regensburg & Neutraubling"
  description="Kontakt zu ixOne, Ihrer Digitalagentur aus Regensburg und Neutraubling. Termin online oder vor Ort vereinbaren – oder schreiben Sie uns eine E-Mail."
  canonical="https://ixone.de/kontakt/"
  structuredData={[contactSchema, faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-gray-900 text-white"
      aria-label="Kontakt ixOne Digitalagentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute -top-24 -left-24 w-96 h-96 bg-brand-orange rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -right-24 w-96 h-96 bg-amber-500 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div class="max-w-3xl mx-auto text-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
          >
            <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"
            ></span>
            Digitalagentur aus Regensburg · seit 2007
          </span>

          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            Lassen Sie uns <span class="gradient-text-brand">sprechen</span>
          </h1>

          <p
            class="text-lg md:text-xl text-gray-200 leading-relaxed max-w-2xl mx-auto"
          >
            Ob neue Website, mehr Sichtbarkeit bei Google oder eine ganze
            Marketing-Strategie – wir freuen uns auf Ihr Projekt. Buchen Sie
            einen Termin oder schreiben Sie uns.{" "}
            <strong class="text-white"
              >Im Umkreis Regensburg kommen wir auch zu Ihnen vor Ort.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="kontaktwege-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-16 max-w-3xl mx-auto">
          <h2
            id="kontaktwege-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Drei Wege zu <span class="gradient-text-brand-inline">uns</span>
          </h2>
          <p class="text-xl text-gray-600">
            Suchen Sie sich aus, was Ihnen am liebsten ist
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <a
            href={CALENDLY}
            target="_blank"
            rel="noopener"
            data-calendly-popup-url={CALENDLY}
            class="group relative flex flex-col bg-white rounded-2xl p-8 border-2 border-brand-orange shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1"
            aria-label="Termin vereinbaren – online oder vor Ort"
          >
            <span
              class="absolute -top-3 left-8 px-3 py-1 rounded-full bg-brand-orange text-white text-xs font-bold tracking-wide uppercase"
              >Am schnellsten</span
            >
            <div
              class="w-12 h-12 mb-5 rounded-xl bg-gradient-to-r from-brand-orange to-yellow-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Termin vereinbaren
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6 flex-grow">
              Freien Slot im Kalender wählen, Bestätigung kommt sofort. Das
              Gespräch findet per Video, bei uns im Büro oder bei Ihnen statt.
            </p>
            <span class="text-brand-orange font-semibold group-hover:underline"
              >Freien Termin wählen →</span
            >
          </a>

          <a
            href={`mailto:${EMAIL}`}
            class="group flex flex-col bg-gray-50 rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="w-12 h-12 mb-5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              E-Mail schreiben
            </h3>
            <p class="text-gray-600 leading-relaxed mb-6 flex-grow">
              Schildern Sie uns Ihr Anliegen in Ruhe. Wir lesen jede Nachricht
              persönlich und antworten in der Regel innerhalb eines Werktags.
            </p>
            <span class="text-brand-orange font-semibold group-hover:underline"
              >{EMAIL}</span
            >
          </a>

          <a
            href={`tel:${TELEFON_LINK}`}
            class="group flex flex-col bg-gray-50 rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="w-12 h-12 mb-5 rounded-xl bg-gradient-to-r from-green-500 to-teal-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Anrufen</h3>
            <p class="text-gray-600 leading-relaxed mb-6 flex-grow">
              Kurze Frage, kurze Antwort. Wir sind viel bei Kunden unterwegs –
              hinterlassen Sie sonst kurz eine Nachricht, wir melden uns zurück.
            </p>
            <span class="text-brand-orange font-semibold group-hover:underline"
              >{TELEFON_ANZEIGE}</span
            >
          </a>
        </div>

        <div
          class="max-w-4xl mx-auto mt-12 bg-gradient-to-br from-orange-50 to-amber-50 rounded-2xl p-8 border border-orange-100 text-center"
        >
          <p class="text-gray-700 text-lg leading-relaxed">
            <strong class="text-gray-900">Persönlich vor Ort:</strong> In Regensburg,
            Neutraubling und im gesamten Umkreis besuchen wir Sie gerne in Ihrem Unternehmen
            – oder Sie kommen zu uns ins Büro. Adressen und Anfahrt finden Sie bei
            den{" "}
            <a
              href="/standorte/"
              class="font-semibold text-brand-orange hover:underline"
              >Standorten</a
            >.
          </p>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="ablauf-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-14 max-w-3xl mx-auto">
          <h2
            id="ablauf-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Was nach Ihrer Nachricht passiert
          </h2>
          <p class="text-xl text-gray-600">
            Kein Verkaufsdruck, keine Vertragsfalle – so läuft es bei uns ab
          </p>
        </div>

        <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            ablauf.map((stufe) => (
              <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm">
                <span class="block text-4xl font-bold text-brand-orange/30 mb-4">
                  {stufe.schritt}
                </span>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  {stufe.titel}
                </h3>
                <p class="text-gray-600 leading-relaxed">{stufe.text}</p>
              </div>
            ))
          }
        </div>

        <p class="text-center text-gray-600 mt-12 max-w-2xl mx-auto">
          Eine erste Kostenorientierung finden Sie bei den{" "}
          <a
            href="/preise/"
            class="font-semibold text-brand-orange hover:underline">Preisen</a
          >, viele weitere Antworten in den{" "}
          <a
            href="/faq/"
            class="font-semibold text-brand-orange hover:underline"
            >häufigen Fragen</a
          >.
        </p>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="faq-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <h2
              id="faq-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Fragen vor der Kontaktaufnahme
            </h2>
          </div>

          <div class="space-y-3">
            {
              faqs.map((faq) => (
                <details class="faq-item bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden group">
                  <summary class="flex items-center justify-between p-5 md:p-6 cursor-pointer list-none gap-4 hover:bg-gray-50 transition-colors duration-200">
                    <h3 class="text-lg font-semibold text-gray-900 text-left">
                      {faq.q}
                    </h3>
                    <span
                      class="flex-shrink-0 w-8 h-8 bg-gray-100 group-open:bg-brand-orange rounded-full flex items-center justify-center transition-colors duration-200"
                      aria-hidden="true"
                    >
                      <svg
                        class="w-4 h-4 text-gray-500 group-open:text-white group-open:rotate-180 transition-all duration-200"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19 9l-7 7-7-7"
                        />
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-body px-5 md:px-6 pb-5 md:pb-6 border-t border-gray-100 pt-4">
                    <p class="text-gray-600 leading-relaxed">{faq.a}</p>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <ServiceCrosslinks
      headline="Womit können wir helfen?"
      intro="Unsere Leistungen für Unternehmen in Regensburg und dem Landkreis."
      outro='Nicht sicher, was zu Ihnen passt? Schreiben Sie uns an <a href="mailto:info@ixone.de" class="font-semibold text-brand-orange hover:underline">info@ixone.de</a> – wir beraten Sie ehrlich.'
    />

    <section
      class="py-20 md:py-28 lg:py-32 bg-gradient-to-r from-slate-900 via-slate-800 to-gray-900 relative overflow-hidden"
      aria-labelledby="cta-heading"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute -top-24 -left-24 w-96 h-96 bg-brand-orange rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -right-24 w-96 h-96 bg-amber-500 rounded-full blur-3xl"
        >
        </div>
      </div>
      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 relative z-10"
      >
        <div class="max-w-4xl mx-auto text-center text-white">
          <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold mb-6">
            Bereit für Ihr nächstes Projekt?
          </h2>
          <p class="text-xl mb-10 opacity-90 leading-relaxed">
            Buchen Sie Ihren kostenlosen Beratungstermin – online per
            Videokonferenz oder persönlich bei Ihnen vor Ort. Wir freuen uns auf
            Sie.
          </p>
          <div class="flex justify-center">
            <a
              href={CALENDLY}
              target="_blank"
              rel="noopener"
              data-calendly-popup-url={CALENDLY}
              class="inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl bg-white text-gray-900 font-bold text-lg hover:bg-gray-100 transition-all duration-300 transform hover:-translate-y-1 shadow-lg"
              aria-label="Termin vereinbaren – online oder vor Ort"
            >
              <svg
                class="w-6 h-6 text-brand-orange flex-shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
              Termin vereinbaren
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.querySelectorAll(".faq-item").forEach((details) => {
    const body = details.querySelector(".faq-body") as HTMLElement | null;
    if (!body) return;
    body.style.overflow = "hidden";
    body.style.transition = "max-height 0.35s ease, opacity 0.25s ease";
    if ((details as HTMLDetailsElement).open) {
      body.style.maxHeight = "none";
      body.style.opacity = "1";
    } else {
      body.style.maxHeight = "0px";
      body.style.opacity = "0";
    }
    details.addEventListener("toggle", () => {
      if ((details as HTMLDetailsElement).open) {
        body.style.maxHeight = `${body.scrollHeight}px`;
        body.style.opacity = "1";
        const onEnd = (e: TransitionEvent) => {
          if (e.propertyName === "max-height") {
            body.style.maxHeight = "none";
            body.removeEventListener("transitionend", onEnd);
          }
        };
        body.addEventListener("transitionend", onEnd);
      } else {
        body.style.maxHeight = `${body.scrollHeight}px`;
        requestAnimationFrame(() => {
          body.style.maxHeight = "0px";
          body.style.opacity = "0";
        });
      }
    });
  });
</script>

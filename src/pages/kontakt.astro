---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://ixone.de/kontakt#contactpage",
  name: "Kontakt – iXone Digitalagentur Regensburg",
  description:
    "Kontaktieren Sie iXone, Ihre Digitalagentur aus Regensburg und Neutraubling. Termin online oder vor Ort vereinbaren oder per E-Mail schreiben – im Umkreis Regensburg kommen wir auch zu Ihnen.",
  url: "https://ixone.de/kontakt",
  isPartOf: { "@id": "https://ixone.de/#website" },
  about: { "@id": "https://ixone.de/#organization" },
  mainEntity: [
    { "@id": "https://ixone.de/#localbusiness" },
    { "@id": "https://ixone.de/#localbusiness-regensburg" },
  ],
};

const standorte = [
  {
    name: "Neutraubling",
    badge: "Hauptstandort",
    strasse: "Oder-Neisse-Str. 1",
    plz: "93073 Neutraubling",
    mapsEmbed:
      "https://www.google.com/maps?q=Oder-Neisse-Str.+1,+93073+Neutraubling&output=embed",
    mapsLink:
      "https://www.google.com/maps/dir/?api=1&destination=Oder-Neisse-Str.+1,+93073+Neutraubling",
    accent: "from-brand-orange to-yellow-500",
  },
  {
    name: "Regensburg",
    badge: "Zweigstelle",
    strasse: "Humboldtstr. 48",
    plz: "93053 Regensburg",
    mapsEmbed:
      "https://www.google.com/maps?q=Humboldtstr.+48,+93053+Regensburg&output=embed",
    mapsLink:
      "https://www.google.com/maps/dir/?api=1&destination=Humboldtstr.+48,+93053+Regensburg",
    accent: "from-cyan-500 to-blue-600",
  },
];

const TELEFON_ANZEIGE = "+49 9401 5338873";
const TELEFON_LINK = "+4994015338873";
const EMAIL = "info@ixone.de";
const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";
---

<Layout
  title="Kontakt | iXone Digitalagentur Regensburg & Neutraubling"
  description="Kontakt zu iXone, Ihrer Digitalagentur aus Regensburg und Neutraubling. Termin online oder vor Ort vereinbaren – oder schreiben Sie uns eine E-Mail."
  canonical="https://ixone.de/kontakt"
  structuredData={[contactSchema]}
>
  <div class="bg-white">
    <section
      class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-gray-900 text-white"
      aria-label="Kontakt iXone Digitalagentur Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute -top-24 -left-24 w-96 h-96 bg-brand-orange rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -right-24 w-96 h-96 bg-amber-500 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div class="max-w-3xl mx-auto text-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
          >
            <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"
            ></span>
            Digitalagentur aus Regensburg · seit 2007
          </span>

          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
          >
            Lassen Sie uns <span class="gradient-text-brand">sprechen</span>
          </h1>

          <p
            class="text-lg md:text-xl text-gray-200 leading-relaxed max-w-2xl mx-auto"
          >
            Ob neue Website, mehr Sichtbarkeit bei Google oder eine ganze
            Marketing-Strategie – wir freuen uns auf Ihr Projekt. Buchen Sie
            einen Termin oder schreiben Sie uns.
            <strong class="text-white"
              >Im Umkreis Regensburg kommen wir auch zu Ihnen vor Ort.</strong
            >
          </p>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="kontaktwege-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <h2 id="kontaktwege-heading" class="sr-only">
          Kontaktmöglichkeiten zu iXone
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <a
            href={CALENDLY}
            target="_blank"
            rel="noopener"
            data-calendly-popup-url={CALENDLY}
            class="group relative bg-white rounded-2xl p-8 border-2 border-brand-orange shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 text-center"
            aria-label="Termin vereinbaren – online oder vor Ort"
          >
            <span
              class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-brand-orange text-white text-xs font-bold tracking-wide uppercase"
              >Am schnellsten</span
            >
            <div
              class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-gradient-to-r from-brand-orange to-yellow-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-7 h-7 text-white"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">
              Termin vereinbaren
            </h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              Online per Videokonferenz oder persönlich bei Ihnen vor Ort. Sie
              wählen einen freien Slot, wir bestätigen sofort – kostenlos und
              unverbindlich.
            </p>
            <span class="text-brand-orange font-semibold group-hover:underline"
              >Freien Termin wählen →</span
            >
          </a>

          <a
            href={`mailto:${EMAIL}`}
            class="group bg-white rounded-2xl p-8 border border-gray-200 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 text-center"
          >
            <div
              class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-7 h-7 text-white"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">
              E-Mail schreiben
            </h3>
            <p class="text-gray-600 mb-4 leading-relaxed">
              Schildern Sie uns Ihr Anliegen in Ruhe. Wir lesen jede Nachricht
              persönlich und antworten in der Regel innerhalb eines Werktags.
            </p>
            <span class="text-brand-orange font-semibold group-hover:underline"
              >{EMAIL}</span
            >
          </a>
        </div>

        <div
          class="max-w-4xl mx-auto mt-10 bg-gradient-to-br from-orange-50 to-amber-50 rounded-2xl p-8 border border-orange-100 text-center"
        >
          <p class="text-gray-700 text-lg leading-relaxed">
            <strong class="text-gray-900">Persönlich vor Ort:</strong> In Regensburg,
            Neutraubling und im gesamten Umkreis besuchen wir Sie gerne in Ihrem Unternehmen
            – oder Sie kommen zu uns ins Büro. So wie es für Sie am besten passt.
          </p>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="standorte-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
          <h2
            id="standorte-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          >
            Unsere <span class="gradient-text-brand">Standorte</span>
          </h2>
          <p class="text-xl text-gray-600">
            Zwei Standorte in der Region Regensburg – immer in Ihrer Nähe.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
          {
            standorte.map((ort) => (
              <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-md">
                <div
                  class="map-placeholder relative aspect-[16/9] bg-gradient-to-br from-slate-100 to-gray-200 cursor-pointer group"
                  data-map-src={ort.mapsEmbed}
                  data-map-title={`Karte ${ort.name}`}
                  role="button"
                  tabindex="0"
                  aria-label={`Google-Karte für ${ort.name} laden`}
                >
                  <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6">
                    <div
                      class={`w-14 h-14 mb-4 rounded-2xl bg-gradient-to-r ${ort.accent} flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300`}
                    >
                      <svg
                        class="w-7 h-7 text-white"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                    </div>
                    <p class="text-gray-700 font-semibold text-sm">
                      Karte für {ort.name} anzeigen
                    </p>
                    <p class="text-gray-500 text-xs mt-1 max-w-xs">
                      Beim Klick wird Google Maps geladen. Dabei werden Daten an
                      Google übertragen.
                    </p>
                  </div>
                </div>

                <div class="p-6 md:p-8">
                  <div class="flex items-center gap-3 mb-4">
                    <h3 class="text-xl font-bold text-gray-900">
                      iXone {ort.name}
                    </h3>
                    <span
                      class={`text-xs font-semibold px-2.5 py-1 rounded-full text-white bg-gradient-to-r ${ort.accent}`}
                    >
                      {ort.badge}
                    </span>
                  </div>
                  <address class="not-italic text-gray-600 leading-relaxed mb-6">
                    <span class="font-semibold text-gray-900">Anschrift:</span>
                    <br />
                    {ort.strasse}
                    <br />
                    {ort.plz}
                  </address>
                  <a
                    href={ort.mapsLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border-2 border-gray-200 text-gray-700 font-semibold text-sm hover:border-brand-orange hover:text-brand-orange transition-colors duration-200"
                  >
                    <svg
                      class="w-4 h-4 flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                      />
                    </svg>
                    Route planen
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 bg-white"
      aria-labelledby="kontaktdaten-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div
          class="max-w-4xl mx-auto rounded-2xl border border-gray-200 bg-gray-50 p-8 md:p-10"
        >
          <h2
            id="kontaktdaten-heading"
            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center"
          >
            So kontaktieren Sie uns
          </h2>
          <p class="text-lg text-gray-600 text-center max-w-2xl mx-auto mb-10">
            Alle Wege zu uns auf einen Blick.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center md:text-left">
              <div
                class="w-11 h-11 rounded-xl bg-white border border-gray-200 flex items-center justify-center mb-4 mx-auto md:mx-0"
              >
                <svg
                  class="w-5 h-5 text-gray-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Telefon</h3>
              <a
                href={`tel:${TELEFON_LINK}`}
                class="text-gray-700 font-semibold hover:text-brand-orange transition-colors duration-200"
                >{TELEFON_ANZEIGE}</a
              >
              <p class="text-gray-600 text-sm leading-relaxed mt-2">
                Wir sind viel bei Kunden unterwegs. Hinterlassen Sie eine
                Nachricht mit Ihrem Anliegen – wir melden uns zurück.
              </p>
            </div>

            <div class="text-center md:text-left">
              <div
                class="w-11 h-11 rounded-xl bg-white border border-gray-200 flex items-center justify-center mb-4 mx-auto md:mx-0"
              >
                <svg
                  class="w-5 h-5 text-gray-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">E-Mail</h3>
              <a
                href={`mailto:${EMAIL}`}
                class="text-gray-700 font-semibold hover:text-brand-orange transition-colors duration-200"
                >{EMAIL}</a
              >
              <p class="text-gray-600 text-sm leading-relaxed mt-2">
                Wir lesen jede Nachricht persönlich und antworten in der Regel
                innerhalb eines Werktags.
              </p>
            </div>

            <div class="text-center md:text-left">
              <div
                class="w-11 h-11 rounded-xl bg-white border border-gray-200 flex items-center justify-center mb-4 mx-auto md:mx-0"
              >
                <svg
                  class="w-5 h-5 text-gray-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Anschrift</h3>
              <address class="not-italic text-gray-700 font-semibold">
                Oder-Neisse-Str. 1
                <br />
                93073 Neutraubling
              </address>
              <p class="text-gray-600 text-sm leading-relaxed mt-2">
                Hauptstandort. Besuche bitte vorher kurz abstimmen, damit wir
                Zeit für Sie haben.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ServiceCrosslinks
      headline="Womit können wir helfen?"
      intro="Unsere Leistungen für Unternehmen in Regensburg und dem Landkreis."
    />

    <section
      class="py-20 md:py-28 lg:py-32 bg-gradient-to-r from-slate-900 via-slate-800 to-gray-900 relative overflow-hidden"
      aria-labelledby="cta-heading"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute -top-24 -left-24 w-96 h-96 bg-brand-orange rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-24 -right-24 w-96 h-96 bg-amber-500 rounded-full blur-3xl"
        >
        </div>
      </div>
      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 relative z-10"
      >
        <div class="max-w-4xl mx-auto text-center text-white">
          <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold mb-6">
            Bereit für Ihr nächstes Projekt?
          </h2>
          <p class="text-xl mb-10 opacity-90 leading-relaxed">
            Buchen Sie Ihren kostenlosen Beratungstermin – online per
            Videokonferenz oder persönlich bei Ihnen vor Ort. Wir freuen uns auf
            Sie.
          </p>
          <div class="flex justify-center">
            <a
              href={CALENDLY}
              target="_blank"
              rel="noopener"
              data-calendly-popup-url={CALENDLY}
              class="inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl bg-white text-gray-900 font-bold text-lg hover:bg-gray-100 transition-all duration-300 transform hover:-translate-y-1 shadow-lg"
              aria-label="Termin vereinbaren – online oder vor Ort"
            >
              <svg
                class="w-6 h-6 text-brand-orange flex-shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
              Termin vereinbaren
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".map-placeholder").forEach((ph) => {
    const load = () => {
      const src = ph.dataset.mapSrc;
      const title = ph.dataset.mapTitle ?? "Google Maps";
      if (!src) return;
      const iframe = document.createElement("iframe");
      iframe.src = src;
      iframe.title = title;
      iframe.loading = "lazy";
      iframe.referrerPolicy = "no-referrer-when-downgrade";
      iframe.style.border = "0";
      iframe.style.width = "100%";
      iframe.style.height = "100%";
      iframe.allowFullscreen = true;
      ph.replaceChildren(iframe);
      ph.style.cursor = "default";
      ph.removeAttribute("role");
      ph.removeAttribute("tabindex");
    };
    ph.addEventListener("click", load);
    ph.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        load();
      }
    });
  });
</script>

---
import Layout from "../layouts/Layout.astro";
import ServiceCrosslinks from "../components/ServiceCrosslinks.astro";
import { areaServedFull } from "../data/structuredData";

const CALENDLY =
  "https://calendly.com/senerbayram-info/30min?primary_color=ec6a1b";

const leistungen = [
  {
    titel: "CMS- & Plugin-Updates",
    text: "WordPress-Core, Themes und Plugins bleiben aktuell. Jedes Update läuft zuerst auf einem separaten Testsystem – erst wenn dort alles funktioniert, geht es live.",
  },
  {
    titel: "Automatische Backups",
    text: "Tägliche Sicherung von Dateien und Datenbank, extern gespeichert. Im Ernstfall ist Ihre Website in kurzer Zeit wiederhergestellt.",
  },
  {
    titel: "Sicherheits-Monitoring",
    text: "Laufende Prüfung auf Sicherheitslücken, verdächtige Zugriffe und Schadcode. Kritische Lücken werden sofort geschlossen, nicht beim nächsten Turnus.",
  },
  {
    titel: "Verfügbarkeits-Überwachung",
    text: "Ihre Website wird rund um die Uhr geprüft. Fällt sie aus, erfahren wir es zuerst – nicht Ihr Kunde beim Anruf.",
  },
  {
    titel: "Inhaltspflege",
    text: "Texte ändern, Bilder tauschen, Öffnungszeiten anpassen, Referenzen ergänzen. Sie schicken eine kurze Nachricht, wir setzen um.",
  },
  {
    titel: "Performance & Core Web Vitals",
    text: "Regelmäßige Prüfung von Ladezeiten und Google-Kennzahlen. Bilder, Caching und Datenbank werden bei Bedarf nachoptimiert.",
  },
];

const pakete = [
  {
    name: "Updateservice Standard",
    preis: "49,95 €",
    zeitraum: "netto pro Monat",
    fuer: "Für Unternehmenswebsites – der Standard für die meisten Kunden",
    hervorgehoben: true,
    inhalte: [
      "Regelmäßige CMS- & Plugin-Updates",
      "Alle Updates vorab auf Testsystem geprüft",
      "Automatische Backups",
      "Sicherheits-Monitoring",
      "Verfügbarkeitsüberwachung",
      "Kleinere Inhaltsänderungen",
      "Persönlicher Ansprechpartner",
    ],
  },
  {
    name: "Individuell",
    preis: "Auf Anfrage",
    zeitraum: "",
    fuer: "Für Onlineshops und umfangreiche Websites",
    hervorgehoben: false,
    inhalte: [
      "Alle Leistungen des Standardpakets",
      "Kürzere Update-Intervalle",
      "Produkt- & Sortimentspflege",
      "Erweitertes Sicherheits-Monitoring",
      "Umfangreichere Inhaltspflege",
      "Individuelle Reaktionszeiten",
      "Angebot nach Größe und Komplexität",
    ],
  },
];

const gruende = [
  {
    zahl: "Wöchentlich",
    titel: "erscheinen neue Sicherheitsupdates",
    text: "Für gängige CMS und Plugins kommen laufend Aktualisierungen. Wer sie nicht einspielt, lässt bekannte Lücken offen – das ist das häufigste Einfallstor.",
  },
  {
    zahl: "24/7",
    titel: "läuft Ihre Website",
    text: "Ein Ausfall am Wochenende kostet Anfragen. Wer erst montags merkt, dass die Seite offline war, hat drei Tage Geschäft verloren.",
  },
  {
    zahl: "Minuten",
    titel: "statt Tage bis zur Wiederherstellung",
    text: "Mit funktionierendem Backup ist ein sauberer Stand schnell zurückgespielt. Ohne Sicherung wird aus dem Zwischenfall ein Neuaufbau.",
  },
];

const ablauf = [
  {
    schritt: "01",
    titel: "Bestandsaufnahme",
    text: "Wir prüfen Ihre Website: Systemstand, Plugins, Sicherheitslage, Ladezeiten. Sie bekommen eine ehrliche Einschätzung, was nötig ist.",
  },
  {
    schritt: "02",
    titel: "Grundreinigung",
    text: "Vor der laufenden Pflege bringen wir alles auf Stand: Updates nachholen, überflüssige Plugins entfernen, Backup-Routine einrichten.",
  },
  {
    schritt: "03",
    titel: "Laufende Betreuung",
    text: "Ab dann läuft die Pflege im vereinbarten Turnus. Sie erhalten regelmäßig einen kurzen Bericht, was gemacht wurde.",
  },
  {
    schritt: "04",
    titel: "Weiterentwicklung",
    text: "Ihre Website steht nicht still. Wir schlagen Verbesserungen vor, wenn wir Potenzial sehen – Sie entscheiden, was umgesetzt wird.",
  },
];

const faqs = [
  {
    q: "Was versteht man unter Websitepflege und Wartung?",
    a: "Websitepflege umfasst die technische Wartung und die inhaltliche Aktualisierung Ihrer Website. Technisch bedeutet das CMS- und Plugin-Updates, Backups, Sicherheitsprüfungen und Performance-Kontrolle. Inhaltlich geht es um Textänderungen, neue Bilder, aktuelle Angebote und Referenzen. Beides zusammen sorgt für einen sicheren, schnellen und aktuellen Auftritt.",
  },
  {
    q: "Wie oft sollte meine Website aktualisiert werden?",
    a: "Technische Updates empfehlen wir mindestens monatlich, bei Onlineshops alle ein bis zwei Wochen. Sicherheitsupdates spielen wir sofort ein, sobald sie erscheinen. Inhaltlich reicht bei einer Unternehmenswebsite eine monatliche Aktualisierung, bei Shops mit häufigem Sortimentswechsel sind wöchentliche bis tägliche Anpassungen sinnvoll.",
  },
  {
    q: "Kann ich die Pflege meiner Website nicht selbst übernehmen?",
    a: "Grundsätzlich ja. In der Praxis scheitert es meist an der Zeit und daran, dass Updates ungetestet eingespielt werden. Wenn ein Plugin-Update das Layout zerschießt oder das Kontaktformular lahmlegt, merkt man das oft erst, wenn Kunden sich beschweren. Wir testen jedes Update vorher auf einem separaten System.",
  },
  {
    q: "Was passiert, wenn meine Website ausfällt?",
    a: "Unsere Überwachung meldet einen Ausfall automatisch. Je nach Paket reagieren wir innerhalb von vier Stunden bis zwei Werktagen. Durch die täglichen Backups lässt sich ein funktionierender Stand in der Regel innerhalb weniger Minuten wiederherstellen.",
  },
  {
    q: "Verbessert Websitepflege mein Google-Ranking?",
    a: "Indirekt ja, und zwar über drei Wege. Aktuelle Inhalte signalisieren Google eine gepflegte Seite. Schnelle Ladezeiten und stabile Core Web Vitals sind bestätigte Rankingfaktoren. Und eine Website, die nicht erreichbar oder als unsicher markiert ist, verliert Positionen. Für gezielten Rankingaufbau ist zusätzlich Suchmaschinenoptimierung nötig.",
  },
  {
    q: "Was kostet die Websitepflege?",
    a: "Der Updateservice für Unternehmenswebsites kostet 49,95 € netto im Monat zzgl. der gesetzlichen Umsatzsteuer. Darin enthalten sind regelmäßige CMS- und Plugin-Updates, Backups, Sicherheits-Monitoring und kleinere Inhaltsänderungen. Hosting, Domain und Lizenzen Dritter sind nicht enthalten. Unsere Angebote richten sich ausschließlich an Unternehmer im Sinne des § 14 BGB. Bei Onlineshops und umfangreichen Websites erstellen wir ein individuelles Angebot.",
  },
  {
    q: "Gibt es eine Mindestlaufzeit?",
    a: "Nein. Unsere Wartungsverträge sind monatlich kündbar. Wir halten Kunden durch Leistung, nicht durch Vertragsbindung. Auf Wunsch übergeben wir bei Vertragsende alle Zugangsdaten und Backups vollständig.",
  },
  {
    q: "Betreuen Sie auch Websites, die nicht von ixOne stammen?",
    a: "Ja, das ist sogar häufig der Fall. Vor Beginn machen wir eine Bestandsaufnahme und bringen die Website auf einen sauberen Stand. Erst danach startet die laufende Betreuung – so übernehmen wir keine Altlasten in den Vertrag.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://ixone.de/websitepflege-regensburg/#service",
  name: "Websitepflege & Wartung Regensburg",
  description:
    "Professionelle Websitepflege aus Regensburg: CMS- und Plugin-Updates, tägliche Backups, Sicherheits-Monitoring, Inhaltspflege und Performance-Optimierung. Monatlich kündbar.",
  provider: { "@id": "https://ixone.de/#organization" },
  telephone: "+4994015338873",
  areaServed: areaServedFull,
  serviceType: [
    "Websitepflege",
    "Website-Wartung",
    "Updateservice",
    "Backupservice",
    "WordPress-Wartung",
    "Sicherheits-Monitoring",
  ],
  offers: {
    "@type": "Offer",
    availability: "https://schema.org/InStock",
    url: "https://ixone.de/websitepflege-regensburg/",
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: 49.95,
      priceCurrency: "EUR",
      valueAddedTaxIncluded: false,
      unitCode: "MON",
    },
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title="Websitepflege Regensburg | Wartung & Updateservice | ixOne"
  description="Websitepflege aus Regensburg ab 49,95 € netto im Monat: CMS-Updates, Backups, Sicherheits-Monitoring und Inhaltspflege. Monatlich kündbar."
  canonical="https://ixone.de/websitepflege-regensburg/"
  structuredData={[serviceSchema, faqSchema]}
>
  <div class="bg-white">
    <section
      class="relative bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-900 text-white overflow-hidden"
      aria-label="Websitepflege Regensburg Hero"
    >
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div
          class="absolute top-0 left-0 w-96 h-96 bg-blue-400 rounded-full filter blur-3xl animate-blob"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-96 h-96 bg-purple-400 rounded-full filter blur-3xl animate-blob animation-delay-2000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/4 w-72 h-72 bg-indigo-400 rounded-full filter blur-3xl animate-blob animation-delay-4000"
        >
        </div>
      </div>

      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div
          class="h-full w-full"
          style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 py-24 md:py-32 lg:py-36 relative z-10"
      >
        <div class="max-w-7xl mx-auto">
          <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center"
          >
            <div class="lg:col-span-7 text-center lg:text-left">
              <span
                class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full bg-white/10 border border-white/20 text-sm font-medium backdrop-blur-md"
              >
                <span
                  class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
                  aria-hidden="true"></span>
                Ab 49,95 € netto im Monat – monatlich kündbar
              </span>

              <h1
                class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6"
              >
                <span class="block text-white">Websitepflege</span>
                <span class="gradient-text-brand">Regensburg</span>
                <span
                  class="block text-white/80 text-2xl md:text-3xl font-normal mt-2"
                >
                  Wartung, Updates & Sicherheit
                </span>
              </h1>

              <p
                class="text-lg md:text-xl text-gray-200 leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0"
              >
                Eine Website ist kein Möbelstück, das man einmal aufstellt.
                <strong class="text-white">Updates, Backups und Sicherheit</strong
                > laufen bei uns im Hintergrund – damit Sie sich um Ihr Geschäft
                kümmern können. Für Betriebe in Regensburg und dem Landkreis.
              </p>

              <div
                class="flex flex-wrap justify-center lg:justify-start gap-2 md:gap-3 mb-8"
              >
                {
                  [
                    "Getestete Updates",
                    "Tägliche Backups",
                    "Persönlicher Ansprechpartner",
                    "Monatlich kündbar",
                  ].map((label) => (
                    <span class="flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-3 py-1.5 text-xs font-medium text-white/90">
                      <svg
                        class="w-3.5 h-3.5 text-green-400 flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      {label}
                    </span>
                  ))
                }
              </div>

              <div
                class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
              >
                <a
                  href={CALENDLY}
                  target="_blank"
                  rel="noopener"
                  data-calendly-popup-url={CALENDLY}
                  class="cta-button-primary"
                  aria-label="Kostenlosen Beratungstermin zur Websitepflege vereinbaren"
                >
                  <span>Termin vereinbaren</span>
                </a>
                <a
                  href="#pakete"
                  class="group px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl font-semibold text-lg text-white hover:bg-white/20 transition-all duration-300 text-center"
                >
                  <span class="flex items-center justify-center gap-2">
                    Pakete ansehen
                    <svg
                      class="w-5 h-5 group-hover:translate-y-1 transition-transform duration-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                  </span>
                </a>
              </div>
            </div>

            <div class="lg:col-span-5">
              <div
                class="relative aspect-[4/3] rounded-3xl overflow-hidden border border-white/20 bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-md flex items-center justify-center"
              >
                <svg
                  class="w-24 h-24 text-white/20"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"
                  ></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="warum-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="warum-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Warum <span class="gradient-text-brand-inline">Wartung</span> keine
              Kür ist
            </h2>
            <p class="text-xl text-gray-600">
              Eine ungepflegte Website ist kein ruhender Besitz, sondern ein
              wachsendes Risiko
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
              gruende.map((grund) => (
                <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
                  <p class="text-4xl font-bold text-brand-orange mb-3">
                    {grund.zahl}
                  </p>
                  <h3 class="text-xl font-bold text-gray-900 mb-3">
                    {grund.titel}
                  </h3>
                  <p class="text-gray-600 leading-relaxed">{grund.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="leistungen-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="leistungen-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Was in der Websitepflege enthalten ist
            </h2>
            <p class="text-xl text-gray-600">
              Technische Wartung und inhaltliche Betreuung aus einer Hand
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
              leistungen.map((leistung) => (
                <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-md hover:shadow-xl transition-shadow duration-300">
                  <h3 class="text-xl font-bold text-gray-900 mb-3">
                    {leistung.titel}
                  </h3>
                  <p class="text-gray-600 leading-relaxed">{leistung.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 md:py-28 lg:py-32 bg-white"
      aria-labelledby="testsystem-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div
            class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
          >
            <div
              class="relative aspect-[4/3] rounded-3xl overflow-hidden bg-gradient-to-br from-gray-100 to-gray-50 border border-gray-200 flex items-center justify-center"
            >
              <svg
                class="w-24 h-24 text-gray-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>

            <div>
              <h2
                id="testsystem-heading"
                class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
              >
                Kein Update geht ungetestet <span
                  class="gradient-text-brand-inline">live</span
                >
              </h2>
              <div class="space-y-5 text-gray-600 text-lg leading-relaxed">
                <p>
                  Der häufigste Grund für kaputte Websites ist kein Hackerangriff
                  – es ist ein Plugin-Update, das mit dem Theme kollidiert.
                  Plötzlich funktioniert das Kontaktformular nicht mehr, oder die
                  Startseite zeigt eine Fehlermeldung.
                </p>
                <p>
                  Deshalb spielen wir Updates <strong class="text-gray-900"
                    >zuerst auf einem separaten Testsystem</strong
                  > ein. Erst wenn dort alles läuft – Formulare, Menüs,
                  Darstellung auf dem Handy – übertragen wir es auf Ihre Website.
                </p>
                <p>
                  Falls ein Update trotzdem Probleme macht, ist das Backup vom
                  Vortag da. Statt tagelanger Ausfälle sind es Minuten.
                </p>
                <p>
                  Sie brauchen zuerst eine neue Website? Dann starten wir mit
                  <a
                    href="/webdesign-regensburg/"
                    class="font-medium text-brand-orange hover:underline"
                    >Webdesign aus Regensburg</a
                  > – die Pflege schließt sich nahtlos an.
                </p>
              </div>

              <a
                href={CALENDLY}
                target="_blank"
                rel="noopener"
                data-calendly-popup-url={CALENDLY}
                class="inline-flex items-center justify-center mt-8 px-8 py-4 bg-brand-orange text-white font-semibold rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl"
                aria-label="Beratungstermin zur Websitepflege vereinbaren"
              >
                Termin vereinbaren
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="pakete"
      class="py-20 md:py-28 lg:py-32 bg-gray-50"
      aria-labelledby="pakete-heading"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 xl:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16 md:mb-20 max-w-3xl mx-auto">
            <h2
              id="pakete-heading"
              class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
            >
              Wartungspakete im Überblick
            </h2>
            <p class="text-xl text-gray-600">
              Fester Standardpreis, monatlich kündbar – bei größeren Projekten
              individuell kalkuliert
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            {
              pakete.map((paket) => (
                <div
                  class={`rounded-2xl p-8 border shadow-md flex flex-col h-full ${paket.hervorgehoben ? "bg-white border-brand-orange shadow-xl md:-mt-4 md:pb-12" : "bg-white border-gray-100"}`}
                >
                  {paket.hervorgehoben && (
                    <span class="inline-flex items-center self-start px-3 py-1 mb-4 rounded-full bg-brand-orange text-white text-xs font-semibold">
                      Standardpaket
                    </span>
                  )}

                  <h3 class="text-xl font-bold text-gray-900 mb-2">
                    {paket.name}
                  </h3>
                  <p class="text-gray-500 text-sm mb-6">{paket.fuer}</p>

                  <div class="mb-6 pb-6 border-b border-gray-100">
                    <span class="text-3xl font-bold text-gray-900">
                      {paket.preis}
                    </span>
                    {paket.zeitraum && (
                      <span class="text-gray-500 text-sm ml-1">
                        {paket.zeitraum}
                      </span>
                    )}
                  </div>

                  <ul class="space-y-3 mb-8 flex-grow">
                    {paket.inhalte.map((inhalt) => (
                      <li class="flex items-start gap-3 text-gray-700">
                        <svg
                          class="w-5 h-5 flex-shrink-0 mt-0.5 text-brand-orange"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        <span>{inhalt}</span>
                      </li>
                    ))}
                  </ul>

